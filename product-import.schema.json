{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIRELLAART Product Import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "style",
    "category",
    "subtitle",
    "description",
    "prices"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "productKey": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "style": {
      "enum": [
        "luxury-classic",
        "modern"
      ]
    },
    "category": {
      "enum": [
        "sofa-sets",
        "living-rooms",
        "dining-rooms",
        "bedrooms",
        "tv-units"
      ]
    },
    "subtitle": {
      "type": "string",
      "minLength": 8
    },
    "description": {
      "type": "string",
      "minLength": 80
    },
    "imageSource": {
      "type": "string",
      "description": "public altındaki kaynak görsel klasörü veya dosyası"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string"
      }
    },
    "imagePrefix": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "imageAlts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "prices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "price"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2
          },
          "price": {
            "type": "string",
            "pattern": "^\\$(?:\\d+|\\d{1,3}(?:,\\d{3})+)(?:\\.\\d{2})?$"
          },
          "featured": {
            "type": "boolean"
          }
        }
      }
    },
    "commitMessage": {
      "type": "string",
      "minLength": 8
    }
  },
  "oneOf": [
    {
      "required": [
        "imageSource"
      ],
      "not": {
        "required": [
          "images"
        ]
      }
    },
    {
      "required": [
        "images"
      ],
      "not": {
        "required": [
          "imageSource"
        ]
      }
    }
  ]
}
