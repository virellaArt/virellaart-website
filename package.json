{
  "name": "virellaart",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "admin": "node scripts/virella-admin.mjs",
    "product:init": "node scripts/add-product.mjs --init product-import.json",
    "product:add": "node scripts/add-product.mjs",
    "dev": "astro dev",
    "build": "npm run convert-images && npm run build:astro && npm run check:links",
    "preview": "astro preview",
    "astro": "astro",
    "convert-images": "node scripts/convert-images.js",
    "check:links": "node scripts/check-internal-links.mjs",
    "build:astro": "astro build",
    "verify:site": "npm run build"
  },
  "dependencies": {
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "sharp": "^0.35.3"
  }
}
