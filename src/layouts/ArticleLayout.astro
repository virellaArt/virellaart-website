---
import BaseLayout from "./BaseLayout.astro";
import {
  getLanguageFromPath,
  localizedPath,
} from "../i18n/config";

interface FAQItem {
  question: string;
  answer: string;
}

interface AlternateURL {
  language: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  publishedTime: string;
  modifiedTime?: string;
  section?: string;
  keywords?: string[];
  authorName?: string;
  robots?: string;
  readingTimeMinutes?: number;
  wordCount?: number;
  faqItems?: FAQItem[];
  alternateURLs?: AlternateURL[];
  xDefaultURL?: string;
  includeCanonical?: boolean;
  switcherFallbackToLocalizedPath?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  publishedTime,
  modifiedTime = publishedTime,
  section,
  keywords = [],
  authorName = "VIRELLAART",
  robots = "index, follow",
  readingTimeMinutes,
  wordCount,
  faqItems = [],
  alternateURLs,
  xDefaultURL,
  includeCanonical = true,
  switcherFallbackToLocalizedPath = false,
} = Astro.props;

const siteURL = "https://www.virellaart.com";
const language = getLanguageFromPath(Astro.url.pathname);
const articleUICopy = {
  en: {
    home: "Home",
    journal: "Journal",
    eyebrow: "From guide to quotation",
    heading: "Ready to compare a real VIRELLAART model?",
    text:
      "Continue with the relevant collection, then send the model together with your delivery country and city. Your WhatsApp request will include this guide so the conversation keeps its context.",
    primary: "Get Price & Delivery Quote",
    collections: "Explore VIRELLAART Collections",
    bedrooms: "Explore Bedroom Collections",
    dining: "Explore Dining Room Collections",
    tvUnits: "Explore TV Unit Collections",
    livingRooms: "Explore Living Room Collections",
    quoteGreeting:
      "Hello VIRELLAART, I am reading this buying guide:",
    quoteRequest:
      "I would like a product and delivery quotation.",
    quoteModel: "Preferred model or collection:",
    quoteCountry: "Delivery country:",
    quoteCity: "Delivery city:",
  },
  de: {
    home: "Startseite",
    journal: "Journal",
    eyebrow: "Vom Ratgeber zum Angebot",
    heading: "Möchten Sie ein konkretes VIRELLAART Modell vergleichen?",
    text:
      "Öffnen Sie die passende Kollektion und senden Sie anschließend das Modell zusammen mit Lieferland und Lieferort. Der Ratgeber wird in Ihrer WhatsApp-Anfrage vermerkt, damit der Zusammenhang erhalten bleibt.",
    primary: "Preis- und Lieferangebot anfragen",
    collections: "VIRELLAART Kollektionen entdecken",
    bedrooms: "Schlafzimmer entdecken",
    dining: "Esszimmer entdecken",
    tvUnits: "TV-Möbel entdecken",
    livingRooms: "Wohnzimmer entdecken",
    quoteGreeting:
      "Hallo VIRELLAART, ich lese gerade diesen Kaufratgeber:",
    quoteRequest:
      "Ich möchte ein Produkt- und Lieferangebot erhalten.",
    quoteModel: "Bevorzugtes Modell oder Kollektion:",
    quoteCountry: "Lieferland:",
    quoteCity: "Lieferort:",
  },
  fr: {
    home: "Accueil",
    journal: "Journal",
    eyebrow: "Du guide au devis",
    heading: "Prêt à comparer un modèle VIRELLAART précis ?",
    text:
      "Consultez la collection adaptée, puis transmettez le modèle avec le pays et la ville de livraison. Votre demande WhatsApp mentionnera ce guide afin de conserver le contexte.",
    primary: "Demander un devis produit et livraison",
    collections: "Découvrir les collections VIRELLAART",
    bedrooms: "Découvrir les chambres",
    dining: "Découvrir les salles à manger",
    tvUnits: "Découvrir les meubles TV",
    livingRooms: "Découvrir les salons",
    quoteGreeting:
      "Bonjour VIRELLAART, je consulte ce guide d’achat :",
    quoteRequest:
      "Je souhaite recevoir un devis produit et livraison.",
    quoteModel: "Modèle ou collection souhaité :",
    quoteCountry: "Pays de livraison :",
    quoteCity: "Ville de livraison :",
  },
} as const;
const articleUI =
  language === "de" || language === "fr"
    ? articleUICopy[language]
    : articleUICopy.en;

const canonicalPath =
  Astro.url.pathname.replace(/\/?$/, "/");

const canonicalURL = new URL(
  canonicalPath,
  siteURL,
).href;

const imageURL = new URL(
  image,
  siteURL,
).href;

const articleIntent = `${title} ${section ?? ""} ${keywords.join(" ")}`.toLowerCase();

const commercialPath = articleIntent.includes("bedroom") || articleIntent.includes(" bed ")
  ? "/bedrooms"
  : articleIntent.includes("dining")
    ? "/dining-rooms"
    : articleIntent.includes("tv unit") || articleIntent.includes("media furniture")
      ? "/tv-units"
      : articleIntent.includes("sofa") || articleIntent.includes("living room")
        ? "/living-rooms"
        : "/collections/luxury-classic";

const commercialLabel = commercialPath === "/bedrooms"
  ? articleUI.bedrooms
  : commercialPath === "/dining-rooms"
    ? articleUI.dining
    : commercialPath === "/tv-units"
      ? articleUI.tvUnits
      : commercialPath === "/living-rooms"
        ? articleUI.livingRooms
        : articleUI.collections;

const commercialURL = localizedPath(commercialPath, language);
const quotationMessage = [
  articleUI.quoteGreeting,
  title,
  `Page: ${canonicalURL}`,
  articleUI.quoteRequest,
  articleUI.quoteModel,
  articleUI.quoteCountry,
  articleUI.quoteCity,
].join("\n");
const quotationURL = `https://wa.me/905539478608?text=${encodeURIComponent(quotationMessage)}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonicalURL}#article`,
  headline: title,
  description,
  image: [imageURL],
  datePublished: publishedTime,
  dateModified: modifiedTime,
  inLanguage: language,
  isAccessibleForFree: true,
  articleSection: section,
  keywords:
    keywords.length > 0
      ? keywords.join(", ")
      : undefined,
  wordCount,
  timeRequired:
    readingTimeMinutes
      ? `PT${readingTimeMinutes}M`
      : undefined,
  author: {
    "@type": "Organization",
    "@id": `${siteURL}/#organization`,
    name: authorName,
    url: siteURL,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${siteURL}/#organization`,
    name: "VIRELLAART",
    logo: {
      "@type": "ImageObject",
      url: `${siteURL}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${siteURL}/#website`,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: articleUI.home,
      item: new URL(
        localizedPath("/", language),
        siteURL,
      ).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: articleUI.journal,
      item: new URL(
        localizedPath("/blog", language),
        siteURL,
      ).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: canonicalURL,
    },
  ],
};

const faqSchema =
  faqItems.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": `${canonicalURL}#faq`,
        mainEntity: faqItems.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : undefined;
---

<BaseLayout
  {title}
  {description}
  {image}
  {imageAlt}
  {robots}
  {alternateURLs}
  {switcherFallbackToLocalizedPath}
  {xDefaultURL}
  {includeCanonical}
  pageType="article"
>
  <Fragment slot="head">
    <meta
      name="author"
      content={authorName}
    />

    <meta
      property="article:published_time"
      content={publishedTime}
    />

    <meta
      property="article:modified_time"
      content={modifiedTime}
    />

    {
      section && (
        <meta
          property="article:section"
          content={section}
        />
      )
    }

    {
      keywords.map((keyword) => (
        <meta
          property="article:tag"
          content={keyword}
        />
      ))
    }

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />

    {
      faqSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqSchema)}
        />
      )
    }
  </Fragment>

  <slot />

  <section class="article-commercial-bridge" aria-labelledby="article-commercial-title">
    <div class="article-commercial-shell">
      <p class="article-commercial-eyebrow">{articleUI.eyebrow}</p>
      <h2 id="article-commercial-title">{articleUI.heading}</h2>
      <p>{articleUI.text}</p>
      <div class="article-commercial-actions">
        <a class="article-commercial-secondary" href={commercialURL}>
          {commercialLabel}
        </a>
        <a
          class="article-commercial-primary"
          href={quotationURL}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="article-commercial-bridge"
        >
          {articleUI.primary}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-commercial-bridge {
    padding: 56px 20px 72px;
    background: #17120f;
    color: #f7f3ed;
  }

  .article-commercial-shell {
    width: min(900px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  .article-commercial-eyebrow {
    margin: 0 0 10px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .article-commercial-shell h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.08;
  }

  .article-commercial-shell > p:not(.article-commercial-eyebrow) {
    max-width: 700px;
    margin: 18px auto 0;
    line-height: 1.7;
    opacity: 0.84;
  }

  .article-commercial-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .article-commercial-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 20px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .article-commercial-primary {
    background: #f7f3ed;
    color: #17120f;
  }

  .article-commercial-secondary {
    border: 1px solid rgba(247, 243, 237, 0.35);
    color: #f7f3ed;
  }

  @media (max-width: 640px) {
    .article-commercial-bridge {
      padding: 44px 16px 56px;
    }

    .article-commercial-actions {
      flex-direction: column;
    }

    .article-commercial-actions a {
      width: 100%;
    }
  }
</style>
