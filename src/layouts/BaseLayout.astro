---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "VIRELLAART creates luxury furniture collections crafted in Istanbul. Premium living rooms, dining rooms, bedrooms and TV units with worldwide delivery.",
  image = "/living-room.webp"
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com"
).href;

const imageURL = new URL(
  image,
  "https://www.virellaart.com"
).href;
---

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8" />

<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>


<title>
{title} | VIRELLAART Luxury Furniture
</title>


<meta 
name="description"
content={description}
/>


<meta 
name="robots"
content="index, follow"
/>


<meta 
name="theme-color"
content="#17130f"
/>


<link 
rel="canonical"
href={canonicalURL}
/>


<link 
rel="icon"
href="/favicon.ico"
/>


<!-- Open Graph -->

<meta
property="og:title"
content={`${title} | VIRELLAART Luxury Furniture`}
/>


<meta
property="og:description"
content={description}
/>


<meta
property="og:type"
content="website"
/>


<meta
property="og:site_name"
content="VIRELLAART"
/>


<meta
property="og:url"
content={canonicalURL}
/>


<meta
property="og:image"
content={imageURL}
/>


<!-- Twitter -->

<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={`${title} | VIRELLAART Luxury Furniture`}
/>


<meta
name="twitter:description"
content={description}
/>


<meta
name="twitter:image"
content={imageURL}
/>


</head>


<body>

<Navbar />

<main>
<slot />
</main>

</body>

</html>