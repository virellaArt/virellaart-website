---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "VIRELLAART creates luxury furniture collections crafted in Istanbul. Premium living rooms, dining rooms, bedrooms and TV units with worldwide delivery.",
  image = "/living-room.webp"
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com"
).href;

const imageURL = new URL(
  image,
  "https://www.virellaart.com"
).href;


const organizationSchema = {

  "@context": "https://schema.org",

  "@type": "Organization",

  "name": "VIRELLAART",

  "url": "https://www.virellaart.com",

  "logo": "https://www.virellaart.com/favicon.ico",

  "description":
  "VIRELLAART creates luxury furniture collections crafted in Istanbul with premium craftsmanship and worldwide delivery.",

  "sameAs": [
    "https://www.instagram.com/virellaart/",
    "https://www.facebook.com/VirellaArtFurniture",
    "https://tr.pinterest.com/virellaart/"
  ]

};


const websiteSchema = {

  "@context": "https://schema.org",

  "@type": "WebSite",

  "name": "VIRELLAART",

  "url": "https://www.virellaart.com"

};
---


<!DOCTYPE html>
<html lang="en">

<head>

<!-- Google Analytics -->


<script async src="https://www.googletagmanager.com/gtag/js?id=G-Y8YY6ZBD87"></script>

<script is:inline>

window.dataLayer = window.dataLayer || [];

window.gtag = function(){
window.dataLayer.push(arguments);
};

window.gtag('js', new Date());

window.gtag('config','G-Y8YY6ZBD87');

</script>



  <meta
name="google-site-verification"
content="laUkxyOiCW63Ekw2HmTw3lFbpAiSx5qwdotv3ERgK-A"
/>

<meta charset="UTF-8" />

<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>


<title>
{title} | VIRELLAART Luxury Furniture
</title>


<meta 
name="description"
content={description}
/>


<meta 
name="robots"
content="index, follow"
/>


<meta 
name="theme-color"
content="#17130f"
/>


<link 
rel="canonical"
href={canonicalURL}
/>


<link 
rel="icon"
href="/favicon.ico"
/>


<!-- Open Graph -->

<meta
property="og:title"
content={`${title} | VIRELLAART Luxury Furniture`}
/>


<meta
property="og:description"
content={description}
/>


<meta
property="og:type"
content="website"
/>


<meta
property="og:site_name"
content="VIRELLAART"
/>


<meta
property="og:url"
content={canonicalURL}
/>


<meta
property="og:image"
content={imageURL}
/>


<!-- Twitter -->

<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={`${title} | VIRELLAART Luxury Furniture`}
/>


<meta
name="twitter:description"
content={description}
/>


<meta
name="twitter:image"
content={imageURL}
/>




<script
type="application/ld+json"
set:html={JSON.stringify(organizationSchema)}
/>


<script
type="application/ld+json"
set:html={JSON.stringify(websiteSchema)}
/>


</head>


<body>

<Navbar />

<main>
<slot />
</main>

</body>

</html>