---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import {
  getLanguageFromPath,
  getTranslations,
  languageCodes,
  languages,
  localizedPath,
  stripLanguagePrefix,
} from "../i18n/config";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description,
  image = "/living-room.webp"
} = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const pageDescription = description ?? translations.defaultDescription;
const fullTitle = title.includes("VIRELLAART")
  ? title
  : `${title} | VIRELLAART`;
const basePath = stripLanguagePrefix(Astro.url.pathname);
const alternateURLs = languageCodes.map((code) => ({
  language: code,
  href: new URL(localizedPath(basePath, code), "https://www.virellaart.com").href,
}));

const canonicalURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com"
).href;

const imageURL = new URL(
  image,
  "https://www.virellaart.com"
).href;


const organizationSchema = {

  "@context": "https://schema.org",

  "@type": "Organization",

  "name": "VIRELLAART",

  "url": "https://www.virellaart.com",

  "logo": "https://www.virellaart.com/favicon.ico",

  "description":
  translations.defaultDescription,

  "sameAs": [
    "https://www.instagram.com/virellaart/",
    "https://www.facebook.com/VirellaArtFurniture",
    "https://www.pinterest.com/virellaart/",
    "https://www.threads.com/@virellaart"
  ]

};


const websiteSchema = {

  "@context": "https://schema.org",

  "@type": "WebSite",

  "name": "VIRELLAART",

  "url": "https://www.virellaart.com",

  "inLanguage": language

};
---


<!DOCTYPE html>
<html lang={language} dir={languages[language].dir}>

<head>

<meta charset="UTF-8" />

<script
  is:inline
  define:vars={{
    currentLanguage: language,
    supportedLanguages: languageCodes,
  }}
>
  (() => {
    const storageKey = "virellaart-language";
    const isBot = /bot|crawler|spider|crawling|google|bing|yandex/i.test(
      navigator.userAgent,
    );

    document.addEventListener("click", (event) => {
      const target = event.target;
      const link =
        target instanceof Element
          ? target.closest("[data-language]")
          : null;

      if (link instanceof HTMLElement && link.dataset.language) {
        localStorage.setItem(storageKey, link.dataset.language);
      }
    });

    if (isBot || currentLanguage !== "en") {
      return;
    }

    const savedLanguage = localStorage.getItem(storageKey);
    const candidates = savedLanguage
      ? [savedLanguage]
      : [...navigator.languages, navigator.language];
    const detectedLanguage = candidates
      .map((candidate) => candidate?.toLowerCase().split("-")[0])
      .find((candidate) => supportedLanguages.includes(candidate));

    if (!detectedLanguage || detectedLanguage === "en") {
      return;
    }

    const path =
      window.location.pathname === "/"
        ? `/${detectedLanguage}/`
        : `/${detectedLanguage}${window.location.pathname}`;

    window.location.replace(
      `${path}${window.location.search}${window.location.hash}`,
    );
  })();
</script>

<!-- Google Analytics -->

<script async src="https://www.googletagmanager.com/gtag/js?id=G-Y8YY6ZBD87"></script>

<script is:inline>
window.dataLayer = window.dataLayer || [];

function gtag(){
dataLayer.push(arguments);
}

gtag('js', new Date());

gtag('config', 'G-Y8YY6ZBD87');
</script>

<script is:inline>
document.addEventListener("click", (event) => {
  const target = event.target;
  const button =
    target instanceof Element ? target.closest("a.whatsapp") : null;

  if (!button) return;

  console.log("WHATSAPP CLICK");

  if (typeof window.gtag === "function") {
    window.gtag("event", "whatsapp_click", {
      event_category: "engagement",
      event_label: "WhatsApp Button"
    });

    console.log("GA4 WHATSAPP SENT");
  }
});
</script>


  <meta
name="google-site-verification"
content="laUkxyOiCW63Ekw2HmTw3lFbpAiSx5qwdotv3ERgK-A"
/>

<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>


<title>
{fullTitle}
</title>


<meta 
name="description"
content={pageDescription}
/>


<meta 
name="robots"
content="index, follow"
/>


<meta 
name="theme-color"
content="#17130f"
/>


<link 
rel="canonical"
href={canonicalURL}
/>

{
  alternateURLs.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.language}
      href={alternate.href}
    />
  ))
}

<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(basePath, "https://www.virellaart.com").href}
/>


<link 
rel="icon"
href="/favicon.ico"
/>


<!-- Open Graph -->

<meta
property="og:title"
content={fullTitle}
/>


<meta
property="og:description"
content={pageDescription}
/>


<meta
property="og:type"
content="website"
/>


<meta
property="og:site_name"
content="VIRELLAART"
/>


<meta
property="og:url"
content={canonicalURL}
/>


<meta
property="og:image"
content={imageURL}
/>

<meta
property="og:locale"
content={languages[language].locale}
/>

{
  languageCodes
    .filter((code) => code !== language)
    .map((code) => (
      <meta
        property="og:locale:alternate"
        content={languages[code].locale}
      />
    ))
}


<!-- Twitter -->

<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={fullTitle}
/>


<meta
name="twitter:description"
content={pageDescription}
/>


<meta
name="twitter:image"
content={imageURL}
/>




<script
type="application/ld+json"
set:html={JSON.stringify(organizationSchema)}
/>


<script
type="application/ld+json"
set:html={JSON.stringify(websiteSchema)}
/>


</head>


<body>

<Navbar />

<main>
<slot />
</main>

</body>

</html>
