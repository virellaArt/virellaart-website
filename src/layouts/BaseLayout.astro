---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import CookieConsent from "../components/CookieConsent.astro";
import {
  getLanguageFromPath,
  getTranslations,
  languageCodes,
  languages,
  localizedPath,
  stripLanguagePrefix,
} from "../i18n/config";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageType?: "website" | "product" | "article";
  robots?: string;
  alternateURLs?: {
    language: string;
    href: string;
  }[];
  xDefaultURL?: string;
  includeCanonical?: boolean;
}

const {
  title,
  description,
  image = "/living-room.webp",
  imageAlt,
  pageType = "website",
  robots = "index, follow",
  alternateURLs: customAlternateURLs,
  xDefaultURL: customXDefaultURL,
  includeCanonical = true,
} = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const skipToContent = {
  en: "Skip to content",
  tr: "İçeriğe geç",
  de: "Zum Inhalt springen",
  fr: "Aller au contenu",
  it: "Vai al contenuto",
  ru: "Перейти к содержанию",
  ar: "انتقل إلى المحتوى",
  bg: "Към съдържанието",
  ro: "Sari la conținut",
  el: "Μετάβαση στο περιεχόμενο",
  es: "Ir al contenido",
  sr: "Pređi na sadržaj",
  kk: "Мазмұнға өту",
  uz: "Kontentga o‘tish",
  pt: "Ir para o conteúdo",
  pl: "Przejdź do treści",
}[language];
const rawDescription =
  description ?? translations.defaultDescription;
const pageDescription =
  rawDescription.length <= 160
    ? rawDescription
    : `${rawDescription
        .slice(0, 159)
        .replace(/\s+\S*$/, "")
        .replace(/[,;:\s]+$/, "")}.`;
const brandSuffix = " | VIRELLAART";
const titleWithoutBrand = title
  .replace(/\s*\|\s*VIRELLAART\s*$/i, "")
  .trim();
const titleAlreadyIncludesBrand =
  /\bVIRELLAART\b/i.test(titleWithoutBrand);
const titleWithBrand =
  titleAlreadyIncludesBrand
    ? titleWithoutBrand
    : `${titleWithoutBrand}${brandSuffix}`;
const fullTitle =
  titleWithBrand.length <= 65
    ? titleWithBrand
    : titleWithoutBrand;
const basePath = stripLanguagePrefix(Astro.url.pathname);
const isHomePage = basePath === "/";
/* VIRELLAART LOCALIZED POLICY SEO */
const defaultAlternateURLs = languageCodes.map((code) => ({
  language: code,
  href: new URL(
    localizedPath(basePath, code),
    "https://www.virellaart.com"
  ).href,
}));
const alternateURLs =
  customAlternateURLs ?? defaultAlternateURLs;

const canonicalPath = Astro.url.pathname.replace(/\/?$/, "/");

const canonicalURL = new URL(
  canonicalPath,
  "https://www.virellaart.com"
).href;
const xDefaultURL =
  customXDefaultURL ??
  new URL(
    `${basePath.replace(/\/?$/, "/")}`,
    "https://www.virellaart.com"
  ).href;
const languageLinks = Object.fromEntries(
  languageCodes.map((code) => {
    if (basePath === "/404") {
      return [code, localizedPath("/", code)];
    }

    if (customAlternateURLs) {
      if (code === language) {
        return [code, canonicalURL];
      }

      const matchingAlternate =
        customAlternateURLs.find(
          (alternate) =>
            alternate.language
              .toLowerCase()
              .split("-")[0] === code,
        );

      return [
        code,
        matchingAlternate?.href ??
          localizedPath("/", code),
      ];
    }

    return [
      code,
      localizedPath(basePath, code),
    ];
  }),
);

const imageURL = new URL(
  image,
  "https://www.virellaart.com"
).href;


const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.virellaart.com/#organization",
  "name": "VIRELLAART",
  "legalName": "VIRELLAART",
  "url": "https://www.virellaart.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://www.virellaart.com/favicon.svg",
  },
  "description": translations.defaultDescription,
  "telephone": "+90 553 947 86 08",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "telephone": "+90 553 947 86 08",
    "availableLanguage": languageCodes,
    "areaServed": "Worldwide",
  },
  "sameAs": [
    "https://www.instagram.com/virellaart/",
    "https://www.facebook.com/VirellaArtFurniture",
    "https://www.pinterest.com/virellaart/",
    "https://www.threads.com/@virellaart"
  ],
};


const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.virellaart.com/#website",
  "name": "VIRELLAART",
  "alternateName": "VIRELLAART Luxury Furniture",
  "url": "https://www.virellaart.com",
  "inLanguage": language,
  "publisher": {
    "@id": "https://www.virellaart.com/#organization",
  },
};
---


<!DOCTYPE html>
<html lang={language} dir={languages[language].dir}>

<head>
<meta name="p:domain_verify" content="fe900002f59408a3063790cd18fab6eb" />
<meta charset="UTF-8" />

<script
  is:inline
  define:vars={{
    currentLanguage: language,
    supportedLanguages: languageCodes,
  }}
>
  (() => {
    const storageKey = "virellaart-language";
    const isBot = /bot|crawler|spider|crawling|google|bing|yandex/i.test(
      navigator.userAgent,
    );

    document.addEventListener("click", (event) => {
      const target = event.target;
      const link =
        target instanceof Element
          ? target.closest("[data-language]")
          : null;

      if (link instanceof HTMLElement && link.dataset.language) {
        localStorage.setItem(storageKey, link.dataset.language);
      }
    });

    if (
      isBot ||
      currentLanguage !== "en" ||
      window.location.pathname !== "/"
    ) {
      return;
    }

    const savedLanguage = localStorage.getItem(storageKey);
    const candidates = savedLanguage
      ? [savedLanguage]
      : [...navigator.languages, navigator.language];
    const detectedLanguage = candidates
      .map((candidate) => candidate?.toLowerCase().split("-")[0])
      .find((candidate) => supportedLanguages.includes(candidate));

    if (!detectedLanguage || detectedLanguage === "en") {
      return;
    }

    const path = `/${detectedLanguage}/`;

    window.location.replace(
      `${path}${window.location.search}${window.location.hash}`,
    );
  })();
</script>

<script is:inline>
document.addEventListener("click", (event) => {
  const target = event.target;
  const button =
    target instanceof Element
      ? target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]')
      : null;

  if (!(button instanceof HTMLAnchorElement)) return;

  if (
    window.virellaAnalyticsAllowed === true &&
    typeof window.gtag === "function"
  ) {
    const pathname = window.location.pathname;
    const pathSegments =
      pathname.split("/").filter(Boolean);
    const knownLanguages =
      new Set([
        "tr", "de", "fr", "it", "ru", "ar",
        "bg", "ro", "el", "es", "sr", "kk",
        "uz", "pt", "pl",
      ]);
    const routeSegments =
      knownLanguages.has(pathSegments[0])
        ? pathSegments.slice(1)
        : pathSegments;
    const pageType =
      button.dataset.pageType ||
      (routeSegments.length === 0
        ? "home"
        : routeSegments[0] === "markets"
          ? "market"
          : routeSegments[0] === "collections" &&
              routeSegments.length >= 4
            ? "product"
            : [
                "living-rooms",
                "dining-rooms",
                "bedrooms",
                "tv-units",
              ].includes(routeSegments[0]) &&
                routeSegments.length >= 2
              ? "product"
              : [
                  "living-rooms",
                  "dining-rooms",
                  "bedrooms",
                  "tv-units",
                  "collections",
                ].includes(routeSegments[0])
                ? "category"
                : "content");
    const selectedPrice =
      button.dataset.price || "";
    const leadValue = Number(
      selectedPrice.replace(/[^\d.]/g, ""),
    );
    const derivedMarketName =
      routeSegments[0] === "markets"
        ? routeSegments[1]
            ?.replaceAll("-", " ")
            .replace(/\b\w/g, (letter) =>
              letter.toUpperCase(),
            )
        : undefined;
    const searchParams =
      new URLSearchParams(window.location.search);
    const referrerHost = (() => {
      if (!document.referrer) return "";

      try {
        return new URL(document.referrer).hostname.toLowerCase();
      } catch {
        return "";
      }
    })();
    const inferredSocialSource =
      referrerHost.includes("instagram")
        ? "instagram"
        : referrerHost.includes("facebook") ||
            referrerHost.includes("fb.com")
          ? "facebook"
          : referrerHost.includes("pinterest")
            ? "pinterest"
            : undefined;
    const eventData = {
      cta_position:
        button.dataset.whatsappContext ||
        "page",
      cta_text:
        button.textContent?.trim() ||
        button.getAttribute("aria-label") ||
        "WhatsApp",
      product_name:
        button.dataset.product ||
        button.dataset.productName ||
        undefined,
      product_category:
        button.dataset.productCategory ||
        undefined,
      selected_configuration:
        button.dataset.configuration ||
        undefined,
      selected_price:
        selectedPrice ||
        undefined,
      page_language:
        document.documentElement.lang,
      page_type:
        pageType,
      page_path:
        pathname,
      market_name:
        button.dataset.market ||
        derivedMarketName ||
        undefined,
      page_url:
        button.dataset.pageUrl ||
        window.location.href,
      landing_url:
        window.location.href,
      utm_source:
        searchParams.get("utm_source") ||
        inferredSocialSource ||
        undefined,
      utm_medium:
        searchParams.get("utm_medium") ||
        (inferredSocialSource ? "social" : undefined),
      utm_campaign:
        searchParams.get("utm_campaign") ||
        undefined,
      utm_content:
        searchParams.get("utm_content") ||
        undefined,
      quote_engine:
        button.dataset.quoteEngine ||
        undefined,
      link_url:
        button.href,
      lead_type:
        "whatsapp",
      transport_type:
        "beacon"
    }

    window.gtag("event", "whatsapp_click", {
      event_category: "engagement",
      event_label: "WhatsApp Button",
      ...eventData
    });

    window.gtag("event", "generate_lead", {
      method: "WhatsApp",
      ...(Number.isFinite(leadValue) && leadValue > 0
        ? {
            currency: "USD",
            value: leadValue,
          }
        : {}),
      ...eventData
    });
  }
});
</script>


  <meta
name="google-site-verification"
content="laUkxyOiCW63Ekw2HmTw3lFbpAiSx5qwdotv3ERgK-A"
/>

<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>


<title>
{fullTitle}
</title>


<meta 
name="description"
content={pageDescription}
/>


<meta 
name="robots"
content={robots}
/>


<meta 
name="theme-color"
content="#17130f"
/>

<meta
name="color-scheme"
content="dark"
/>

{
  isHomePage && (
    <link
      rel="preload"
      as="image"
      href="/living-room.avif"
      type="image/avif"
      fetchpriority="high"
    />
  )
}


{
  includeCanonical && (
    <link
      rel="canonical"
      href={canonicalURL}
    />
  )
}

{
  alternateURLs.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.language}
      href={alternate.href}
    />
  ))
}

<link
  rel="alternate"
  hreflang="x-default"
  href={xDefaultURL}
/>

<!-- Open Graph -->

<meta
property="og:title"
content={fullTitle}
/>


<meta
property="og:description"
content={pageDescription}
/>


<meta
property="og:type"
content={pageType}
/>


<meta
property="og:site_name"
content="VIRELLAART"
/>


<meta
property="og:url"
content={canonicalURL}
/>


<meta
property="og:image"
content={imageURL}
/>

<meta
property="og:image:alt"
content={imageAlt ?? fullTitle}
/>

<meta
property="og:locale"
content={languages[language].locale}
/>

{
  languageCodes
    .filter((code) => code !== language)
    .map((code) => (
      <meta
        property="og:locale:alternate"
        content={languages[code].locale}
      />
    ))
}


<!-- Twitter -->

<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={fullTitle}
/>


<meta
name="twitter:description"
content={pageDescription}
/>


<meta
name="twitter:image"
content={imageURL}
/>

<meta
name="twitter:image:alt"
content={imageAlt ?? fullTitle}
/>




{
  isHomePage && (
    <>
      <script
        type="application/ld+json"
        set:html={JSON.stringify(organizationSchema)}
      />
      <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteSchema)}
      />
    </>
  )
}


<slot name="head" />

</head>


<body>

<a class="skip-link" href="#main-content">{skipToContent}</a>

<Navbar {languageLinks} />

<main id="main-content">
<slot />
</main>

<Footer />

<WhatsAppCTA />

<CookieConsent />

</body>

</html>
