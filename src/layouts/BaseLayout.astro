---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import {
  getLanguageFromPath,
  getTranslations,
  languageCodes,
  languages,
  localizedPath,
  stripLanguagePrefix,
} from "../i18n/config";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  pageType?: "website" | "product";
}

const {
  title,
  description,
  image = "/living-room.webp",
  imageAlt,
  pageType = "website",
} = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const skipToContent = {
  en: "Skip to content",
  tr: "İçeriğe geç",
  de: "Zum Inhalt springen",
  fr: "Aller au contenu",
  it: "Vai al contenuto",
  ru: "Перейти к содержанию",
  ar: "انتقل إلى المحتوى",
  bg: "Към съдържанието",
  ro: "Sari la conținut",
  el: "Μετάβαση στο περιεχόμενο",
  es: "Ir al contenido",
  sr: "Pređi na sadržaj",
  kk: "Мазмұнға өту",
  uz: "Kontentga o‘tish",
  pt: "Ir para o conteúdo",
  pl: "Przejdź do treści",
}[language];
const pageDescription = description ?? translations.defaultDescription;
const fullTitle = title.includes("VIRELLAART")
  ? title
  : `${title} | VIRELLAART`;
const basePath = stripLanguagePrefix(Astro.url.pathname);
const isHomePage = basePath === "/";
/* VIRELLAART LOCALIZED POLICY SEO */
const alternateURLs = languageCodes.map((code) => ({
  language: code,
  href: new URL(
    localizedPath(basePath, code),
    "https://www.virellaart.com"
  ).href,
}));

const canonicalPath = Astro.url.pathname.replace(/\/?$/, "/");

const canonicalURL = new URL(
  canonicalPath,
  "https://www.virellaart.com"
).href;

const imageURL = new URL(
  image,
  "https://www.virellaart.com"
).href;


const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.virellaart.com/#organization",
  "name": "VIRELLAART",
  "legalName": "VIRELLAART",
  "url": "https://www.virellaart.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://www.virellaart.com/favicon.svg",
  },
  "description": translations.defaultDescription,
  "telephone": "+90 553 947 86 08",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "sales",
    "telephone": "+90 553 947 86 08",
    "availableLanguage": languageCodes,
    "areaServed": "Worldwide",
  },
  "sameAs": [
    "https://www.instagram.com/virellaart/",
    "https://www.facebook.com/VirellaArtFurniture",
    "https://www.pinterest.com/virellaart/",
    "https://www.threads.com/@virellaart"
  ],
};


const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.virellaart.com/#website",
  "name": "VIRELLAART",
  "alternateName": "VIRELLAART Luxury Furniture",
  "url": "https://www.virellaart.com",
  "inLanguage": language,
  "publisher": {
    "@id": "https://www.virellaart.com/#organization",
  },
};
---


<!DOCTYPE html>
<html lang={language} dir={languages[language].dir}>

<head>
<meta name="p:domain_verify" content="fe900002f59408a3063790cd18fab6eb" />
<meta charset="UTF-8" />

<script
  is:inline
  define:vars={{
    currentLanguage: language,
    supportedLanguages: languageCodes,
  }}
>
  (() => {
    const storageKey = "virellaart-language";
    const isBot = /bot|crawler|spider|crawling|google|bing|yandex/i.test(
      navigator.userAgent,
    );

    document.addEventListener("click", (event) => {
      const target = event.target;
      const link =
        target instanceof Element
          ? target.closest("[data-language]")
          : null;

      if (link instanceof HTMLElement && link.dataset.language) {
        localStorage.setItem(storageKey, link.dataset.language);
      }
    });

    if (isBot || currentLanguage !== "en") {
      return;
    }

    const savedLanguage = localStorage.getItem(storageKey);
    const candidates = savedLanguage
      ? [savedLanguage]
      : [...navigator.languages, navigator.language];
    const detectedLanguage = candidates
      .map((candidate) => candidate?.toLowerCase().split("-")[0])
      .find((candidate) => supportedLanguages.includes(candidate));

    if (!detectedLanguage || detectedLanguage === "en") {
      return;
    }

    const path =
      window.location.pathname === "/"
        ? `/${detectedLanguage}/`
        : `/${detectedLanguage}${window.location.pathname}`;

    window.location.replace(
      `${path}${window.location.search}${window.location.hash}`,
    );
  })();
</script>

<!-- Google Analytics -->

<script async src="https://www.googletagmanager.com/gtag/js?id=G-Y8YY6ZBD87"></script>

<script is:inline>
window.dataLayer = window.dataLayer || [];

function gtag(){
dataLayer.push(arguments);
}

gtag('js', new Date());

gtag('config', 'G-Y8YY6ZBD87');
</script>

<script is:inline>
document.addEventListener("click", (event) => {
  const target = event.target;
  const button =
    target instanceof Element
      ? target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]')
      : null;

  if (!(button instanceof HTMLAnchorElement)) return;

  if (typeof window.gtag === "function") {
    const eventData = {
      cta_position:
        button.dataset.whatsappContext ||
        "page",
      product_name:
        button.dataset.product ||
        undefined,
      product_category:
        button.dataset.productCategory ||
        undefined,
      selected_configuration:
        button.dataset.configuration ||
        undefined,
      selected_price:
        button.dataset.price ||
        undefined,
      page_language:
        document.documentElement.lang,
      page_url:
        button.dataset.pageUrl ||
        window.location.href,
      quote_engine:
        button.dataset.quoteEngine ||
        undefined,
      link_url:
        button.href,
      transport_type:
        "beacon"
    }

    window.gtag("event", "whatsapp_click", {
      event_category: "engagement",
      event_label: "WhatsApp Button",
      ...eventData
    });

    window.gtag("event", "generate_lead", {
      method: "WhatsApp",
      ...eventData
    });
  }
});
</script>


  <meta
name="google-site-verification"
content="laUkxyOiCW63Ekw2HmTw3lFbpAiSx5qwdotv3ERgK-A"
/>

<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0"
/>


<title>
{fullTitle}
</title>


<meta 
name="description"
content={pageDescription}
/>


<meta 
name="robots"
content="index, follow"
/>


<meta 
name="theme-color"
content="#17130f"
/>

<meta
name="color-scheme"
content="dark"
/>


<link 
rel="canonical"
href={canonicalURL}
/>

{
  alternateURLs.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.language}
      href={alternate.href}
    />
  ))
}

<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(
    `${basePath.replace(/\/?$/, "/")}`,
    "https://www.virellaart.com"
  ).href}
/>

<!-- Open Graph -->

<meta
property="og:title"
content={fullTitle}
/>


<meta
property="og:description"
content={pageDescription}
/>


<meta
property="og:type"
content={pageType}
/>


<meta
property="og:site_name"
content="VIRELLAART"
/>


<meta
property="og:url"
content={canonicalURL}
/>


<meta
property="og:image"
content={imageURL}
/>

<meta
property="og:image:alt"
content={imageAlt ?? fullTitle}
/>

<meta
property="og:locale"
content={languages[language].locale}
/>

{
  languageCodes
    .filter((code) => code !== language)
    .map((code) => (
      <meta
        property="og:locale:alternate"
        content={languages[code].locale}
      />
    ))
}


<!-- Twitter -->

<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={fullTitle}
/>


<meta
name="twitter:description"
content={pageDescription}
/>


<meta
name="twitter:image"
content={imageURL}
/>

<meta
name="twitter:image:alt"
content={imageAlt ?? fullTitle}
/>




{
  isHomePage && (
    <>
      <script
        type="application/ld+json"
        set:html={JSON.stringify(organizationSchema)}
      />
      <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteSchema)}
      />
    </>
  )
}


</head>


<body>

<a class="skip-link" href="#main-content">{skipToContent}</a>

<Navbar />

<main id="main-content">
<slot />
</main>

<Footer />

<WhatsAppCTA />

</body>

</html>
