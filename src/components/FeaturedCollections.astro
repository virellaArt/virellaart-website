---
import {
  featuredCollections,
  getCatalogMerchandising,
} from "../data/catalog-merchandising";
import { catalogCopy } from "../i18n/catalog";
import {
  type Language,
  localizedPath,
  translateProductName,
} from "../i18n/config";

type Props = {
  language: Language;
};

const { language } = Astro.props;
const copy = catalogCopy[language];

const cards = featuredCollections.map((entry) => ({
  ...entry,
  ...getCatalogMerchandising(entry.key),
}));

function badgeLabel(
  badge: ReturnType<
    typeof getCatalogMerchandising
  >["badge"],
) {
  if (badge === "bestSeller") return copy.bestSeller;
  if (badge === "signature") return copy.signature;
  if (badge === "newArrival") return copy.newArrival;
  return "";
}
---

<section
  class="featured-collections"
  aria-labelledby="featuredCollectionsTitle"
>
  <div class="featured-heading">
    <span>{copy.featuredEyebrow}</span>
    <h2 id="featuredCollectionsTitle">
      {copy.featuredTitle}
    </h2>
    <p>{copy.featuredIntro}</p>
  </div>

  <div class="featured-grid">
    {
      cards.map((card, index) => {
        const name = translateProductName(
          card.product.name,
          language,
        );
        const badge = badgeLabel(card.badge);

        return (
          <a
            class="featured-card"
            href={localizedPath(card.href, language)}
            aria-label={`${copy.viewCollection}: ${name}`}
          >
            <div class="featured-image">
              <img
                src={card.product.images[0]}
                alt={`VIRELLAART ${name}`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
              />

              {badge && <span>{badge}</span>}
            </div>

            <div class="featured-copy">
              <small>
                {card.character === "classic"
                  ? copy.classic
                  : copy.contemporary}
                {" · "}
                {card.imageCount} {copy.photos}
              </small>

              <h3>{name}</h3>

              <p>
                {copy.from}
                {" "}
                <strong>{card.featuredPrice?.price}</strong>
              </p>

              <span class="featured-link">
                {copy.viewCollection}
                <i aria-hidden="true">→</i>
              </span>
            </div>
          </a>
        );
      })
    }
  </div>
</section>

<style>
  .featured-collections {
    width: min(100% - 48px, 1220px);
    margin: 0 auto;
    padding: 104px 0 112px;
  }

  .featured-heading {
    max-width: 720px;
    margin-bottom: 38px;
  }

  .featured-heading > span {
    display: block;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .featured-heading h2 {
    margin: 12px 0 16px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 62px);
    font-weight: 400;
    line-height: 1;
  }

  .featured-heading p {
    margin: 0;
    color: var(--gray);
    font-size: 15px;
    line-height: 1.75;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .featured-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    background: #0c0c0c;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.35s ease,
      border-color 0.35s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
  }

  .featured-image {
    position: relative;
    height: 220px;
    overflow: hidden;
    background: #111;
  }

  .featured-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s ease;
  }

  .featured-card:hover img {
    transform: scale(1.035);
  }

  .featured-image span {
    position: absolute;
    top: 12px;
    inset-inline-start: 12px;
    padding: 8px 10px;
    background: rgba(8, 8, 8, 0.86);
    color: var(--gold);
    font-size: 8px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .featured-copy {
    padding: 18px 18px 20px;
  }

  .featured-copy small {
    color: var(--gold);
    font-size: 8px;
    letter-spacing: 1.25px;
    text-transform: uppercase;
  }

  .featured-copy h3 {
    min-height: 52px;
    margin: 9px 0 13px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.08;
  }

  .featured-copy > p {
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .featured-copy > p strong {
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .featured-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 17px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.78);
    font-size: 9px;
    letter-spacing: 1.7px;
    text-transform: uppercase;
  }

  .featured-link i {
    color: var(--gold);
    font-size: 16px;
    font-style: normal;
  }

  .featured-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  @media (max-width: 1040px) {
    .featured-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured-image {
      height: 290px;
    }
  }

  @media (max-width: 620px) {
    .featured-collections {
      width: min(100% - 20px, 1220px);
      padding: 74px 0 82px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .featured-image {
      height: min(74vw, 330px);
    }

    .featured-copy h3 {
      min-height: 0;
    }
  }
</style>
