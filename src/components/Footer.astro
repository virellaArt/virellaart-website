---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href={localizedPath("/", language)}>VIRELLAART</a>

      <p>{translations.defaultDescription}</p>
    </div>

    <div class="footer-column">
  <span>VIRELLAART</span>

  <a href={localizedPath("/about", language)}>
    {translations.nav.about}
  </a>

  <a href={localizedPath("/manufacturing", language)}>
    {footerText.manufacturing}
  </a>

  <a href={localizedPath("/contact", language)}>
    {translations.nav.contact}
  </a>

  <a
    href="https://www.instagram.com/virellaart/"
    target="_blank"
    rel="noopener noreferrer"
  >
    Instagram
  </a>

  <a
    href="https://www.pinterest.com/virellaart/"
    target="_blank"
    rel="noopener noreferrer"
  >
    Pinterest
  </a>
</div>
    <div class="footer-column">
      <span>{footerText.policies}</span>

      <a href={localizedPath("/policies/shipping-policy", language)}>
        {footerText.shipping}
      </a>

      <a href={localizedPath("/policies/return-refund-policy", language)}>
        {footerText.returns}
      </a>

      <a href={localizedPath("/policies/privacy-policy", language)}>
        {footerText.privacy}
      </a>

      <a href={localizedPath("/policies/terms-conditions", language)}>
        {footerText.terms}
      </a>
    </div>

    <div class="footer-service">
      <span>{translations.product.worldwideDelivery}</span>

      <p>{translations.product.worldwideDeliveryText}</p>

      <strong>{translations.contact.languageValue}</strong>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {year} VIRELLAART</p>

    <p>{translations.product.craftsmanship}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: #0b0908;
  }

  .footer-inner {
    width: min(100% - 64px, var(--container));
    margin: 0 auto;
    display: grid;
    grid-template-columns:
      minmax(260px, 1.5fr)
      minmax(145px, 0.72fr)
      minmax(145px, 0.72fr)
      minmax(185px, 0.9fr)
      minmax(210px, 1fr);
    gap: 48px;
    padding: 78px 0 62px;
  }

  .footer-brand > a {
    display: inline-block;
    margin-bottom: 24px;
    color: #ffffff;
    font-size: 20px;
    letter-spacing: 5px;
  }

  .footer-brand p,
  .footer-service p {
    max-width: 440px;
    color: rgba(245, 239, 230, 0.64);
    font-size: 14px;
    line-height: 1.8;
  }

  .footer-column,
  .footer-service {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
  }

  .footer-column > span,
  .footer-service > span {
    margin-bottom: 9px;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .footer-column a {
    color: rgba(255, 255, 255, 0.76);
    font-size: 13px;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    color: var(--gold-light);
  }

  .footer-service strong {
    color: #ffffff;
    font-size: 13px;
    font-weight: 400;
  }

  .footer-bottom {
    width: min(100% - 64px, var(--container));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.42);
    font-size: 10px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  @media (max-width: 1180px) {
    .footer-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 48px;
    }

    .footer-brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 580px) {
    .footer-inner,
    .footer-bottom {
      width: min(100% - 32px, var(--container));
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 38px;
      padding: 60px 0 46px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>