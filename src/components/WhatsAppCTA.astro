---
import {
  getLanguageFromPath,
  getTranslations,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const message = translations.product.whatsappMessage.replace(
  "{product}",
  "VIRELLAART",
);
const whatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(message)}`;
---

<a
  class="whatsapp-float"
  href={whatsappURL}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp-context="floating"
  aria-label={translations.product.whatsapp}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 32 32"
    width="24"
    height="24"
  >
    <path
      fill="currentColor"
      d="M16.04 3A12.9 12.9 0 0 0 4.87 22.37L3 29l6.82-1.79A12.96 12.96 0 1 0 16.04 3Zm0 23.73a10.7 10.7 0 0 1-5.46-1.49l-.39-.23-4.05 1.06 1.08-3.94-.26-.41a10.74 10.74 0 1 1 9.08 5.01Zm5.89-8.04c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.33-.83 1.05-1.02 1.27-.19.21-.38.24-.7.08-.33-.16-1.37-.5-2.61-1.61a9.8 9.8 0 0 1-1.81-2.25c-.19-.32-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.21-.32.32-.54.11-.21.06-.4-.02-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.55-.73-.56h-.62c-.22 0-.57.08-.87.4-.3.33-1.13 1.11-1.13 2.7 0 1.59 1.16 3.13 1.32 3.35.16.21 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.78.25 1.48.21 2.04.13.62-.09 1.91-.78 2.18-1.54.27-.75.27-1.4.19-1.54-.08-.13-.3-.21-.62-.37Z"
    ></path>
  </svg>
  <span>{translations.product.whatsapp}</span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 22px;
    bottom: calc(22px + env(safe-area-inset-bottom));
    z-index: 1200;
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: #178c4e;
    color: #ffffff;
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.42);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    white-space: nowrap;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .whatsapp-float:hover {
    background: #1aa65b;
    box-shadow: 0 20px 50px rgba(12, 118, 63, 0.35);
    transform: translateY(-3px);
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid var(--gold-light);
    outline-offset: 4px;
  }

  :global(html[dir="rtl"]) .whatsapp-float {
    right: auto;
    left: 22px;
  }

  @media (max-width: 620px) {
    .whatsapp-float {
      right: 14px;
      bottom: calc(14px + env(safe-area-inset-bottom));
      width: 56px;
      min-height: 56px;
      box-sizing: border-box;
      padding: 0;
    }

    .whatsapp-float span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    :global(html[dir="rtl"]) .whatsapp-float {
      right: auto;
      left: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }
  }

  /* FLOATING WHATSAPP VISIBILITY */

  .whatsapp-float {
    opacity: 0;
    pointer-events: none;
    transform:
      translateY(14px)
      scale(0.92);
    transition:
      opacity 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .whatsapp-float.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform:
      translateY(0)
      scale(1);
  }

</style>

<script is:inline>
  /* FLOATING WHATSAPP VISIBILITY */
  (() => {
    const initialize = () => {
      const button =
        document.querySelector(
          ".whatsapp-float"
        );

      if (!(button instanceof HTMLElement)) {
        return;
      }

      const updateVisibility = () => {
        const collections =
          document.querySelector(
            "#collections"
          );

        let shouldShow = false;

        if (
          collections instanceof HTMLElement
        ) {
          const showAfter =
            collections.offsetTop +
            collections.offsetHeight -
            60;

          shouldShow =
            window.scrollY > showAfter;
        } else {
          shouldShow =
            window.scrollY > 450;
        }

        button.classList.toggle(
          "is-visible",
          shouldShow,
        );
      };

      updateVisibility();

      window.addEventListener(
        "scroll",
        updateVisibility,
        { passive: true },
      );

      window.addEventListener(
        "resize",
        updateVisibility,
      );
    };

    if (
      document.readyState === "loading"
    ) {
      document.addEventListener(
        "DOMContentLoaded",
        initialize,
      );
    } else {
      initialize();
    }
  })();
</script>
