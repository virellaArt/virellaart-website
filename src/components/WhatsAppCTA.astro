---
import {
  getLanguageFromPath,
  getTranslations,
  stripLanguagePrefix,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const message = translations.product.whatsappMessage.replace(
  "{product}",
  "VIRELLAART",
);
const pageURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com",
).href;
const isHomePage =
  stripLanguagePrefix(Astro.url.pathname) === "/";

const homeQuotePrompts: Record<string, string> = {
  en: "Please send:\n• Collection or model:\n• Delivery country:\n• Delivery city:\n• Preferred configuration / pieces:",
  tr: "Lütfen gönderin:\n• Koleksiyon veya model:\n• Teslimat ülkesi:\n• Teslimat şehri:\n• İstenen takım / parçalar:",
  de: "Bitte senden Sie:\n• Kollektion oder Modell:\n• Lieferland:\n• Lieferstadt:\n• Gewünschte Konfiguration / Teile:",
  fr: "Merci d’indiquer :\n• Collection ou modèle :\n• Pays de livraison :\n• Ville de livraison :\n• Configuration / pièces souhaitées :",
  it: "Invia per favore:\n• Collezione o modello:\n• Paese di consegna:\n• Città di consegna:\n• Configurazione / pezzi desiderati:",
  ru: "Пожалуйста, укажите:\n• Коллекция или модель:\n• Страна доставки:\n• Город доставки:\n• Нужная комплектация / предметы:",
  ar: "يرجى إرسال:\n• المجموعة أو الموديل:\n• بلد التسليم:\n• مدينة التسليم:\n• التكوين / القطع المطلوبة:",
  bg: "Моля, изпратете:\n• Колекция или модел:\n• Държава за доставка:\n• Град за доставка:\n• Желана конфигурация / артикули:",
  ro: "Vă rugăm să trimiteți:\n• Colecția sau modelul:\n• Țara de livrare:\n• Orașul de livrare:\n• Configurația / piesele dorite:",
  el: "Παρακαλώ στείλτε:\n• Συλλογή ή μοντέλο:\n• Χώρα παράδοσης:\n• Πόλη παράδοσης:\n• Επιθυμητή σύνθεση / τεμάχια:",
  es: "Indique por favor:\n• Colección o modelo:\n• País de entrega:\n• Ciudad de entrega:\n• Configuración / piezas deseadas:",
  sr: "Molimo pošaljite:\n• Kolekciju ili model:\n• Državu isporuke:\n• Grad isporuke:\n• Željenu konfiguraciju / komade:",
  kk: "Жіберіңіз:\n• Коллекция немесе модель:\n• Жеткізу елі:\n• Жеткізу қаласы:\n• Қажетті жиынтық / бөлшектер:",
  uz: "Iltimos, yuboring:\n• Kolleksiya yoki model:\n• Yetkazib berish mamlakati:\n• Yetkazib berish shahri:\n• Kerakli konfiguratsiya / qismlar:",
  pt: "Por favor indique:\n• Coleção ou modelo:\n• País de entrega:\n• Cidade de entrega:\n• Configuração / peças pretendidas:",
  pl: "Proszę podać:\n• Kolekcję lub model:\n• Kraj dostawy:\n• Miasto dostawy:\n• Wybraną konfigurację / elementy:",
};

const homeQuotePrompt =
  homeQuotePrompts[language] ?? homeQuotePrompts.en;
const whatsappMessage = isHomePage
  ? [message, "", homeQuotePrompt, "", pageURL].join("\n")
  : [message, "", pageURL].join("\n");
const whatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(whatsappMessage)}`;
---

<a
  class="whatsapp-float"
  href={whatsappURL}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp-context="floating"
  data-page-url={pageURL}
  data-home-page={isHomePage ? "true" : "false"}
  aria-label={translations.product.whatsapp}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 32 32"
    width="24"
    height="24"
  >
    <path
      fill="currentColor"
      d="M16.04 3A12.9 12.9 0 0 0 4.87 22.37L3 29l6.82-1.79A12.96 12.96 0 1 0 16.04 3Zm0 23.73a10.7 10.7 0 0 1-5.46-1.49l-.39-.23-4.05 1.06 1.08-3.94-.26-.41a10.74 10.74 0 1 1 9.08 5.01Zm5.89-8.04c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.33-.83 1.05-1.02 1.27-.19.21-.38.24-.7.08-.33-.16-1.37-.5-2.61-1.61a9.8 9.8 0 0 1-1.81-2.25c-.19-.32-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.21-.32.32-.54.11-.21.06-.4-.02-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.55-.73-.56h-.62c-.22 0-.57.08-.87.4-.3.33-1.13 1.11-1.13 2.7 0 1.59 1.16 3.13 1.32 3.35.16.21 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.78.25 1.48.21 2.04.13.62-.09 1.91-.78 2.18-1.54.27-.75.27-1.4.19-1.54-.08-.13-.3-.21-.62-.37Z"
    ></path>
  </svg>
  <span>{translations.product.whatsapp}</span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 22px;
    bottom: calc(22px + env(safe-area-inset-bottom));
    z-index: 1200;
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: #178c4e;
    color: #ffffff;
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.42);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    white-space: nowrap;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .whatsapp-float:hover {
    background: #1aa65b;
    box-shadow: 0 20px 50px rgba(12, 118, 63, 0.35);
    transform: translateY(-3px);
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid var(--gold-light);
    outline-offset: 4px;
  }

  :global(html[dir="rtl"]) .whatsapp-float {
    right: auto;
    left: 22px;
  }

  @media (max-width: 620px) {
    .whatsapp-float {
      right: 14px;
      bottom: calc(14px + env(safe-area-inset-bottom));
      width: 56px;
      min-height: 56px;
      box-sizing: border-box;
      padding: 0;
    }

    .whatsapp-float span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    :global(html[dir="rtl"]) .whatsapp-float {
      right: auto;
      left: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: none;
    }
  }

  .whatsapp-float {
    opacity: 0;
    pointer-events: none;
    transform:
      translateY(14px)
      scale(0.92);
    transition:
      opacity 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .whatsapp-float.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform:
      translateY(0)
      scale(1);
  }
</style>

<script is:inline>
  (() => {
    const initialize = () => {
      const button = document.querySelector(".whatsapp-float");

      if (!(button instanceof HTMLAnchorElement)) {
        return;
      }

      const quoteBuilder = document.querySelector(
        "[data-quote-builder]",
      );
      const categoryTarget =
        document.querySelector(
          "[data-collection-catalog] [data-catalog-grid]",
        ) ??
        document.querySelector(
          "[data-modern-product-grid]",
        );
      const collections = document.querySelector("#collections");
      const homeHeroWhatsapp = document.querySelector(
        'a[data-whatsapp-context="home-hero"][href*="wa.me"]',
      );
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (
        button.dataset.homePage === "true" &&
        homeHeroWhatsapp instanceof HTMLAnchorElement
      ) {
        homeHeroWhatsapp.href = button.href;
        homeHeroWhatsapp.dataset.pageUrl =
          button.dataset.pageUrl || window.location.href;
      }

      const trackFunnel = (step) => {
        if (
          window.virellaAnalyticsAllowed === true &&
          typeof window.gtag === "function"
        ) {
          window.gtag("event", "funnel_continue", {
            funnel_step: step,
            page_path: window.location.pathname,
            page_language: document.documentElement.lang,
          });
        }
      };

      const moveTo = (target, step) => {
        if (!(target instanceof HTMLElement)) return;

        target.scrollIntoView({
          behavior: reduceMotion ? "auto" : "smooth",
          block: "start",
        });

        trackFunnel(step);
      };

      const handleProductFunnel = (event) => {
        if (!(quoteBuilder instanceof HTMLElement)) return;

        event.preventDefault();
        event.stopPropagation();
        moveTo(quoteBuilder, "product_quote_builder");

        const country = document.querySelector("#quoteCountry");
        if (
          country instanceof HTMLInputElement &&
          country.value.trim() === ""
        ) {
          requestAnimationFrame(() => {
            country.focus({ preventScroll: true });
          });
        }
      };

      const handleCategoryFunnel = (event) => {
        if (!(categoryTarget instanceof HTMLElement)) return;

        event.preventDefault();
        event.stopPropagation();
        moveTo(categoryTarget, "category_product_selection");
      };

      if (quoteBuilder instanceof HTMLElement) {
        button.dataset.funnelMode = "product-quote";
        button.addEventListener("click", handleProductFunnel);
      } else if (categoryTarget instanceof HTMLElement) {
        button.dataset.funnelMode = "category-products";
        button.addEventListener("click", handleCategoryFunnel);

        document
          .querySelectorAll(
            'a[data-page-type="category"][href*="wa.me"], a[data-whatsapp-context*="category"][href*="wa.me"]',
          )
          .forEach((link) => {
            if (
              link instanceof HTMLAnchorElement &&
              link !== button
            ) {
              link.addEventListener("click", handleCategoryFunnel);
            }
          });
      }

      const updateVisibility = () => {
        let shouldShow = false;

        if (
          quoteBuilder instanceof HTMLElement ||
          categoryTarget instanceof HTMLElement ||
          button.dataset.homePage === "true"
        ) {
          shouldShow = window.scrollY > 120;
        } else if (collections instanceof HTMLElement) {
          shouldShow = window.scrollY > 120;
        } else {
          shouldShow = window.scrollY > 280;
        }

        button.classList.toggle("is-visible", shouldShow);
      };

      updateVisibility();

      window.addEventListener("scroll", updateVisibility, {
        passive: true,
      });
      window.addEventListener("resize", updateVisibility);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initialize);
    } else {
      initialize();
    }
  })();
</script>