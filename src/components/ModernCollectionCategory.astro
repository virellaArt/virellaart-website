---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/products";
import { collectionMenuCopy } from "../i18n/collection-menu";
import {
  getLanguageFromPath,
  getTranslations,
  localizedPath,
  translatePriceLabel,
  translateProductName,
} from "../i18n/config";

type ModernCategory =
  | "sofa-sets"
  | "dining-rooms"
  | "bedrooms"
  | "tv-units";

interface Props {
  category: ModernCategory;
}

const { category } = Astro.props;
const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const copy = collectionMenuCopy[language];

const categoryDetails = {
  "sofa-sets": {
    title: copy.sofaSets,
    image: "/living-room.webp",
  },
  "dining-rooms": {
    title: translations.home.diningRooms,
    image: "/dining-room.webp",
  },
  bedrooms: {
    title: translations.home.bedrooms,
    image: "/bedroom.webp",
  },
  "tv-units": {
    title: translations.home.tvUnits,
    image: "/tv-unit.webp",
  },
} as const;

const details = categoryDetails[category];
const productCategory = {
  "sofa-sets": "living-rooms",
  "dining-rooms": "dining-rooms",
  bedrooms: "bedrooms",
  "tv-units": "tv-units",
}[category];

type ModernProductCard = {
  name: string;
  slug?: string;
  category: string;
  style: string;
  images: string[];
  prices: Array<{
    label: string;
    price: string;
    featured?: boolean;
  }>;
};

const categoryProducts = (
  Object.values(products) as ModernProductCard[]
)
  .filter(
    (product) =>
      product.style === "modern" &&
      product.category === productCategory &&
      product.slug,
  )
  .map((product) => {
    const featuredPrice =
      product.prices.find(
        (price) => price.featured,
      ) ?? product.prices[0];

    return {
      ...product,
      translatedName: translateProductName(
        product.name,
        language,
      ),
      translatedPriceLabel: featuredPrice
        ? translatePriceLabel(
            featuredPrice.label,
            language,
          )
        : "",
      featuredPrice,
    };
  });

const pageImage =
  categoryProducts[0]?.images[0] ??
  details.image;
const pageTitle = copy.categoryTitle.replace(
  "{category}",
  details.title,
);
const pageDescription =
  copy.categoryDescriptions?.[category] ??
  copy.categoryDescription.replace("{category}", details.title);
const categoryWhatsappMessage =
  translations.product.whatsappMessage.replace(
    "{product}",
    `${copy.modern} ${details.title}`,
  );
const categoryWhatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(categoryWhatsappMessage)}`;
const categoryPageURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com",
).href;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  robots={
    categoryProducts.length > 0
      ? "index, follow"
      : "noindex, follow"
  }
  includeCanonical={categoryProducts.length > 0}
>
  <section class="modern-category">
    <div class="modern-category-copy">
      <span>{copy.categoryEyebrow}</span>
      <h1>{pageTitle}</h1>
      <p>{pageDescription}</p>
    </div>

    {
      categoryProducts.length > 0 && (
        <aside class="modern-category-lead">
          <div>
            <span>{translations.contact.getInTouch}</span>
            <strong>{translations.contact.hero}</strong>
            <p>{translations.contact.lead}</p>
          </div>

          <a
            href={categoryWhatsappURL}
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-context="modern-category-header"
            data-page-type="category"
            data-product-category={`${copy.modern} ${details.title}`}
            data-page-url={categoryPageURL}
          >
            {translations.contact.button}
          </a>
        </aside>
      )
    }

    {
      categoryProducts.length > 0 ? (
        <div
          class="modern-product-grid"
          data-modern-product-grid
          data-category-name={`${copy.modern} ${details.title}`}
        >
          {categoryProducts.map((product) => (
            <a
              class="modern-product-card"
              data-product-key={product.slug}
              data-product-name={product.translatedName}
              data-product-price={product.featuredPrice?.price}
              href={localizedPath(
                `/collections/modern/${category}/${product.slug}`,
                language,
              )}
            >
              <div class="modern-product-image">
                <img
                  src={product.images[0]}
                  alt={product.translatedName}
                  width="1200"
                  height="900"
                  decoding="async"
                />
                <span>
                  {String(product.images.length).padStart(
                    2,
                    "0",
                  )}{" "}
                  IMAGES
                </span>
              </div>

              <div class="modern-product-copy">
                <small>
                  {copy.modern} · {details.title}
                </small>
                <h2>{product.translatedName}</h2>
                {product.featuredPrice && (
                  <p>
                    {product.translatedPriceLabel}
                    <strong>
                      {product.featuredPrice.price}
                    </strong>
                  </p>
                )}
                <span>{copy.exploreCategory} →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <>
          <div class="modern-category-visual">
            <img
              src={details.image}
              alt={details.title}
              width="1200"
              height="900"
              decoding="async"
            />
            <span aria-hidden="true">MODERN</span>
          </div>

          <div class="modern-empty-state">
            <span>0</span>
            <div>
              <h2>{copy.emptyTitle}</h2>
              <p>{copy.emptyText}</p>

              <div class="modern-empty-actions">
                <a
                  href={localizedPath(
                    "/collections/modern",
                    language,
                  )}
                >
                  ← {copy.backToModern}
                </a>
                <a
                  href={localizedPath(
                    "/contact",
                    language,
                  )}
                >
                  {copy.contact} →
                </a>
              </div>
            </div>
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  document
    .querySelectorAll("[data-modern-product-grid]")
    .forEach((grid) => {
      if (!(grid instanceof HTMLElement)) return;

      const categoryName =
        grid.dataset.categoryName ?? "Modern";
      const cards = Array.from(
        grid.querySelectorAll("[data-product-key]"),
      );
      const itemFor = (
        card: Element,
        index: number,
      ) => {
        const element = card as HTMLElement;
        const price = Number(
          (element.dataset.productPrice ?? "")
            .replace(/[^\d.]/g, ""),
        );

        return {
          item_id:
            element.dataset.productKey ??
            String(index + 1),
          item_name:
            element.dataset.productName ??
            "VIRELLAART",
          item_brand: "VIRELLAART",
          item_category: categoryName,
          price: Number.isFinite(price) ? price : 0,
          index,
        };
      };
      const sendViewItemList = () => {
        if (
          window.virellaAnalyticsAllowed !== true ||
          typeof window.gtag !== "function"
        ) {
          return;
        }

        window.gtag("event", "view_item_list", {
          item_list_name: categoryName,
          items: cards.map(itemFor),
        });
      };

      if (window.virellaAnalyticsAllowed === true) {
        sendViewItemList();
      } else {
        document.addEventListener(
          "virella:analytics-ready",
          sendViewItemList,
          { once: true },
        );
      }

      const sendPinterestViewCategory = () => {
        window.virellaPinterestViewCategory(categoryName);
      };

      if (window.virellaAnalyticsAllowed === true) {
        sendPinterestViewCategory();
      } else {
        document.addEventListener(
          "virella:pinterest-ready",
          sendPinterestViewCategory,
          { once: true },
        );
      }

      grid.addEventListener("click", (event) => {
        const target = event.target;
        const card =
          target instanceof Element
            ? target.closest("[data-product-key]")
            : null;

        if (
          !(card instanceof HTMLElement) ||
          window.virellaAnalyticsAllowed !== true ||
          typeof window.gtag !== "function"
        ) {
          return;
        }

        window.gtag("event", "select_item", {
          item_list_name: categoryName,
          items: [itemFor(card, cards.indexOf(card))],
        });
      });
    });
</script>

<style>
  .modern-category {
    width: min(100% - 56px, 1380px);
    margin: 0 auto;
    padding: 155px 0 110px;
  }

  .modern-category-copy {
    max-width: 920px;
    margin-bottom: 55px;
  }

  .modern-category-copy > span {
    color: var(--gold-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.8px;
    text-transform: uppercase;
  }

  .modern-category h1 {
    margin: 22px 0 26px;
    color: #ffffff;
    font-size: clamp(50px, 7vw, 92px);
    line-height: 0.98;
  }

  .modern-category-copy p {
    max-width: 760px;
    color: #ddd3c5;
    font-size: 18px;
    line-height: 1.75;
  }

  .modern-category-lead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
    margin: -18px 0 34px;
    padding: 26px 28px;
    border: 1px solid rgba(198, 168, 93, 0.42);
    background:
      linear-gradient(
        110deg,
        rgba(198, 168, 93, 0.13),
        rgba(12, 12, 12, 0.94) 58%
      );
  }

  .modern-category-lead > div {
    max-width: 740px;
  }

  .modern-category-lead span {
    display: block;
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  .modern-category-lead strong {
    display: block;
    margin: 8px 0 7px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(24px, 3.2vw, 36px);
    font-weight: 400;
    line-height: 1.08;
  }

  .modern-category-lead p {
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 13px;
    line-height: 1.65;
  }

  .modern-category-lead > a {
    flex: 0 0 auto;
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid #1aa65b;
    background: #178c4e;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .modern-category-lead > a:hover {
    background: #1aa65b;
    transform: translateY(-2px);
  }

  .modern-category-lead > a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .modern-product-grid {
    display: grid;
    gap: 24px;
  }

  .modern-product-card {
    display: grid;
    grid-template-columns:
      minmax(0, 1.65fr)
      minmax(300px, 0.7fr);
    overflow: hidden;
    border: 1px solid rgba(201, 164, 93, 0.34);
    background: #18130f;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .modern-product-card:hover {
    border-color: rgba(201, 164, 93, 0.68);
    transform: translateY(-4px);
  }

  .modern-product-image {
    position: relative;
    min-height: 560px;
    overflow: hidden;
  }

  .modern-product-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(8, 6, 5, 0.03),
        rgba(8, 6, 5, 0.42)
      );
  }

  .modern-product-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.55s ease;
  }

  .modern-product-card:hover img {
    transform: scale(1.02);
  }

  .modern-product-image > span {
    position: absolute;
    z-index: 1;
    right: 22px;
    bottom: 18px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 10px;
    letter-spacing: 2.3px;
  }

  .modern-product-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 5vw, 70px);
  }

  .modern-product-copy small {
    color: var(--gold-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.2px;
    text-transform: uppercase;
  }

  .modern-product-copy h2 {
    margin: 20px 0 30px;
    color: #ffffff;
    font-size: clamp(36px, 4vw, 58px);
    line-height: 1.03;
  }

  .modern-product-copy p {
    display: grid;
    gap: 8px;
    margin: 0 0 38px;
    color: #bdb1a4;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .modern-product-copy p strong {
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 29px;
    font-weight: 400;
    letter-spacing: 0;
  }

  .modern-product-copy > span {
    color: var(--gold-light);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .modern-category-visual {
    position: relative;
    max-height: 580px;
    overflow: hidden;
    border: 1px solid rgba(201, 164, 93, 0.27);
  }

  .modern-category-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(8, 6, 5, 0.08),
        rgba(8, 6, 5, 0.62)
      );
  }

  .modern-category-visual img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    display: block;
    object-fit: cover;
    filter: saturate(0.7);
  }

  .modern-category-visual > span {
    position: absolute;
    z-index: 1;
    right: 28px;
    bottom: 20px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    letter-spacing: 4px;
  }

  .modern-empty-state {
    display: grid;
    grid-template-columns: minmax(110px, 0.25fr) 1fr;
    gap: clamp(24px, 5vw, 80px);
    margin-top: 20px;
    padding: clamp(34px, 6vw, 72px);
    border: 1px solid rgba(201, 164, 93, 0.27);
    background: #18130f;
  }

  .modern-empty-state > span {
    color: var(--gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(64px, 9vw, 118px);
    line-height: 0.82;
  }

  .modern-empty-state h2 {
    margin: 0 0 18px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 48px);
  }

  .modern-empty-state p {
    max-width: 720px;
    color: #d4cabe;
    font-size: 15px;
    line-height: 1.75;
  }

  .modern-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 32px;
    margin-top: 30px;
  }

  .modern-empty-actions a {
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .modern-category {
      width: min(100% - 30px, 1380px);
      padding: 125px 0 80px;
    }

    .modern-empty-state {
      grid-template-columns: 1fr;
    }

    .modern-product-card {
      grid-template-columns: 1fr;
    }

    .modern-category-lead {
      align-items: stretch;
      flex-direction: column;
      gap: 22px;
      margin-top: -24px;
      padding: 22px 20px;
    }

    .modern-category-lead > a {
      width: 100%;
    }

    .modern-product-image {
      min-height: 320px;
      aspect-ratio: 4 / 3;
    }

    .modern-category-visual img {
      min-height: 260px;
    }
  }
</style>
