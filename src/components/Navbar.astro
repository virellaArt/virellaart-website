---
import {
  getLanguageFromPath,
  getTranslations,
  languageCodes,
  languages,
  localizedPath,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);

const manufacturingLabels: Record<
  (typeof languageCodes)[number],
  string
> = {
  en: "Manufacturing",
  tr: "Üretim",
  de: "Produktion",
  fr: "Fabrication",
  it: "Produzione",
  ru: "Производство",
  ar: "التصنيع",
  bg: "Производство",
  ro: "Producție",
  el: "Παραγωγή",
  es: "Fabricación",
  sr: "Proizvodnja",
  kk: "Өндіріс",
  uz: "Ishlab chiqarish",
  pt: "Produção",
  pl: "Produkcja",
};
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href={localizedPath("/", language)} class="logo">
      VIRELLAART
    </a>

    <ul class="menu">
      <li>
        <a href={localizedPath("/", language)}>
          {translations.nav.home}
        </a>
      </li>

      <li>
        <a href={`${localizedPath("/", language)}#collections`}>
          {translations.nav.collections}
        </a>
      </li>

      <li>
        <a href={localizedPath("/about", language)}>
          {translations.nav.about}
        </a>
      </li>

      <li>
        <a href={localizedPath("/manufacturing", language)}>
          {manufacturingLabels[language]}
        </a>
      </li>

      <li>
        <a href={localizedPath("/contact", language)}>
          {translations.nav.contact}
        </a>
      </li>
    </ul>

    <details class="language-picker">
      <summary aria-label={translations.nav.language}>
        {languages[language].short}
      </summary>

      <div class="language-menu">
        {
          languageCodes.map((code) => (
            <a
              href={localizedPath(Astro.url.pathname, code)}
              lang={code}
              dir={languages[code].dir}
              data-language={code}
              aria-current={code === language ? "page" : undefined}
            >
              <span>{languages[code].short}</span>
              {languages[code].label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(7, 7, 7, 0.58);
    backdrop-filter: blur(16px);
  }

  .navbar-inner {
    width: min(100% - 48px, 1600px);
    height: 88px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    flex-shrink: 0;
    color: #ffffff;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 5px;
  }

  .menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu li {
    flex-shrink: 0;
  }

  .menu a {
    position: relative;
    color: rgba(255, 255, 255, 0.88);
    font-size: 11px;
    letter-spacing: 1.7px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .menu a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -9px;
    width: 0;
    height: 1px;
    background: var(--gold);
    transition: width 0.3s ease;
  }

  .menu a:hover {
    color: var(--gold);
  }

  .menu a:hover::after {
    width: 100%;
  }

  .language-picker {
    position: relative;
    flex-shrink: 0;
  }

  .language-picker summary {
    min-width: 48px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 2px;
    list-style: none;
    text-align: center;
    cursor: pointer;
    transition: 0.3s ease;
  }

  .language-picker summary::-webkit-details-marker {
    display: none;
  }

  .language-picker summary:hover,
  .language-picker[open] summary {
    border-color: var(--gold);
    color: var(--gold);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 205px;
    max-height: min(70vh, 430px);
    overflow-y: auto;
    border: 1px solid rgba(200, 169, 106, 0.38);
    background: rgba(10, 9, 8, 0.98);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  :global(html[dir="rtl"]) .language-menu {
    right: auto;
    left: 0;
  }

  .language-menu a {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    letter-spacing: 0.5px;
    transition: 0.25s ease;
  }

  .language-menu a:last-child {
    border-bottom: 0;
  }

  .language-menu a:hover,
  .language-menu a[aria-current="page"] {
    background: rgba(200, 169, 106, 0.12);
    color: var(--gold);
  }

  .language-menu span {
    min-width: 27px;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  @media (max-width: 1120px) {
    .navbar-inner {
      width: min(100% - 36px, 1600px);
    }

    .menu {
      gap: 21px;
    }

    .menu a {
      font-size: 10px;
      letter-spacing: 1.2px;
    }

    .logo {
      font-size: 19px;
      letter-spacing: 4px;
    }
  }

  @media (max-width: 860px) {
    .menu {
      gap: 14px;
    }

    .menu a {
      font-size: 9px;
      letter-spacing: 0.8px;
    }
  }

  @media (max-width: 760px) {
    .navbar-inner {
      width: min(100% - 28px, 1600px);
      height: 76px;
    }

    .logo {
      font-size: 17px;
      letter-spacing: 3px;
    }

    .menu {
      display: none;
    }

    .language-picker summary {
      min-width: 44px;
      padding: 9px;
    }

    .language-menu {
      width: 190px;
    }
  }
</style>