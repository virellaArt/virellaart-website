---
import {
  getLanguageFromPath,
  getTranslations,
  languageCodes,
  languages,
  localizedPath,
} from "../i18n/config";
import { collectionMenuCopy } from "../i18n/collection-menu";
import { indexableModernCategoryRoutes } from "../i18n/routes";

interface Props {
  languageLinks?: Partial<
    Record<(typeof languageCodes)[number], string>
  >;
}

const { languageLinks } = Astro.props;
const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const collectionCopy = collectionMenuCopy[language];

const collectionMenuCategories = [
  {
    number: "01",
    label: collectionCopy.sofaSets,
    luxuryPath: "/living-rooms",
    modernPath: "/collections/modern/sofa-sets",
  },
  {
    number: "02",
    label: translations.home.diningRooms,
    luxuryPath: "/dining-rooms",
    modernPath: "/collections/modern/dining-rooms",
  },
  {
    number: "03",
    label: translations.home.bedrooms,
    luxuryPath: "/bedrooms",
    modernPath: "/collections/modern/bedrooms",
  },
  {
    number: "04",
    label: translations.home.tvUnits,
    luxuryPath: "/tv-units",
    modernPath: "/collections/modern/tv-units",
  },
] as const;

const modernCollectionMenuCategories =
  collectionMenuCategories.filter((category) =>
    indexableModernCategoryRoutes.some(
      (route) =>
        `/${route}` === category.modernPath,
    ),
  );

const mobileNavigationLabels: Record<
  (typeof languageCodes)[number],
  { menu: string; close: string }
> = {
  en: { menu: "MENU", close: "CLOSE" },
  tr: { menu: "MENÜ", close: "KAPAT" },
  de: { menu: "MENÜ", close: "SCHLIESSEN" },
  fr: { menu: "MENU", close: "FERMER" },
  it: { menu: "MENU", close: "CHIUDI" },
  ru: { menu: "МЕНЮ", close: "ЗАКРЫТЬ" },
  ar: { menu: "القائمة", close: "إغلاق" },
  bg: { menu: "МЕНЮ", close: "ЗАТВОРИ" },
  ro: { menu: "MENIU", close: "ÎNCHIDE" },
  el: { menu: "ΜΕΝΟΥ", close: "ΚΛΕΙΣΙΜΟ" },
  es: { menu: "MENÚ", close: "CERRAR" },
  sr: { menu: "MENI", close: "ZATVORI" },
  kk: { menu: "МӘЗІР", close: "ЖАБУ" },
  uz: { menu: "MENYU", close: "YOPISH" },
  pt: { menu: "MENU", close: "FECHAR" },
  pl: { menu: "MENU", close: "ZAMKNIJ" },
};

const mobileMenuLabel =
  mobileNavigationLabels[language].menu;

const mobileCloseLabel =
  mobileNavigationLabels[language].close;

const orderProcessLabels: Record<
  (typeof languageCodes)[number],
  string
> = {
  en: "Order Process",
  tr: "Sipariş Süreci",
  de: "Bestellablauf",
  fr: "Processus de commande",
  it: "Procedura d’ordine",
  ru: "Процесс заказа",
  ar: "عملية الطلب",
  bg: "Процес на поръчка",
  ro: "Procesul comenzii",
  el: "Διαδικασία παραγγελίας",
  es: "Proceso de pedido",
  sr: "Proces poručivanja",
  kk: "Тапсырыс рәсімі",
  uz: "Buyurtma jarayoni",
  pt: "Processo de encomenda",
  pl: "Proces zamówienia",
};

const orderGuidePath =
  "/blog/how-to-order-luxury-furniture-from-istanbul";
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href={localizedPath("/", language)} class="logo">
      VIRELLAART
    </a>

    <ul class="menu">
      <li>
        <a href={localizedPath("/", language)}>
          {translations.nav.home}
        </a>
      </li>

      <li class="collection-navigation">
        <a
          class="collection-trigger"
          href={localizedPath(
            "/collections/luxury-classic",
            language,
          )}
          aria-haspopup="true"
        >
          {translations.nav.collections}
          <span aria-hidden="true">+</span>
        </a>

        <div class="collection-dropdown">
          <section class="collection-style-group">
            <a
              class="collection-style-link"
              href={localizedPath(
                "/collections/luxury-classic",
                language,
              )}
            >
              <strong>{collectionCopy.luxuryClassic}</strong>
              <span aria-hidden="true">›</span>
            </a>

            <div class="collection-category-links">
              {
                collectionMenuCategories.map((category) => (
                  <a
                    href={localizedPath(
                      category.luxuryPath,
                      language,
                    )}
                  >
                    <span>{category.number}</span>
                    <strong>{category.label}</strong>
                  </a>
                ))
              }
            </div>
          </section>

          <section class="collection-style-group">
            <a
              class="collection-style-link"
              href={localizedPath(
                "/collections/modern",
                language,
              )}
            >
              <strong>{collectionCopy.modern}</strong>
              <span aria-hidden="true">›</span>
            </a>

            <div class="collection-category-links">
              {
                modernCollectionMenuCategories.map((category) => (
                  <a
                    href={localizedPath(
                      category.modernPath,
                      language,
                    )}
                  >
                    <span>{category.number}</span>
                    <strong>{category.label}</strong>
                  </a>
                ))
              }
            </div>
          </section>
        </div>
      </li>

      <li>
        <a href={localizedPath("/about", language)}>
          {translations.nav.about}
        </a>
      </li>

      <li>
        <a href={localizedPath(orderGuidePath, language)}>
          {orderProcessLabels[language]}
        </a>
      </li>

      <li>
        <a href={localizedPath("/blog", language)}>
          Blog
        </a>
      </li>

      <li>
        <a href={localizedPath("/contact", language)}>
          {translations.nav.contact}
        </a>
      </li>
    </ul>

    <details class="language-picker">
      <summary aria-label={translations.nav.language}>
        {languages[language].short}
      </summary>

      <div class="language-menu">
        {
          languageCodes.map((code) => (
            <a
              href={
                languageLinks?.[code] ??
                localizedPath(Astro.url.pathname, code)
              }
              lang={code}
              dir={languages[code].dir}
              data-language={code}
              aria-current={code === language ? "page" : undefined}
            >
              <span>{languages[code].short}</span>
              {languages[code].label}
            </a>
          ))
        }
      </div>
    </details>

    <details class="mobile-navigation">
      <summary
        aria-label={mobileMenuLabel}
        title={mobileMenuLabel}
      >
        <span class="mobile-menu-label">
          <span class="mobile-menu-label-open">
            {mobileMenuLabel}
          </span>

          <span class="mobile-menu-label-close">
            {mobileCloseLabel}
          </span>
        </span>

        <span class="mobile-menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </summary>

      <button
        type="button"
        class="mobile-menu-backdrop"
        aria-label={mobileCloseLabel}
      ></button>

      <div class="mobile-panel">
        <div class="mobile-panel-brand">
          <strong>VIRELLAART</strong>
          <span>{translations.home.eyebrow}</span>
        </div>

        <div class="mobile-section">
          <p class="mobile-section-title">
            {translations.nav.collections}
          </p>

          <div class="mobile-collection-groups">
            <details class="mobile-collection-style" open>
              <summary>
                <strong>{collectionCopy.luxuryClassic}</strong>
                <span aria-hidden="true">›</span>
              </summary>

              <div class="mobile-style-categories">
                {
                  collectionMenuCategories.map((category) => (
                    <a
                      href={localizedPath(
                        category.luxuryPath,
                        language,
                      )}
                    >
                      <span>{category.number}</span>
                      <strong>{category.label}</strong>
                      <i aria-hidden="true">→</i>
                    </a>
                  ))
                }
              </div>
            </details>

            <details class="mobile-collection-style">
              <summary>
                <strong>{collectionCopy.modern}</strong>
                <span aria-hidden="true">›</span>
              </summary>

              <div class="mobile-style-categories">
                {
                  modernCollectionMenuCategories.map((category) => (
                    <a
                      href={localizedPath(
                        category.modernPath,
                        language,
                      )}
                    >
                      <span>{category.number}</span>
                      <strong>{category.label}</strong>
                      <i aria-hidden="true">→</i>
                    </a>
                  ))
                }
              </div>
            </details>
          </div>
        </div>

        <div class="mobile-section">
          <p class="mobile-section-title">
            VIRELLAART
          </p>

          <div class="mobile-company-links">
            <a href={localizedPath("/", language)}>
              {translations.nav.home}
            </a>

            <a href={localizedPath("/about", language)}>
              {translations.nav.about}
            </a>

            <a href={localizedPath(orderGuidePath, language)}>
              {orderProcessLabels[language]}
            </a>

            <a href={localizedPath("/blog", language)}>
              Blog
            </a>

            <a href={localizedPath("/contact", language)}>
              {translations.nav.contact}
            </a>
          </div>
        </div>

        <div class="mobile-section">
          <p class="mobile-section-title">
            {translations.nav.language}
          </p>

          <div class="mobile-language-grid">
            {
              languageCodes.map((code) => (
                <a
                  href={
                    languageLinks?.[code] ??
                    localizedPath(Astro.url.pathname, code)
                  }
                  lang={code}
                  dir={languages[code].dir}
                  data-language={code}
                  aria-current={code === language ? "page" : undefined}
                >
                  <span>{languages[code].short}</span>
                  <small>{languages[code].label}</small>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </details>
  </div>
</nav>


<script is:inline>
  (() => {
    const navigation =
      document.querySelector(".mobile-navigation");

    if (!(navigation instanceof HTMLDetailsElement)) {
      return;
    }

    const backdrop =
      navigation.querySelector(".mobile-menu-backdrop");

    const closeMenu = () => {
      navigation.open = false;
    };

    const updatePageLock = () => {
      document.documentElement.classList.toggle(
        "mobile-menu-open",
        navigation.open,
      );
    };

    navigation.addEventListener(
      "toggle",
      updatePageLock,
    );

    navigation
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

    backdrop?.addEventListener(
      "click",
      closeMenu,
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          closeMenu();
        }
      },
    );

    window.addEventListener(
      "resize",
      () => {
        if (window.innerWidth > 760) {
          closeMenu();
        }
      },
    );
  })();
</script>

<style>
  .navbar {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(7, 7, 7, 0.58);
    backdrop-filter: blur(16px);
  }

  .navbar-inner {
    width: min(100% - 48px, 1600px);
    height: 88px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    flex-shrink: 0;
    color: #ffffff;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 5px;
  }

  .menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu > li {
    flex-shrink: 0;
  }

  .menu > li > a {
    position: relative;
    color: rgba(255, 255, 255, 0.88);
    font-size: 11px;
    letter-spacing: 1.7px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .menu > li > a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -9px;
    width: 0;
    height: 1px;
    background: var(--gold);
    transition: width 0.3s ease;
  }

  .menu > li > a:hover {
    color: var(--gold);
  }

  .menu > li > a:hover::after {
    width: 100%;
  }

  .collection-navigation {
    position: relative;
  }

  .collection-trigger {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .collection-trigger > span {
    color: var(--gold-light);
    font-size: 14px;
    font-weight: 300;
    line-height: 1;
  }

  .collection-dropdown {
    position: absolute;
    top: calc(100% + 27px);
    left: 50%;
    width: min(440px, calc(100vw - 40px));
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding: 15px;
    border: 1px solid rgba(200, 169, 106, 0.38);
    background:
      radial-gradient(
        circle at top,
        rgba(201, 164, 93, 0.1),
        transparent 42%
      ),
      rgba(10, 9, 8, 0.985);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 8px);
    visibility: hidden;
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }

  .collection-dropdown::before {
    content: "";
    position: absolute;
    top: -28px;
    right: 0;
    left: 0;
    height: 28px;
  }

  .collection-navigation:hover
    .collection-dropdown,
  .collection-navigation:focus-within
    .collection-dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
    visibility: visible;
  }

  .collection-style-group {
    padding: 9px 15px 12px;
  }

  .collection-style-group + .collection-style-group {
    border-left: 1px solid rgba(201, 164, 93, 0.22);
  }

  :global(html[dir="rtl"])
    .collection-style-group
    + .collection-style-group {
    border-right: 1px solid rgba(201, 164, 93, 0.22);
    border-left: 0;
  }

  .collection-style-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 8px 0 14px;
    border-bottom: 1px solid rgba(201, 164, 93, 0.24);
    color: #ffffff;
  }

  .collection-style-link strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.2;
  }

  .collection-style-link span {
    color: var(--gold-light);
    font-size: 20px;
    transition: transform 180ms ease;
  }

  .collection-style-link:hover span {
    transform: translateX(3px);
  }

  :global(html[dir="rtl"])
    .collection-style-link
    span {
    transform: rotate(180deg);
  }

  :global(html[dir="rtl"])
    .collection-style-link:hover
    span {
    transform: rotate(180deg) translateX(3px);
  }

  .collection-category-links {
    display: grid;
    padding-top: 7px;
  }

  .collection-category-links a {
    display: grid;
    grid-template-columns: 25px 1fr;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    color: rgba(255, 255, 255, 0.76);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .collection-category-links a:hover {
    color: var(--gold-light);
    transform: translateX(3px);
  }

  :global(html[dir="rtl"])
    .collection-category-links
    a:hover {
    transform: translateX(-3px);
  }

  .collection-category-links span {
    color: var(--gold);
    font-size: 8px;
    letter-spacing: 1px;
  }

  .collection-category-links strong {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.8px;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .language-picker {
    position: relative;
    flex-shrink: 0;
  }

  .language-picker summary {
    min-width: 48px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
    font-size: 11px;
    letter-spacing: 2px;
    list-style: none;
    text-align: center;
    cursor: pointer;
    transition: 0.3s ease;
  }

  .language-picker summary::-webkit-details-marker {
    display: none;
  }

  .language-picker summary:hover,
  .language-picker[open] summary {
    border-color: var(--gold);
    color: var(--gold);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 205px;
    max-height: min(70vh, 430px);
    overflow-y: auto;
    border: 1px solid rgba(200, 169, 106, 0.38);
    background: rgba(10, 9, 8, 0.98);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  :global(html[dir="rtl"]) .language-menu {
    right: auto;
    left: 0;
  }

  .language-menu a {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.82);
    font-size: 12px;
    letter-spacing: 0.5px;
    transition: 0.25s ease;
  }

  .language-menu a:last-child {
    border-bottom: 0;
  }

  .language-menu a:hover,
  .language-menu a[aria-current="page"] {
    background: rgba(200, 169, 106, 0.12);
    color: var(--gold);
  }

  .language-menu span {
    min-width: 27px;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 1.5px;
  }

  @media (max-width: 1120px) {
    .navbar-inner {
      width: min(100% - 36px, 1600px);
    }

    .menu {
      gap: 21px;
    }

    .menu > li > a {
      font-size: 10px;
      letter-spacing: 1.2px;
    }

    .logo {
      font-size: 19px;
      letter-spacing: 4px;
    }
  }

  @media (max-width: 860px) {
    .menu {
      gap: 14px;
    }

    .menu > li > a {
      font-size: 9px;
      letter-spacing: 0.8px;
    }
  }

  @media (max-width: 760px) {
    .navbar-inner {
      width: min(100% - 28px, 1600px);
      height: 76px;
    }

    .logo {
      font-size: 17px;
      letter-spacing: 3px;
    }

    .menu {
      display: none;
    }

    .language-picker summary {
      min-width: 44px;
      padding: 9px;
    }

    .language-menu {
      width: 190px;
    }
  }

  /* VIRELLAART PREMIUM MOBILE NAVIGATION */

  .mobile-navigation {
    display: none;
  }

  :global(html.mobile-menu-open),
  :global(html.mobile-menu-open body) {
    overflow: hidden;
  }

  @media (max-width: 760px) {
    .navbar {
      border-bottom:
        1px solid
        rgba(201, 164, 93, 0.38);
      background:
        rgba(14, 10, 8, 0.92);
      box-shadow:
        0 12px 35px
        rgba(0, 0, 0, 0.22);
      backdrop-filter: blur(18px);
    }

    .navbar-inner {
      width: calc(100% - 28px);
      height: 68px;
      gap: 15px;
    }

    .logo {
      position: relative;
      z-index: 4;
      font-size: 16px;
      letter-spacing: 3.4px;
    }

    .menu,
    .language-picker {
      display: none;
    }

    .mobile-navigation {
      position: relative;
      z-index: 3;
      display: block;
      flex-shrink: 0;
    }

    .mobile-navigation > summary {
      position: relative;
      z-index: 4;
      min-width: 110px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 13px;
      padding: 0 14px;
      border:
        1px solid
        rgba(201, 164, 93, 0.36);
      background:
        rgba(201, 164, 93, 0.04);
      color: #ffffff;
      list-style: none;
      cursor: pointer;
    }

    .mobile-navigation > summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu-label {
      min-width: 47px;
      color: var(--gold-light);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 1.8px;
      line-height: 1;
      text-align: center;
    }

    .mobile-menu-label-close {
      display: none;
    }

    .mobile-navigation[open]
      .mobile-menu-label-open {
      display: none;
    }

    .mobile-navigation[open]
      .mobile-menu-label-close {
      display: inline;
    }

    .mobile-menu-icon {
      position: relative;
      width: 20px;
      height: 14px;
      display: block;
    }

    .mobile-menu-icon i {
      position: absolute;
      left: 0;
      width: 20px;
      height: 1px;
      display: block;
      background: #ffffff;
      transition:
        top 220ms ease,
        transform 220ms ease;
    }

    .mobile-menu-icon i:first-child {
      top: 3px;
    }

    .mobile-menu-icon i:last-child {
      top: 10px;
    }

    .mobile-navigation[open]
      .mobile-menu-icon
      i:first-child {
      top: 7px;
      transform: rotate(45deg);
    }

    .mobile-navigation[open]
      .mobile-menu-icon
      i:last-child {
      top: 7px;
      transform: rotate(-45deg);
    }

    .mobile-menu-backdrop {
      position: fixed;
      z-index: 1;
      inset: 68px 0 0;
      width: 100%;
      height: calc(100dvh - 68px);
      padding: 0;
      border: 0;
      background:
        rgba(0, 0, 0, 0.68);
      backdrop-filter: blur(3px);
    }

    .mobile-panel {
      position: fixed;
      z-index: 2;
      top: 68px;
      right: 0;
      width: min(92vw, 430px);
      height: calc(100dvh - 68px);
      overflow-y: auto;
      padding:
        27px
        20px
        calc(
          34px +
          env(safe-area-inset-bottom)
        );
      border-left:
        1px solid
        rgba(201, 164, 93, 0.34);
      background:
        radial-gradient(
          circle at top right,
          rgba(201, 164, 93, 0.11),
          transparent 34%
        ),
        linear-gradient(
          155deg,
          #1a120e 0%,
          #0c0806 72%
        );
      box-shadow:
        -24px 0 70px
        rgba(0, 0, 0, 0.48);
      overscroll-behavior: contain;
      animation:
        mobileMenuEnter
        240ms ease both;
    }

    :global(html[dir="rtl"]) .mobile-panel {
      right: auto;
      left: 0;
      border-right:
        1px solid
        rgba(201, 164, 93, 0.34);
      border-left: 0;
    }

    .mobile-navigation:not([open])
      .mobile-menu-backdrop,
    .mobile-navigation:not([open])
      .mobile-panel {
