---
import {
  getLanguageFromPath,
  getTranslations,
  localizedPath,
  translateProductName,
} from "../i18n/config";

interface Model {
  name: string;
  href: string;
  image: string;
}

interface Props {
  categoryName: string;
  description: string;
  models: Model[];
}

const {
  categoryName,
  description,
  models,
} = Astro.props;

const language =
  getLanguageFromPath(Astro.url.pathname);

const translations =
  getTranslations(language);

const siteURL =
  "https://www.virellaart.com";

function normalizePath(value: string): string {
  return value.replace(/\/?$/, "/");
}

const canonicalPath =
  normalizePath(Astro.url.pathname);

const canonicalURL =
  new URL(
    canonicalPath,
    siteURL,
  ).href;

const homeURL =
  new URL(
    normalizePath(
      localizedPath("/", language),
    ),
    siteURL,
  ).href;

const collectionID =
  `${canonicalURL}#collection`;

const itemListID =
  `${canonicalURL}#item-list`;

const breadcrumbID =
  `${canonicalURL}#breadcrumb`;

const itemListElement =
  models.map((model, index) => {
    const itemURL =
      new URL(
        normalizePath(
          localizedPath(
            model.href,
            language,
          ),
        ),
        siteURL,
      ).href;

    const imageURL =
      new URL(
        model.image,
        siteURL,
      ).href;

    return {
      "@type": "ListItem",
      position: index + 1,

      item: {
        "@type": "WebPage",
        "@id": itemURL,
        url: itemURL,

        name:
          translateProductName(
            model.name,
            language,
          ),

        image: imageURL,
      },
    };
  });

const schema = {
  "@context": "https://schema.org",

  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": collectionID,

      url: canonicalURL,
      name: categoryName,
      description,
      inLanguage: language,

      isPartOf: {
        "@id":
          "https://www.virellaart.com/#website",
      },

      mainEntity: {
        "@id": itemListID,
      },
    },

    {
      "@type": "ItemList",
      "@id": itemListID,

      name: categoryName,
      numberOfItems: models.length,

      itemListOrder:
        "https://schema.org/ItemListOrderAscending",

      itemListElement,
    },

    {
      "@type": "BreadcrumbList",
      "@id": breadcrumbID,

      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: translations.nav.home,
          item: homeURL,
        },

        {
          "@type": "ListItem",
          position: 2,
          name: categoryName,
          item: canonicalURL,
        },
      ],
    },
  ],
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
