---
import {
  getLanguageFromPath,
  getTranslations,
  localizedPath,
  translateProductName,
} from "../i18n/config";

interface Model {
  name: string;
  href: string;
  image: string;
}

interface Props {
  categoryName: string;
  description: string;
  models: Model[];
}

const {
  categoryName,
  description,
  models,
} = Astro.props;
const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const canonicalURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com",
).href;
const homeURL = new URL(
  localizedPath("/", language),
  "https://www.virellaart.com",
).href;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalURL}#collection`,
      "url": canonicalURL,
      "name": categoryName,
      "description": description,
      "inLanguage": language,
      "isPartOf": {
        "@id": "https://www.virellaart.com/#website",
      },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": models.length,
        "itemListElement": models.map((model, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": new URL(
            localizedPath(model.href, language),
            "https://www.virellaart.com",
          ).href,
          "name": translateProductName(model.name, language),
          "image": new URL(
            model.image,
            "https://www.virellaart.com",
          ).href,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": translations.nav.home,
          "item": homeURL,
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": categoryName,
          "item": canonicalURL,
        },
      ],
    },
  ],
};
---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema)}
/>
