---

<BaseLayout
  title={translatedProductName}
  description={pageDescription}
  image={images[0]}
  imageAlt={translatedProductName}
  pageType="product"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <script is:inline define:vars={{ productEvent }}>
    if (typeof window.gtag === "function") {
      window.gtag("event", "view_item", productEvent);
    }
  </script>

