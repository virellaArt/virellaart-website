    /* LIGHTBOX */

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 28px 100px;
      overflow: hidden;
      overscroll-behavior: contain;
      background: rgba(0, 0, 0, 0.96);
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox-stage {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
    }

    .lightbox-stage img {
      display: block;
      max-width: 85vw;
      max-height: 85vh;
      width: auto;
      height: auto;
      object-fit: contain;
      user-select: none;
      -webkit-user-drag: none;
    }

    .lightbox-close,
    .lightbox-arrow {
      position: absolute;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 1px solid rgba(201, 165, 91, 0.8);
      background: rgba(17, 17, 17, 0.82);
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1;
      cursor: pointer;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .lightbox-close:hover,
    .lightbox-arrow:hover {
      border-color: #d8b66d;
      background: rgba(38, 31, 24, 0.96);
    }

    .lightbox-close:focus-visible,
    .lightbox-arrow:focus-visible {
      outline: 2px solid #e1bd73;
      outline-offset: 3px;
    }

    .lightbox-close {
      top: 24px;
      right: 24px;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      font-size: 32px;
    }

    .lightbox-close span {
      display: block;
      line-height: 1;
      transform: translateY(-1px);
    }

    .lightbox-arrow {
      top: 50%;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      font-size: 38px;
      transform: translateY(-50%);
    }

    .lightbox-arrow.left {
      left: 24px;
    }

    .lightbox-arrow.right {
      right: 24px;
    }

    .lightbox-arrow span {
      display: block;
      line-height: 1;
      transform: translateY(-2px);
    }

    .lightbox-counter {
      position: absolute;
      bottom: 22px;
      left: 50%;
      z-index: 2;
      min-width: 58px;
      padding: 7px 12px;
      border: 1px solid rgba(201, 165, 91, 0.45);
      border-radius: 999px;
      background: rgba(17, 17, 17, 0.72);
      color: rgba(255, 255, 255, 0.86);
      font-size: 12px;
      letter-spacing: 1px;
      text-align: center;
      transform: translateX(-50%);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

