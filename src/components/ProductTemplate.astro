const diningItemsWithoutShowcase: IncludedItemKey[] = [
  "diningTable",
  "chairs",
  "console",
  "mirror",
];

const diningItemsWithShowcase: IncludedItemKey[] = [
  ...diningItemsWithoutShowcase,
  "showcase",
];

const bedroomIncludedItems: IncludedItemKey[] = [
  "bed",
  "nightstands",
  "wardrobe",
  "dresser",
  "mirror",
];

const diningProductsWithoutShowcase =
  new Set<string>([
  "Delux Dining Room",
  "Aspendos Dining Room",
  "Queen Dining Room",
  "Moon Dining Room",
  "Vanessa Dining Room",
  "Shawl Dining Room",
  "Valdera Dining Room",
  "Lina Dining Room",
  "Zerafet Dining Room",
  "Valencia Dining Room"
]);

const diningProductsWithShowcase =
  new Set<string>([
  "Sultan Green Dining Room Set",
  "Saltanat Green Dining Room",
  "Saltanat Dining Room",
  "Milano Blue Dining Room",
  "Milano Dining Room",
  "Zümrüt Dining Room"
]);

const includedItemKeys: IncludedItemKey[] =
  product.category === "dining-rooms"
    ? diningProductsWithShowcase.has(product.name)
      ? diningItemsWithShowcase
      : diningProductsWithoutShowcase.has(product.name)
        ? diningItemsWithoutShowcase
        : []
    : product.category === "bedrooms"
      ? bedroomIncludedItems
      : [];

const includedPrice =
  includedPriceContent[language] ??
  includedPriceContent.en;

/* =========================
   SEO DATA
========================= */

const baseProductDescription =
  getProductDescription(product, language);
const modernSeoProductName =
  `${collectionCopy.modern} ${translatedProductName}`;
const productDescription =
  productStyle === "modern" && language !== "en"
    ? baseProductDescription.includes(
        translatedProductName,
      )
      ? baseProductDescription.replace(
          translatedProductName,
          modernSeoProductName,
        )
      : `${modernSeoProductName}. ${baseProductDescription}`
    : baseProductDescription;

const pageDescription =
  getSeoDescription(
    productDescription,
    language,
  );
const defaultPageTitle =
  productStyle === "modern"
    ? `${translatedProductName} | ${collectionCopy.modern} ${categoryName}`
    : `${translatedProductName} | ${categoryName}`;

const englishProductSeoTitleByPath: Record<string, string> = {
  "/tv-units/aspendos/": "Aspendos Luxury TV Unit",
  "/tv-units/delux/": "Deluxe Luxury TV Unit",
  "/bedrooms/sultan-green/": "Sultan Green Luxury Bedroom Set",
  "/bedrooms/valencia/": "Valencia Luxury Bedroom Set",
  "/bedrooms/sultan/": "Sultan Luxury Bedroom Set",
  "/bedrooms/marsilya/": "Marsilya Luxury Bedroom Set",
  "/bedrooms/marsilya/": "Marsilya Luxury Bedroom Set",
  "/bedrooms/marsilya/": "Marsilya Luxury Bedroom Set",
};

const normalizedProductSeoPath =
  Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;

const englishProductSeoTitle =
  language === "en"
    ? englishProductSeoTitleByPath[
        normalizedProductSeoPath
      ] ?? null
    : null;

const pageTitle =
  englishProductSeoTitle ??
  defaultPageTitle;
const canonicalURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com",
).href;

const productID = product.name
  .toLowerCase()
  .replaceAll(" ", "-");

const primaryPrice =
  Number(
    prices[0]?.price
      .replace("$", "")
      .replace(",", ""),
  ) || 0;

/* =========================
   PRODUCT SCHEMA
========================= */

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: translatedProductName,
  "@id": `${canonicalURL}#product`,
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
  sku: productID,
  category:
    productStyle === "modern"
      ? `${collectionCopy.modern} / ${categoryName}`
      : categoryName,
  description: productDescription,
  inLanguage: language,

  brand: {
    "@type": "Brand",
    name: "VIRELLAART",
  },

  image: images.map(
    (image) => `https://www.virellaart.com${image}`,
  ),

  offers: {
    "@type": "Offer",
    url: canonicalURL,
    priceCurrency: "USD",
    price: primaryPrice,
    itemCondition: "https://schema.org/NewCondition",
    availability: productAvailability,

    seller: {
      "@id": "https://www.virellaart.com/#organization",
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: translations.nav.home,
      item: new URL(
        localizedPath("/", language),
        "https://www.virellaart.com",
      ).href,
    },
    {
