---
const { product } = Astro.props;

const images: string[] = product.images ?? [];

const prices: {
  label: string;
  price: string;
  featured?: boolean;
}[] = product.prices ?? [];


const whatsappNumber = "905539478608";

const whatsappMessage =
`Hello VIRELLAART, I would like to receive more information about the ${product.name} Collection.`;


const whatsappUrl =
`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
whatsappMessage
)}`;

---


<main class="product-page">


<section class="product-container">


<div class="product-layout">



<section class="gallery-section">


<button
class="main-image-button"
id="mainImageButton"
type="button"
>


<img

id="mainImage"

src={images[0]}

alt={product.name}

/>


<span class="zoom">
+
</span>


</button>




<div class="thumbnail-grid">


{

images.map((image: string, index: number)=>(

<button

class:list={[
"thumbnail-button",
index === 0 && "active"
]}

data-index={index}

type="button"

>


<img

src={image}

alt={product.name}

/>


</button>


))

}


</div>



</section>





<section class="product-information">



<p class="collection-label">

VIRELLAART LUXURY COLLECTION

</p>




<h1>

{product.name}

</h1>




<h2>

{product.subtitle}

</h2>




<div class="decorative-line"></div>





<p class="product-description">

{product.description}

</p>






<div class="price-card">


<div class="price-header">


<span>

COLLECTION PRICES

</span>


<small>

USD

</small>


</div>





{

prices.map(
(
item:{
label:string;
price:string;
featured?:boolean;
},

index:number

)=>(


<div

class:list={[

"price-row",

(index === 0 || item.featured) && "featured"

]}

>


<span>

{item.label}

</span>



<strong>

{item.price}

</strong>



</div>


)

)

}


</div>






<div class="services">


<div>


<strong>

Worldwide Delivery

</strong>


<p>

International shipping support is available worldwide.

</p>


</div>




<div>


<strong>

Premium Craftsmanship

</strong>


<p>

Made with carefully selected luxury materials.

</p>


</div>



</div>







<a

href={whatsappUrl}

class="whatsapp"

target="_blank"

rel="noopener noreferrer"

>

Contact Us on WhatsApp

</a>




<p class="note">

Contact our team for dimensions, fabric options, production and delivery information.

</p>




</section>



</div>


</section>


</main>

<div class="lightbox" id="lightbox">

<button
class="lightbox-close"
id="close"
type="button"
>
<span>&#215;</span>
</button>


<button
class="lightbox-arrow left"
id="prevImage"
type="button"
aria-label="Previous image"

>
<span>&#8249;</span>
</button>


<img
id="lightboxImage"
src={images[0]}
alt={product.name}
/>


<button
class="lightbox-arrow right"
id="nextImage"
type="button"
aria-label="Next image"
>
<span>&#8250;</span>
</button>


</div>


<script is:inline define:vars={{images}}>


let currentIndex = 0;



const mainImage =
document.querySelector("#mainImage");


const lightbox =
document.querySelector("#lightbox");


const lightboxImage =
document.querySelector("#lightboxImage");



const thumbnails =
document.querySelectorAll(".thumbnail-button");





function changeImage(index){


currentIndex = index;



if(mainImage){

mainImage.src = images[index];

}



if(lightboxImage){

lightboxImage.src = images[index];

}



thumbnails.forEach(
(item,index2)=>{


item.classList.toggle(

"active",

index === index2

);


});


}





thumbnails.forEach(
(button)=>{


button.addEventListener(
"click",

()=>{


const index = Number(
button.getAttribute("data-index")
);



changeImage(index);


}

);


});






document
.querySelector("#mainImageButton")
?.addEventListener(

"click",

()=>{


lightbox?.classList.add("open");


if(lightboxImage){

lightboxImage.src =
images[currentIndex];

}


}

);





document
.querySelector("#close")
?.addEventListener(

"click",

()=>{

lightbox?.classList.remove("open");

}

);
lightbox?.addEventListener(
"click",
(event)=>{

if(event.target === lightbox){

lightbox.classList.remove("open");

}

}
);






document
.querySelector("#nextImage")
?.addEventListener(

"click",

()=>{


changeImage(

(currentIndex + 1) % images.length

);


}

);






document
.querySelector("#prevImage")
?.addEventListener(

"click",

()=>{


changeImage(

(currentIndex - 1 + images.length) % images.length

);


}

);






document.addEventListener(

"keydown",

(event)=>{


if(event.key==="Escape"){

lightbox?.classList.remove("open");

}



if(event.key==="ArrowRight"){

changeImage(
(currentIndex + 1) % images.length
);

}



if(event.key==="ArrowLeft"){

changeImage(
(currentIndex - 1 + images.length) % images.length
);

}


}

);



</script>
<style>
.lightbox-close,



.lightbox-arrow.left{
left:30px;
}


.lightbox-arrow.right{
right:30px;
}


.lightbox-close{
top:25px;
right:25px;
font-size:32px;
}
.product-page{

min-height:100vh;

background:
radial-gradient(
circle at top right,
rgba(190,150,80,.12),
transparent 500px
),
#171411;

color:white;

padding:40px 30px 100px;

}



.product-container{

width:min(1500px,100%);

margin:auto;

}




.product-layout{

display:grid;

grid-template-columns:
1.35fr .95fr;

