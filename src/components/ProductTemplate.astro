const productTrust =
  productTrustContent[language] ??
  productTrustContent.en;

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={images[0]}
  imageAlt={resolvedImageAlts[0]}
  pageType="product"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <script is:inline define:vars={{ productEvent }}>
    const sendViewItem = () => {
      if (
        window.virellaAnalyticsAllowed !== true ||
        typeof window.gtag !== "function"
      ) {
        return;
      }

      window.gtag("event", "view_item", productEvent);
    };

    if (window.virellaAnalyticsAllowed === true) {
      sendViewItem();
    } else {
      document.addEventListener(
        "virella:analytics-ready",
        sendViewItem,
        { once: true },
      );
    }
  </script>

  <div class="product-page">
    <nav
      class="breadcrumbs"
      aria-label={galleryText.breadcrumb}
    >
      <a href={localizedPath("/", language)}>
        {translations.nav.home}
      </a>

      <span aria-hidden="true">/</span>

      <a
        href={localizedPath(
          categoryPath,
          language,
        )}
      >
        {categoryName}
      </a>

      <span aria-hidden="true">/</span>

      <span aria-current="page">
        {translatedProductName}
      </span>
    </nav>

    <section class="product-container">
      <div class="product-layout">
        <section class="gallery-section">
          <button
            class="main-image-button"
            id="mainImageButton"
            type="button"
            aria-label={fillGalleryLabel(
              galleryText.open,
              translatedProductName,
              "product",
            )}
          >
            <img
              id="mainImage"
              src={images[0]}
              alt={resolvedImageAlts[0]}
              width="1600"
              height="1200"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />

            <span class="zoom" aria-hidden="true">
              +
            </span>
          </button>

          <div class="thumbnail-grid">
            {
              images.map(
                (image: string, index: number) => (
                  <button
                    class:list={[
                      "thumbnail-button",
                      index === 0 && "active",
                    ]}
                    data-index={index}
                    type="button"
                    aria-label={fillGalleryLabel(
                      galleryText.image,
                      resolvedImageAlts[index],
                      "image",
                    )}
                  >
                    <img
                      src={image}
                      alt={resolvedImageAlts[index]}
                      width="480"
                      height="360"
                      loading="lazy"
                      fetchpriority="low"
                      decoding="async"
                    />
                  </button>
                ),
              )
            }
          </div>
        </section>

        <section class="product-information">
          <p class="collection-label">
            {productCollectionLabel}
          </p>

          <h1>{translatedProductName}</h1>

          {
            product.subtitle && (
              <h2>{product.subtitle}</h2>
            )
          }

          <div class="decorative-line"></div>

          <p class="product-description">
            {productDescription}
          </p>

          <div
            class="order-availability"
            data-order-model={productOrderModel}
          >
            <span aria-hidden="true"></span>

            <p>
              <strong>
                {madeToOrderText.label}
              </strong>

              {madeToOrderText.detail}
            </p>
          </div>

          <div class="price-card">
            <div class="price-header">
              <span>
                {translations.product.prices}
              </span>

              <small>USD</small>
            </div>

            {
              prices.map(
                (
                  item: {
                    label: string;
                    price: string;
                    featured?: boolean;
                  },
                  index: number,
                ) => {
                  const configuration =
                    translatePriceLabel(
                      item.label,
                      language,
                    );

                  const selected =
                    index === defaultPriceIndex;

                  return (
                    <button
                      class:list={[
                        "price-row",
                        "quote-option",
                        selected && "featured",
                      ]}
                      type="button"
                      data-quote-option
                      data-price-index={index}
                      data-configuration={configuration}
                      data-price={item.price}
                      aria-pressed={
                        selected
                          ? "true"
                          : "false"
                      }
                      aria-label={
                        productQuote.selectAria +
                        ": " +
                        configuration
                      }
                    >
                      <span>{configuration}</span>

                      <strong>{item.price}</strong>
                    </button>
                  );
                },
              )
            }
          </div>

          {
            includedItemKeys.length > 0 && (
              <section
                class="included-price"
                aria-labelledby="includedPriceTitle"
              >
                <h2 id="includedPriceTitle">
                  {includedPrice.title}
                </h2>

                <ul>
                  {
                    includedItemKeys.map(
                      (key: IncludedItemKey) => (
                        <li>
                          {includedPrice.items[key]}
                        </li>
                      ),
                    )
                  }
                </ul>
              </section>
            )
          }

          <section
            class="quote-builder"
            aria-labelledby="quoteBuilderTitle"
            data-quote-builder
          >
            <div class="quote-builder-heading">
              <h2 id="quoteBuilderTitle">
                {productQuote.title}
              </h2>

              <p>{productQuote.intro}</p>
            </div>

            <div
              class="quote-selection"
              aria-live="polite"
            >
              <span>{productQuote.selected}</span>

              <strong id="quoteSelectedConfiguration">
                {defaultConfiguration}
              </strong>

              <small id="quoteSelectedPrice">
                {defaultPriceValue}
              </small>
            </div>

            <div class="quote-fields">
              <label class="quote-field">
                <span>{productQuote.country}</span>

                <input
                  id="quoteCountry"
                  name="delivery-country"
                  type="text"
                  autocomplete="country-name"
                  maxlength="80"
                  placeholder={productQuote.country}
                />
              </label>

              <label class="quote-field">
                <span>{productQuote.city}</span>

                <input
                  id="quoteCity"
                  name="delivery-city"
                  type="text"
                  autocomplete="address-level2"
                  maxlength="80"
                  placeholder={productQuote.city}
                />
              </label>

              <label
                class="quote-field quote-field-wide"
              >
                <span>
                  {productQuote.customization}
                </span>

                <textarea
                  id="quoteCustomization"
                  name="customization"
                  rows="3"
                  maxlength="500"
                  placeholder={
                    productQuote.customization
                  }
                ></textarea>
              </label>
            </div>
          </section>

          <div class="services">
            <div>
              <strong>
                {
                  translations.product
                    .worldwideDelivery
                }
              </strong>

              <p>
                {
                  translations.product
                    .worldwideDeliveryText
                }
              </p>
            </div>

            <div>
              <strong>
                {translations.product.craftsmanship}
              </strong>

              <p>
                {
                  translations.product
                    .craftsmanshipText
                }
              </p>
            </div>
          </div>

          <a
            href={whatsappUrl}
            class="whatsapp js-product-quote"
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-context="product-quote"
            data-product={translatedProductName}
            data-product-category={categoryName}
            data-configuration={defaultConfiguration}
            data-price={defaultPriceValue}
            data-page-url={canonicalURL}
            data-quote-engine="product-quote-v1"
          >
            {productQuote.button}
          </a>

          <p class="note">
            {translations.product.note}
          </p>
        </section>
      </div>
    </section>


    <section
      class="product-trust"
      aria-labelledby="productTrustTitle"
    >
      <div class="product-trust-heading">
        <span>{productTrust.eyebrow}</span>

        <h2 id="productTrustTitle">
          {productTrust.title}
        </h2>

        <p>{productTrust.lead}</p>
      </div>

      <div class="product-trust-grid">
        <article class="product-trust-card">
          <span>01</span>

          <h3>{productTrust.manufacturerTitle}</h3>

          <p>{productTrust.manufacturerText}</p>
        </article>

        <article class="product-trust-card">
          <span>02</span>

          <h3>{productTrust.customizationTitle}</h3>

          <p>{productTrust.customizationText}</p>
        </article>

        <article class="product-trust-card">
          <span>03</span>

          <h3>{productTrust.processTitle}</h3>

          <p>{productTrust.processText}</p>
        </article>

        <article class="product-trust-card">
          <span>04</span>

          <h3>
            {translations.product.worldwideDelivery}
          </h3>

          <p>
            {
              translations.product
                .worldwideDeliveryText
            }
          </p>
        </article>
      </div>

      <div class="product-trust-footer">
        <p>{productTrust.note}</p>

        <div class="product-trust-actions">
          <a
            class="manufacturing-link"
            href={localizedPath(
              "/manufacturing",
              language,
            )}
          >
            {productTrust.manufacturingButton}
          </a>

          <a
            class="product-trust-whatsapp js-product-quote"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-context="product-trust-quote"
            data-product={translatedProductName}
            data-product-category={categoryName}
            data-configuration={defaultConfiguration}
            data-price={defaultPriceValue}
            data-page-url={canonicalURL}
            data-quote-engine="product-quote-v1"
          >
            {productQuote.trustButton}
          </a>
        </div>
      </div>
    </section>
  </div>

  <div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label={fillGalleryLabel(
      galleryText.dialog,
      translatedProductName,
      "product",
    )}
  >
    <button
      class="lightbox-close"
      id="close"
      type="button"
      aria-label={galleryText.close}
    >
      <span aria-hidden="true">&#215;</span>
    </button>

    {
      images.length > 1 && (
        <button
          class="lightbox-arrow left"
          id="prevImage"
          type="button"
          aria-label={
            translations.product.previousImage
          }
        >
          <span aria-hidden="true">&#8249;</span>
        </button>
      )
    }

    <div class="lightbox-stage" id="lightboxStage">
      <img
        id="lightboxImage"
        src={images[0]}
        alt={resolvedImageAlts[0]}
        width="1600"
        height="1200"
      />
    </div>

    {
      images.length > 1 && (
        <>
          <div
            class="lightbox-counter"
            id="lightboxCounter"
            aria-live="polite"
          >
            1 / {images.length}
          </div>

          <button
            class="lightbox-arrow right"
            id="nextImage"
            type="button"
            aria-label={
              translations.product.nextImage
            }
          >
            <span aria-hidden="true">&#8250;</span>
          </button>
        </>
      )
    }
  </div>

  <script
    is:inline
    define:vars={{
      quoteMessageTemplate,
      whatsappNumber,
      translatedProductName,
      categoryName,
      canonicalURL,
      language,
      defaultConfiguration,
      defaultPriceValue,
    }}
  >
    (() => {
      const optionButtons = Array.from(
        document.querySelectorAll(
          "[data-quote-option]",
        ),
      ).filter(
        (item) =>
          item instanceof HTMLButtonElement,
      );

      const quoteLinks = Array.from(
        document.querySelectorAll(
          ".js-product-quote",
        ),
      ).filter(
        (item) =>
          item instanceof HTMLAnchorElement,
      );

      const countryInput =
        document.querySelector("#quoteCountry");

      const cityInput =
        document.querySelector("#quoteCity");

      const customizationInput =
        document.querySelector(
          "#quoteCustomization",
        );

      const selectedConfigurationElement =
        document.querySelector(
          "#quoteSelectedConfiguration",
        );

      const selectedPriceElement =
        document.querySelector(
          "#quoteSelectedPrice",
        );

      let selectedConfiguration =
        defaultConfiguration;

      let selectedPrice =
        defaultPriceValue;

      function fieldValue(element) {
        if (
          element instanceof HTMLInputElement ||
          element instanceof HTMLTextAreaElement
        ) {
          return element.value.trim();
        }

        return "";
      }

      function fillTemplate(values) {
        return Object.entries(values).reduce(
          (message, [key, value]) =>
            message.replaceAll(
              "{" + key + "}",
              value,
            ),
          quoteMessageTemplate,
        );
      }

      function buildMessage() {
        return fillTemplate({
          configuration:
            selectedConfiguration,
          price: selectedPrice,
          country: fieldValue(countryInput),
          city: fieldValue(cityInput),
          customization:
            fieldValue(customizationInput),
          url: canonicalURL,
        });
      }

      function updateQuoteLinks() {
        const message = buildMessage();

        const href =
          "https://wa.me/" +
          whatsappNumber +
          "?text=" +
          encodeURIComponent(message);

        quoteLinks.forEach((link) => {
          link.href = href;
          link.dataset.product =
            translatedProductName;
          link.dataset.productCategory =
            categoryName;
          link.dataset.configuration =
            selectedConfiguration;
          link.dataset.price =
            selectedPrice;
          link.dataset.pageUrl =
            canonicalURL;
          link.dataset.quoteEngine =
            "product-quote-v1";
        });
      }

      function selectOption(button) {
        optionButtons.forEach((option) => {
          const selected =
            option === button;

          option.classList.toggle(
            "featured",
            selected,
          );

          option.setAttribute(
            "aria-pressed",
            selected ? "true" : "false",
          );
        });

        selectedConfiguration =
          button.dataset.configuration ||
          defaultConfiguration;

        selectedPrice =
          button.dataset.price ||
          defaultPriceValue;

        if (selectedConfigurationElement) {
          selectedConfigurationElement.textContent =
            selectedConfiguration;
        }

        if (selectedPriceElement) {
          selectedPriceElement.textContent =
            selectedPrice;
        }

        updateQuoteLinks();

        if (
          window.virellaAnalyticsAllowed === true &&
          typeof window.gtag === "function"
        ) {
          window.gtag(
            "event",
            "select_configuration",
            {
              product_name:
                translatedProductName,
              product_category:
                categoryName,
              selected_configuration:
                selectedConfiguration,
              selected_price:
                selectedPrice,
              page_language:
                language,
              page_url:
                canonicalURL,
            },
          );
        }
      }

      optionButtons.forEach((button) => {
        button.addEventListener(
          "click",
          () => selectOption(button),
        );
      });

      [
        countryInput,
        cityInput,
        customizationInput,
      ].forEach((field) => {
        field?.addEventListener(
          "input",
          updateQuoteLinks,
        );
      });

      quoteLinks.forEach((link) => {
        link.addEventListener(
          "click",
          updateQuoteLinks,
        );
      });

      updateQuoteLinks();
    })();
  </script>

  <script
    is:inline
    define:vars={{
      images,
      resolvedImageAlts,
      translatedProductName,
    }}
  >
    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;
    let previouslyFocusedElement = null;

    const mainImage =
      document.querySelector("#mainImage");

    const mainImageButton =
      document.querySelector("#mainImageButton");

    const lightbox =
      document.querySelector("#lightbox");

    const lightboxImage =
      document.querySelector("#lightboxImage");

    const lightboxStage =
      document.querySelector("#lightboxStage");

    const lightboxCounter =
      document.querySelector("#lightboxCounter");

    const closeButton =
      document.querySelector("#close");

    const nextButton =
      document.querySelector("#nextImage");

    const previousButton =
      document.querySelector("#prevImage");

    const thumbnails =
      document.querySelectorAll(
        ".thumbnail-button",
      );

    function updateCounter() {
      if (lightboxCounter) {
        lightboxCounter.textContent =
          `${currentIndex + 1} / ${images.length}`;
      }
    }

    function changeImage(index) {
      if (!images.length) {
        return;
      }

      currentIndex =
        (index + images.length) % images.length;

      const selectedImage = images[currentIndex];

      if (mainImage) {
        mainImage.src = selectedImage;
        mainImage.alt =
          resolvedImageAlts[currentIndex] ??
          translatedProductName;
      }

      if (lightboxImage) {
        lightboxImage.src = selectedImage;
        lightboxImage.alt =
          resolvedImageAlts[currentIndex] ??
          translatedProductName;
      }

      thumbnails.forEach((item, index2) => {
        item.classList.toggle(
          "active",
          currentIndex === index2,
        );
      });

      updateCounter();
    }

    function showNextImage() {
      changeImage(currentIndex + 1);
    }

    function showPreviousImage() {
      changeImage(currentIndex - 1);
    }

    function openLightbox() {
      if (!lightbox || !images.length) {
        return;
      }

      changeImage(currentIndex);
      previouslyFocusedElement =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;

      lightbox.classList.add("open");
      lightbox.setAttribute(
        "aria-hidden",
        "false",
      );

      document.documentElement.classList.add(
        "lightbox-open",
      );

      closeButton?.focus();
    }

    function closeLightbox() {
      if (!lightbox) {
        return;
      }

      lightbox.classList.remove("open");
      lightbox.setAttribute(
        "aria-hidden",
        "true",
      );

      document.documentElement.classList.remove(
        "lightbox-open",
      );

      if (previouslyFocusedElement instanceof HTMLElement) {
        previouslyFocusedElement.focus();
      } else {
        mainImageButton?.focus();
      }
    }

    thumbnails.forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(
          button.getAttribute("data-index"),
        );

        changeImage(index);
      });
    });

    mainImageButton?.addEventListener(
      "click",
      openLightbox,
    );

    closeButton?.addEventListener(
      "click",
      closeLightbox,
    );

    nextButton?.addEventListener(
      "click",
      showNextImage,
    );

    previousButton?.addEventListener(
      "click",
      showPreviousImage,
    );

    lightbox?.addEventListener(
      "click",
      (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (
          !lightbox?.classList.contains("open")
        ) {
          return;
        }

        if (event.key === "Escape") {
          event.preventDefault();
          closeLightbox();
        }

        if (event.key === "Tab") {
          const focusableElements = [
            closeButton,
            previousButton,
            nextButton,
          ].filter(
            (element) =>
              element instanceof HTMLElement &&
              !element.hasAttribute("disabled"),
          );

          if (!focusableElements.length) {
            return;
          }

          const firstElement = focusableElements[0];
          const lastElement =
            focusableElements[focusableElements.length - 1];

          if (
            event.shiftKey &&
            document.activeElement === firstElement
          ) {
            event.preventDefault();
            lastElement.focus();
          } else if (
            !event.shiftKey &&
            document.activeElement === lastElement
          ) {
            event.preventDefault();
            firstElement.focus();
          }
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          showNextImage();
        }

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          showPreviousImage();
        }
      },
    );

    lightboxStage?.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];

        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true },
    );

    lightboxStage?.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];

        const distanceX =
          touch.clientX - touchStartX;

        const distanceY =
          touch.clientY - touchStartY;

        const isHorizontalSwipe =
          Math.abs(distanceX) >
          Math.abs(distanceY);

        if (
          !isHorizontalSwipe ||
          Math.abs(distanceX) < 45
        ) {
          return;
        }

        if (distanceX < 0) {
          showNextImage();
        } else {
          showPreviousImage();
        }
      },
      { passive: true },
    );
  </script>

