const productQuote =
  productQuoteContent[language] ??
  productQuoteContent.en;

const whatsappNumber = "905539478608";

const quoteGreeting =
  translations.product.whatsappMessage.replace(
    "{product}",
    translatedProductName,
  );

const quoteMessageTemplate = [
  quoteGreeting,
  "",
  productQuote.selected + ":",
  "{configuration}",
  "",
  productQuote.price + ":",
  "{price}",
  "",
  productQuote.country + ":",
  "{country}",
  "",
  productQuote.city + ":",
  "{city}",
  "",
  productQuote.customization + ":",
  "{customization}",
  "",
  productQuote.page + ":",
  "{url}",
  "",
  productQuote.closing,
].join("\n");

function fillQuoteTemplate(
  template: string,
  values: Record<string, string>,
) {
  return Object.entries(values).reduce(
    (message, [key, value]) =>
      message.replaceAll(
        "{" + key + "}",
        value,
      ),
    template,
  );
}

const defaultWhatsappMessage =
  fillQuoteTemplate(
    quoteMessageTemplate,
    {
      configuration: defaultConfiguration,
      price: defaultPriceValue,
      country: "",
      city: "",
      customization: "",
      url: canonicalURL,
    },
  );

const whatsappUrl =
  "https://wa.me/" +
  whatsappNumber +
  "?text=" +
  encodeURIComponent(defaultWhatsappMessage);

