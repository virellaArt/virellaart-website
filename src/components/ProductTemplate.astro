const madeToOrderText =
  madeToOrderCopy[language];

const fillGalleryLabel = (
  template: string,
  value: string,
  token: "product" | "image",
) => template.replace(`{${token}}`, value);

const categoryTranslationKey = {
  "living-rooms": "livingRooms",
  "dining-rooms": "diningRooms",
  bedrooms: "bedrooms",
  "tv-units": "tvUnits",
} as const;

const categoryKey =
  product.category as keyof typeof categoryTranslationKey;
const productStyle =
  product.style ?? "luxury-classic";
const collectionCopy =
  collectionMenuCopy[language];
const productCollectionLabel =
  productStyle === "modern"
    ? collectionCopy.categoryEyebrow
    : translations.product.collectionLabel;

const categoryTranslation =
  categoryTranslationKey[categoryKey];

const categoryName =
  productStyle === "modern" &&
  categoryKey === "living-rooms"
    ? collectionCopy.sofaSets
    : translations.category[categoryTranslation]
        .title;

const categoryPath =
  productStyle === "modern"
    ? `/collections/modern/${
        collectionCategorySlugs[
          categoryKey as CollectionCategory
        ]
      }`
    : `/${product.category}`;

const categoryURL = new URL(
  localizedPath(categoryPath, language),
  "https://www.virellaart.com",
).href;

/* =========================
   PRODUCT BASIC DATA
========================= */

const images: string[] = product.images ?? [];
const productOrderModel =
  product.orderModel ?? "made-to-order";

if (productOrderModel !== "made-to-order") {
  throw new Error(
    `Unsupported product order model: ${productOrderModel}`,
  );
}

/*
 * Google maps "InStock" to products that are currently available for
 * ordering and can be fulfilled. VIRELLAART's separate orderModel and
 * visible copy make clear that every item is produced after confirmation;
 * this value does not claim warehouse inventory.
 */
const productAvailability =
  "https://schema.org/InStock";

/* VIRELLAART PRODUCT IMAGE ALTS */

type ProductImageAltMap =
  Partial<Record<string, string[]>>;

const productImageAltMap =
  (
    product as {
      imageAlts?: ProductImageAltMap;
    }
  ).imageAlts ?? {};

const manualImageAlts =
  productImageAltMap[language] ?? [];

const resolvedImageAlts =
  images.map(
    (_image, index) =>
      manualImageAlts[index] ??
      (
        index === 0
          ? translatedProductName
          : `${translatedProductName} ${index + 1}`
      ),
  );

const prices: {
  label: string;
  price: string;
  featured?: boolean;
}[] = product.prices ?? [];

const featuredPriceIndex =
  prices.findIndex((item) => item.featured);

const defaultPriceIndex =
  featuredPriceIndex >= 0
    ? featuredPriceIndex
    : 0;

const defaultPrice =
  prices[defaultPriceIndex];

const defaultConfiguration =
  defaultPrice
    ? translatePriceLabel(
        defaultPrice.label,
        language,
      )
    : translatedProductName;

const defaultPriceValue =
  defaultPrice?.price ?? "";

/* VIRELLAART DINING AND BEDROOM INCLUDED PRICE */

