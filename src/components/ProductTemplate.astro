---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLanguageFromPath,
  getProductDescription,
  getTranslations,
  localizedPath,
  translatePriceLabel,
  translateProductName,
} from "../i18n/config";

const { product } = Astro.props;

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const translatedProductName = translateProductName(
  product.name,
  language,
);

const categoryTranslationKey = {
  "living-rooms": "livingRooms",
  "dining-rooms": "diningRooms",
  bedrooms: "bedrooms",
  "tv-units": "tvUnits",
} as const;

const categoryKey =
  product.category as keyof typeof categoryTranslationKey;

const categoryTranslation =
  categoryTranslationKey[categoryKey];

const categoryName =
  translations.category[categoryTranslation].title;

const categoryURL = new URL(
  localizedPath(`/${product.category}`, language),
  "https://www.virellaart.com",
).href;

/* =========================
   PRODUCT BASIC DATA
========================= */

const images: string[] = product.images ?? [];

const prices: {
  label: string;
  price: string;
  featured?: boolean;
}[] = product.prices ?? [];

/* =========================
   SEO DATA
========================= */

const pageDescription =
  getProductDescription(product, language);

const canonicalURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com",
).href;

const productID = product.name
  .toLowerCase()
  .replaceAll(" ", "-");

const primaryPrice =
  Number(
    prices[0]?.price
      .replace("$", "")
      .replace(",", ""),
  ) || 0;

/* =========================
   PRODUCT SCHEMA
========================= */

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: translatedProductName,
  "@id": `${canonicalURL}#product`,
  url: canonicalURL,
  mainEntityOfPage: canonicalURL,
  sku: productID,
  category: product.category,
  description: pageDescription,
  inLanguage: language,

  brand: {
    "@type": "Brand",
    name: "VIRELLAART",
  },

  image: images.map(
    (image) => `https://www.virellaart.com${image}`,
  ),

  offers: {
    "@type": "Offer",
    url: canonicalURL,
    priceCurrency: "USD",
    price: primaryPrice,
    itemCondition: "https://schema.org/NewCondition",
    availability: "https://schema.org/InStock",

    seller: {
      "@id": "https://www.virellaart.com/#organization",
    },
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: translations.nav.home,
      item: new URL(
        localizedPath("/", language),
        "https://www.virellaart.com",
      ).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: categoryName,
      item: categoryURL,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: translatedProductName,
      item: canonicalURL,
    },
  ],
};

const productEvent = {
  currency: "USD",
  value: primaryPrice,

  items: [
    {
      item_id: productID,
      item_name: translatedProductName,
      item_brand: "VIRELLAART",
      item_category: categoryName,
      price: primaryPrice,
      quantity: 1,
    },
  ],
};

/* =========================
   WHATSAPP
========================= */

const whatsappNumber = "905539478608";

const whatsappMessage =
  translations.product.whatsappMessage.replace(
    "{product}",
    translatedProductName,
  );

const whatsappUrl =
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
    whatsappMessage,
  )}`;
---

<BaseLayout
  title={translatedProductName}
  description={pageDescription}
  image={images[0]}
  imageAlt={translatedProductName}
  pageType="product"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <script is:inline define:vars={{ productEvent }}>
    if (typeof window.gtag === "function") {
      window.gtag("event", "view_item", productEvent);
    }
  </script>

  <div class="product-page">
    <nav
      class="breadcrumbs"
      aria-label="Breadcrumb"
    >
      <a href={localizedPath("/", language)}>
        {translations.nav.home}
      </a>

      <span aria-hidden="true">/</span>

      <a
        href={localizedPath(
          `/${product.category}`,
          language,
        )}
      >
        {categoryName}
      </a>

      <span aria-hidden="true">/</span>

      <span aria-current="page">
        {translatedProductName}
      </span>
    </nav>

    <section class="product-container">
      <div class="product-layout">
        <section class="gallery-section">
          <button
            class="main-image-button"
            id="mainImageButton"
            type="button"
            aria-label={`View ${translatedProductName} gallery`}
          >
            <img
              id="mainImage"
              src={images[0]}
              alt={translatedProductName}
              width="1600"
              height="1200"
              fetchpriority="high"
              decoding="async"
            />

            <span class="zoom" aria-hidden="true">
              +
            </span>
          </button>

          <div class="thumbnail-grid">
            {
              images.map(
                (image: string, index: number) => (
                  <button
                    class:list={[
                      "thumbnail-button",
                      index === 0 && "active",
                    ]}
                    data-index={index}
                    type="button"
                    aria-label={`View image ${index + 1}`}
                  >
                    <img
                      src={image}
                      alt={`${translatedProductName} ${index + 1}`}
                      width="480"
                      height="360"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                ),
              )
            }
          </div>
        </section>

        <section class="product-information">
          <p class="collection-label">
            {translations.product.collectionLabel}
          </p>

          <h1>{translatedProductName}</h1>

          {
            product.subtitle && (
              <h2>{product.subtitle}</h2>
            )
          }

          <div class="decorative-line"></div>

          <p class="product-description">
            {pageDescription}
          </p>

          <div class="price-card">
            <div class="price-header">
              <span>
                {translations.product.prices}
              </span>

              <small>USD</small>
            </div>

            {
              prices.map(
                (
                  item: {
                    label: string;
                    price: string;
                    featured?: boolean;
                  },
                  index: number,
                ) => (
                  <div
                    class:list={[
                      "price-row",
                      (index === 0 ||
                        item.featured) &&
                        "featured",
                    ]}
                  >
                    <span>
                      {translatePriceLabel(
                        item.label,
                        language,
                      )}
                    </span>

                    <strong>{item.price}</strong>
                  </div>
                ),
              )
            }
          </div>

          <div class="services">
            <div>
              <strong>
                {
                  translations.product
                    .worldwideDelivery
                }
              </strong>

              <p>
                {
                  translations.product
                    .worldwideDeliveryText
                }
              </p>
            </div>

            <div>
              <strong>
                {translations.product.craftsmanship}
              </strong>

              <p>
                {
                  translations.product
                    .craftsmanshipText
                }
              </p>
            </div>
          </div>

          <a
            href={whatsappUrl}
            class="whatsapp"
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-context="product"
            data-product={translatedProductName}
          >
            {translations.product.whatsapp}
          </a>

          <p class="note">
            {translations.product.note}
          </p>
        </section>
      </div>
    </section>
  </div>

  <div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label={`${translatedProductName} image gallery`}
  >
    <button
      class="lightbox-close"
      id="close"
      type="button"
      aria-label="Close image gallery"
    >
      <span aria-hidden="true">&#215;</span>
    </button>

    {
      images.length > 1 && (
        <button
          class="lightbox-arrow left"
          id="prevImage"
          type="button"
          aria-label={
            translations.product.previousImage
          }
        >
          <span aria-hidden="true">&#8249;</span>
        </button>
      )
    }

    <div class="lightbox-stage" id="lightboxStage">
      <img
        id="lightboxImage"
        src={images[0]}
        alt={translatedProductName}
        width="1600"
        height="1200"
      />
    </div>

    {
      images.length > 1 && (
        <>
          <div
            class="lightbox-counter"
            id="lightboxCounter"
            aria-live="polite"
          >
            1 / {images.length}
          </div>

          <button
            class="lightbox-arrow right"
            id="nextImage"
            type="button"
            aria-label={
              translations.product.nextImage
            }
          >
            <span aria-hidden="true">&#8250;</span>
          </button>
        </>
      )
    }
  </div>

  <script
    is:inline
    define:vars={{
      images,
      translatedProductName,
    }}
  >
    let currentIndex = 0;
    let touchStartX = 0;
    let touchStartY = 0;

    const mainImage =
      document.querySelector("#mainImage");

    const mainImageButton =
      document.querySelector("#mainImageButton");

    const lightbox =
      document.querySelector("#lightbox");

    const lightboxImage =
      document.querySelector("#lightboxImage");

    const lightboxStage =
      document.querySelector("#lightboxStage");

    const lightboxCounter =
      document.querySelector("#lightboxCounter");

    const closeButton =
      document.querySelector("#close");

    const nextButton =
      document.querySelector("#nextImage");

    const previousButton =
      document.querySelector("#prevImage");

    const thumbnails =
      document.querySelectorAll(
        ".thumbnail-button",
      );

    function updateCounter() {
      if (lightboxCounter) {
        lightboxCounter.textContent =
          `${currentIndex + 1} / ${images.length}`;
      }
    }

    function changeImage(index) {
      if (!images.length) {
        return;
      }

      currentIndex =
        (index + images.length) % images.length;

      const selectedImage = images[currentIndex];

      if (mainImage) {
        mainImage.src = selectedImage;
        mainImage.alt =
          `${translatedProductName} ${currentIndex + 1}`;
      }

      if (lightboxImage) {
        lightboxImage.src = selectedImage;
        lightboxImage.alt =
          `${translatedProductName} ${currentIndex + 1}`;
      }

      thumbnails.forEach((item, index2) => {
        item.classList.toggle(
          "active",
          currentIndex === index2,
        );
      });

      updateCounter();
    }

    function showNextImage() {
      changeImage(currentIndex + 1);
    }

    function showPreviousImage() {
      changeImage(currentIndex - 1);
    }

    function openLightbox() {
      if (!lightbox || !images.length) {
        return;
      }

      changeImage(currentIndex);

      lightbox.classList.add("open");
      lightbox.setAttribute(
        "aria-hidden",
        "false",
      );

      document.documentElement.classList.add(
        "lightbox-open",
      );

      closeButton?.focus();
    }

    function closeLightbox() {
      if (!lightbox) {
        return;
      }

      lightbox.classList.remove("open");
      lightbox.setAttribute(
        "aria-hidden",
        "true",
      );

      document.documentElement.classList.remove(
        "lightbox-open",
      );

      mainImageButton?.focus();
    }

    thumbnails.forEach((button) => {
      button.addEventListener("click", () => {
        const index = Number(
          button.getAttribute("data-index"),
        );

        changeImage(index);
      });
    });

    mainImageButton?.addEventListener(
      "click",
      openLightbox,
    );

    closeButton?.addEventListener(
      "click",
      closeLightbox,
    );

    nextButton?.addEventListener(
      "click",
      showNextImage,
    );

    previousButton?.addEventListener(
      "click",
      showPreviousImage,
    );

    lightbox?.addEventListener(
      "click",
      (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (
          !lightbox?.classList.contains("open")
        ) {
          return;
        }

        if (event.key === "Escape") {
          event.preventDefault();
          closeLightbox();
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          showNextImage();
        }

        if (event.key === "ArrowLeft") {
          event.preventDefault();
          showPreviousImage();
        }
      },
    );

    lightboxStage?.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];

        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      },
      { passive: true },
    );

    lightboxStage?.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];

        const distanceX =
          touch.clientX - touchStartX;

        const distanceY =
          touch.clientY - touchStartY;

        const isHorizontalSwipe =
          Math.abs(distanceX) >
          Math.abs(distanceY);

        if (
          !isHorizontalSwipe ||
          Math.abs(distanceX) < 45
        ) {
          return;
        }

        if (distanceX < 0) {
          showNextImage();
        } else {
          showPreviousImage();
        }
      },
      { passive: true },
    );
  </script>

  <style>
    :global(html),
    :global(body) {
      margin: 0;
      padding: 0;
      background: #171411;
    }

    :global(body) {
      overflow-x: hidden;
    }

    :global(html.lightbox-open),
    :global(html.lightbox-open body) {
      overflow: hidden;
      overscroll-behavior: none;
    }

    .product-page {
      min-height: 100vh;
      padding: 40px 30px 100px;
      color: white;
      background:
        radial-gradient(
          circle at top right,
          rgba(190, 150, 80, 0.12),
          transparent 500px
        ),
        #171411;
    }

    .breadcrumbs {
      width: min(1500px, 100%);
      margin: 70px auto 28px;
      display: flex;
      align-items: center;
      gap: 10px;
      overflow: hidden;
      color: rgba(255, 255, 255, 0.5);
      font-size: 11px;
      letter-spacing: 1px;
      white-space: nowrap;
    }

    .breadcrumbs a {
      color: rgba(255, 255, 255, 0.72);
      transition: color 0.2s ease;
    }

    .breadcrumbs a:hover {
      color: var(--gold);
    }

    .breadcrumbs span[aria-current="page"] {
      overflow: hidden;
      color: var(--gold-light);
      text-overflow: ellipsis;
    }

    .product-container {
      width: min(1500px, 100%);
      margin: auto;
    }

    .product-layout {
      display: grid;
      grid-template-columns: 1.35fr 0.95fr;
      gap: 55px;
      align-items: start;
    }

    /* GALLERY */

    .gallery-section {
      min-width: 0;
    }

    .main-image-button {
      position: relative;
      width: 100%;
      aspect-ratio: 1.3 / 1;
      padding: 0;
      border: 0;
      overflow: hidden;
      background: #111;
      cursor: pointer;
    }

    .main-image-button img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .main-image-button:hover img {
      transform: scale(1.02);
    }

    .zoom {
      position: absolute;
      right: 20px;
      bottom: 20px;
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.65);
      color: #d3ad62;
      font-size: 30px;
    }

    .thumbnail-grid {
      display: flex;
      gap: 12px;
      margin-top: 16px;
    }

    .thumbnail-button {
      width: 95px;
      height: 75px;
      padding: 0;
      flex: 0 0 auto;
      border: 1px solid transparent;
      overflow: hidden;
      background: none;
      cursor: pointer;
    }

    .thumbnail-button img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .thumbnail-button.active {
      border-color: #c9a55b;
    }

    /* INFORMATION */

    .product-information {
      padding-top: 10px;
    }

    .collection-label {
      margin: 0 0 15px;
      color: #c9a55b;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 4px;
    }

    .product-information h1 {
      margin: 0;
      font-family:
        Georgia,
        "Times New Roman",
        serif;
      font-size: 64px;
      font-weight: 400;
      line-height: 0.92;
      letter-spacing: -0.045em;
    }

    .product-information h2 {
      margin-top: 15px;
      color: #cbbda8;
      font-family: Georgia, serif;
      font-size: 25px;
      font-style: italic;
      font-weight: 400;
    }

    .decorative-line {
      height: 1px;
      margin: 35px 0;
      background: #76572c;
    }

    .product-description {
      color: #c8beb0;
      font-size: 15px;
      line-height: 1.9;
    }

    /* PRICE */

    .price-card {
      margin-top: 35px;
      border: 1px solid #59472b;
      background: #211c18;
    }

    .price-header {
      display: flex;
      justify-content: space-between;
      padding: 18px;
      background: #100e0c;
      color: #d1aa60;
      font-size: 12px;
      letter-spacing: 2px;
    }

    .price-row {
      display: flex;
      justify-content: space-between;
      padding: 18px;
      border-bottom: 1px solid #403327;
      color: #ddd;
    }

    .price-row:last-child {
      border-bottom: 0;
    }

    .price-row strong {
      color: white;
    }

    .price-row.featured strong {
      color: #d4ad62;
      font-size: 22px;
    }

    /* SERVICES */

    .services {
      display: grid;
      gap: 20px;
      margin-top: 30px;
    }

    .services strong {
      color: #d3ae63;
    }

    .services p {
      margin: 5px 0 0;
      color: #999;
      font-size: 13px;
    }

    /* WHATSAPP */

    .whatsapp {
      display: block;
      margin-top: 35px;
      padding: 18px;
      background: #b89555;
      color: #111;
      font-weight: bold;
      text-align: center;
      text-decoration: none;
    }

    .note {
      margin-top: 15px;
      color: #999;
      font-size: 12px;
      text-align: center;
    }

    /* LIGHTBOX */

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 2147483000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 28px 100px;
      overflow: hidden;
      overscroll-behavior: contain;
      background: rgba(0, 0, 0, 0.96);
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox-stage {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
    }

    .lightbox-stage img {
      display: block;
      max-width: 85vw;
      max-height: 85vh;
      width: auto;
      height: auto;
      object-fit: contain;
      user-select: none;
      -webkit-user-drag: none;
    }

    .lightbox-close,
    .lightbox-arrow {
      position: absolute;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 1px solid rgba(201, 165, 91, 0.8);
      background: rgba(17, 17, 17, 0.82);
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1;
      cursor: pointer;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
    }

    .lightbox-close:hover,
    .lightbox-arrow:hover {
      border-color: #d8b66d;
      background: rgba(38, 31, 24, 0.96);
    }

    .lightbox-close:focus-visible,
    .lightbox-arrow:focus-visible {
      outline: 2px solid #e1bd73;
      outline-offset: 3px;
    }

    .lightbox-close {
      top: 24px;
      right: 24px;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      font-size: 32px;
    }

    .lightbox-close span {
      display: block;
      line-height: 1;
      transform: translateY(-1px);
    }

    .lightbox-arrow {
      top: 50%;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      font-size: 38px;
      transform: translateY(-50%);
    }

    .lightbox-arrow.left {
      left: 24px;
    }

    .lightbox-arrow.right {
      right: 24px;
    }

    .lightbox-arrow span {
      display: block;
      line-height: 1;
      transform: translateY(-2px);
    }

    .lightbox-counter {
      position: absolute;
      bottom: 22px;
      left: 50%;
      z-index: 2;
      min-width: 58px;
      padding: 7px 12px;
      border: 1px solid rgba(201, 165, 91, 0.45);
      border-radius: 999px;
      background: rgba(17, 17, 17, 0.72);
      color: rgba(255, 255, 255, 0.86);
      font-size: 12px;
      letter-spacing: 1px;
      text-align: center;
      transform: translateX(-50%);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    @media (max-width: 900px) {
      .product-page {
        padding: 30px 15px 70px;
      }

      .product-layout {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .product-information h1 {
        font-size: 45px;
      }

      .thumbnail-grid {
        overflow-x: auto;
        padding-bottom: 4px;
        scrollbar-width: thin;
      }

      /*
       * Mobilde görsel için ayrı bir güvenli alan bırakılır.
       * X üstte, oklar altta olduğu için ürünün üstünü kapatmaz.
       */
      .lightbox {
        padding:
          calc(62px + env(safe-area-inset-top))
          10px
          calc(76px + env(safe-area-inset-bottom));
      }

      .lightbox-stage {
        touch-action: pan-y;
      }

      .lightbox-stage img {
        max-width: 100%;
        max-height: 100%;
      }

      .lightbox-close {
        top: calc(
          10px + env(safe-area-inset-top)
        );
        right: calc(
          10px + env(safe-area-inset-right)
        );
        width: 40px;
        height: 40px;
        font-size: 27px;
      }

      .lightbox-arrow {
        top: auto;
        bottom: calc(
          12px + env(safe-area-inset-bottom)
        );
        width: 42px;
        height: 42px;
        border-radius: 12px;
        font-size: 31px;
        transform: none;
      }

      .lightbox-arrow.left {
        left: calc(
          14px + env(safe-area-inset-left)
        );
      }

      .lightbox-arrow.right {
        right: calc(
          14px + env(safe-area-inset-right)
        );
      }

      .lightbox-counter {
