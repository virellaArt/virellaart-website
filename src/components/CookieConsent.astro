---

<section
  class="cookie-consent"
  data-cookie-consent
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
  hidden
>
  <div>
    <strong id="cookie-consent-title">{consent.title}</strong>
    <p id="cookie-consent-description">
      {consent.description}
      <a href={localizedPath("/policies/privacy-policy", language)}>
        {consent.privacy}
      </a>
    </p>
  </div>

  <div class="cookie-actions">
    <button type="button" data-cookie-reject>{consent.reject}</button>
    <button type="button" class="cookie-accept" data-cookie-accept>
      {consent.accept}
    </button>
  </div>
</section>

<button
  type="button"
  class="cookie-settings"
  data-cookie-settings
  hidden
>
  {consent.settings}
</button>

<script is:inline>
  (() => {
    const storageKey = "virellaart-analytics-consent";
    const measurementId = "G-Y8YY6ZBD87";
    const banner = document.querySelector("[data-cookie-consent]");
    const acceptButton = document.querySelector("[data-cookie-accept]");
    const rejectButton = document.querySelector("[data-cookie-reject]");
    const settingsButton = document.querySelector("[data-cookie-settings]");

    window.dataLayer = window.dataLayer || [];
    window.gtag =
      window.gtag ||
      function () {
        window.dataLayer.push(arguments);
      };

    window.gtag("consent", "default", {
      ad_storage: "denied",
      analytics_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      wait_for_update: 500,
    });

    function loadAnalytics() {
      if (document.querySelector("[data-virella-analytics]")) {
        return;
      }

      const script = document.createElement("script");
      script.async = true;
      script.src =
        "https://www.googletagmanager.com/gtag/js?id=" +
        encodeURIComponent(measurementId);
      script.dataset.virellaAnalytics = "true";
      document.head.append(script);

      window.gtag("js", new Date());
      window.gtag("config", measurementId, {
        anonymize_ip: true,
      });
    }

    function readStoredConsent() {
      try {
        return localStorage.getItem(storageKey);
      } catch {
        return null;
      }
    }

    function persistConsent(choice) {
      try {
        localStorage.setItem(storageKey, choice);
      } catch {
        // Consent remains valid for the current page session.
      }
    }

    function setConsent(choice, persist = true) {
      const granted = choice === "granted";
      window.virellaAnalyticsAllowed = granted;

      window.gtag("consent", "update", {
        ad_storage: "denied",
        analytics_storage: granted ? "granted" : "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
      });

      if (persist) {
        persistConsent(choice);
      }

      if (banner instanceof HTMLElement) {
        banner.hidden = true;
      }

      if (settingsButton instanceof HTMLElement) {
        settingsButton.hidden = false;
      }

      if (granted) {
        loadAnalytics();
        document.dispatchEvent(
          new CustomEvent("virella:analytics-ready"),
        );
      }
    }

    const storedChoice = readStoredConsent();

    if (storedChoice === "granted" || storedChoice === "denied") {
      setConsent(storedChoice, false);
    } else if (banner instanceof HTMLElement) {
      banner.hidden = false;
      acceptButton?.focus();
    }

    acceptButton?.addEventListener("click", () => {
      setConsent("granted");
    });

    rejectButton?.addEventListener("click", () => {
      setConsent("denied");
    });

    settingsButton?.addEventListener("click", () => {
      if (banner instanceof HTMLElement) {
        banner.hidden = false;
        acceptButton?.focus();
      }
    });
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 100000;
    right: 16px;
    bottom: 14px;
    left: 16px;
    width: min(calc(100% - 32px), 760px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid rgba(225, 199, 138, 0.48);
    background: rgba(16, 13, 11, 0.97);
    box-shadow: 0 14px 45px rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(12px);
  }

  .cookie-consent[hidden],
  .cookie-settings[hidden] {
    display: none;
  }

  .cookie-consent strong {
    display: block;
    margin-bottom: 4px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
  }

  .cookie-consent p {
    max-width: 500px;
    margin: 0;
    color: #ded6cb;
    font-size: 11px;
    line-height: 1.5;
  }

  .cookie-consent a {
    color: var(--gold-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-actions {
    display: flex;
    flex-shrink: 0;
    gap: 8px;
  }

  .cookie-actions button {
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid rgba(225, 199, 138, 0.66);
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.55px;
    white-space: nowrap;
  }

  .cookie-actions .cookie-accept {
    background: var(--gold-light);
    color: #17120e;
  }

  .cookie-settings {
    position: fixed;
    z-index: 9999;
    bottom: 8px;
    left: 8px;
    padding: 6px 8px;
    border: 1px solid rgba(225, 199, 138, 0.4);
    background: rgba(16, 13, 11, 0.93);
    color: #f5efe6;
    font-size: 9px;
  }

  @media (max-width: 720px) {
    .cookie-consent {
      right: 10px;
      bottom: 10px;
      left: 10px;
      width: calc(100% - 20px);
      grid-template-columns: 1fr;
      gap: 11px;
      padding: 13px;
    }

    .cookie-consent strong {
      font-size: 15px;
    }

    .cookie-consent p {
      max-width: none;
      font-size: 10px;
      line-height: 1.45;
    }

    .cookie-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cookie-actions button {
      min-height: 36px;
      padding: 7px 8px;
      white-space: normal;
    }
  }

  @media (max-width: 380px) {
    .cookie-consent {
      padding: 11px;
    }

    .cookie-consent p {
      font-size: 9.5px;
    }

    .cookie-actions {
      gap: 6px;
    }

    .cookie-actions button {
      font-size: 8px;
    }
  }
</style>
