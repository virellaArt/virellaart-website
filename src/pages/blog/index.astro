---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getLanguageFromPath,
  localizedPath,
} from "../../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const isEnglish = language === "en";

const englishBlogURL =
  "https://www.virellaart.com/blog/";

const alternateURLs = [
  {
    language: "en",
    href: englishBlogURL,
  },
];

const pageTitle =
  "Luxury Furniture & Interior Design Journal";

const pageDescription =
  "Explore luxury furniture buying guides, interior design ideas and practical advice for creating refined living spaces with VIRELLAART.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/living-room.webp"
  imageAlt="Luxury VIRELLAART living room interior"
  robots={isEnglish ? "index, follow" : "noindex, follow"}
  alternateURLs={alternateURLs}
  xDefaultURL={englishBlogURL}
  includeCanonical={isEnglish}
>
  <main class="journal-page">
    <section class="journal-hero">
      <div class="journal-shell">
        <p class="eyebrow">VIRELLAART Journal</p>

        <h1>Luxury Furniture & Interior Design Journal</h1>

        <p class="hero-description">
          Expert buying guides, design ideas and practical advice for
          choosing furniture that brings proportion, comfort and lasting
          character to refined interiors.
        </p>
      </div>
    </section>

    {
      !isEnglish && (
        <aside class="language-notice">
          <div class="journal-shell">
            <strong>English edition</strong>
            <p>
              The journal has not yet been translated into this language.
              This page is excluded from search indexing until localized
              editorial content is published.
            </p>
            <a href={englishBlogURL}>Open the English journal</a>
          </div>
        </aside>
      )
    }

    <section class="articles-section">
      <div class="journal-shell">
        <div class="section-heading">
          <p class="eyebrow dark">Latest guides</p>
          <h2>Furniture knowledge for considered decisions</h2>
        </div>

        <article class="article-card">
          <a
            class="article-image"
            href={localizedPath(
              "/blog/how-to-choose-a-luxury-sofa-set",
              language,
            )}
            aria-label="Read How to Choose a Luxury Sofa Set"
          >
            <img
              src="/living-room.webp"
              alt="Luxury sofa set in an elegant VIRELLAART living room"
              width="1600"
              height="900"
              loading="eager"
            />
          </a>

          <div class="article-card-content">
            <p class="article-category">
              Luxury Furniture Buying Guide
            </p>

            <h2>
              <a
                href={localizedPath(
                  "/blog/how-to-choose-a-luxury-sofa-set",
                  language,
                )}
              >
                How to Choose a Luxury Sofa Set
              </a>
            </h2>

            <p>
              Learn how to evaluate room size, seating layout, comfort,
              design character and craftsmanship before selecting a
              luxury sofa set.
            </p>

            <div class="article-meta">
              <span>August 3, 2026</span>
              <span>9 min read</span>
            </div>

            <a
              class="read-link"
