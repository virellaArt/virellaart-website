---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Luxury Furniture Journal | VIRELLAART";
const pageDescription =
  "Explore luxury furniture ideas, modern interior design guides, buying advice and curated inspiration from VIRELLAART.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <main class="blog-page">
    <section class="blog-hero">
      <div class="blog-hero__content">
        <p class="blog-hero__eyebrow">VIRELLAART Journal</p>

        <h1>Luxury Furniture & Interior Design Journal</h1>

        <p class="blog-hero__description">
          Discover modern furniture inspiration, luxury interior ideas,
          buying guides and expert advice for refined living spaces.
        </p>
      </div>
    </section>

    <section class="blog-content">
      <div class="blog-content__container">
        <h2>Latest Articles</h2>

        <p>
          Our first VIRELLAART Journal articles are coming soon.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    background: #f7f3ee;
  }

  .blog-hero {
    padding: 120px 24px 90px;
    background:
      linear-gradient(
        135deg,
        rgba(22, 17, 14, 0.96),
        rgba(58, 42, 31, 0.9)
      );
    color: #ffffff;
  }

  .blog-hero__content {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .blog-hero__eyebrow {
    margin: 0 0 18px;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d8b36a;
  }

  .blog-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    font-weight: 500;
  }

  .blog-hero__description {
    max-width: 680px;
    margin: 28px 0 0;
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.82);
  }

  .blog-content {
    padding: 80px 24px 120px;
  }

  .blog-content__container {
    width: min(1120px, 100%);
    margin: 0 auto;
  }

  .blog-content h2 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: #201813;
  }

  .blog-content p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.8;
    color: #65584f;
  }
</style>
