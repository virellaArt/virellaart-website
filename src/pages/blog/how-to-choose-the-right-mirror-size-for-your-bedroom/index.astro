  }

  .article-body li {
    margin: 9px 0;
  }

  .key-points {
    margin-bottom: 45px;
    padding: 32px 35px;
    border-left: 3px solid #a77a38;
    background: #eee6da;
  }

  .key-points h2 {
    margin: 0 0 12px;
    font-size: 30px;
  }

  .key-points p {
    margin: 0;
    color: #594a40;
  }

  .editorial-link {
    margin: 42px 0;
    padding: 26px 30px;
    border: 1px solid rgba(126, 89, 37, 0.25);
    background: #fffdf9;
  }

  .editorial-link p {
    margin: 0;
    color: #5a4b41;
  }

  .editorial-link a {
    color: #7c5723;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .checklist {
    display: grid;
    gap: 11px;
    margin: 30px 0 55px;
    padding: 30px;
    background: #ece4d9;
  }

  .checklist label {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 10px;
    color: #51463e;
    font-size: 16px;
    line-height: 1.55;
  }

  .checklist input {
    margin-top: 5px;
  }

  .conclusion {
    margin-top: 80px;
    padding: clamp(35px, 6vw, 65px);
    background:
      radial-gradient(
        circle at top right,
        rgba(201, 164, 93, 0.18),
        transparent 38%
      ),
      #17100c;
    color: #ffffff;
  }

  .conclusion h2 {
    margin-top: 0;
    color: #ffffff;
  }

  .conclusion > p:not(.article-category) {
    color: rgba(255, 255, 255, 0.73);
  }

  .cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 32px;
  }

  .primary-cta,
  .secondary-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 12px 21px;
    font-family: Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .primary-cta {
    background: #c9a45d;
    color: #17100c;
  }

  .secondary-cta {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .faq {
    margin-top: 85px;
  }

  .faq > h2 {
    margin-top: 0;
  }

  .faq details {
    border-top: 1px solid rgba(70, 51, 39, 0.2);
  }

  .faq details:last-child {
    border-bottom: 1px solid rgba(70, 51, 39, 0.2);
  }

  .faq summary {
    padding: 22px 35px 22px 0;
    color: #30231c;
    font-size: 19px;
    cursor: pointer;
  }

  .faq details p {
    margin: 0;
    padding: 0 0 23px;
    color: #60534a;
  }

  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .contents {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .article-hero {
      padding: 125px 0 70px;
    }

    .article-grid {
      padding-top: 65px;
      padding-bottom: 100px;
    }

    .article-body {
      font-size: 17px;
    }

    .key-points,
    .editorial-link,
    .checklist {
      padding: 24px;
    }
  }
</style>

