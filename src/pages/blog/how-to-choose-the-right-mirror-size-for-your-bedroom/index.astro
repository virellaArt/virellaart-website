    font-size: 18px;
    line-height: 1.9;
  }

  .article-body > p {
    margin: 0 0 27px;
    color: #574b43;
  }

  .article-body h2 {
    scroll-margin-top: 120px;
    margin: 72px 0 22px;
    color: #241a15;
    font-size: clamp(31px, 4vw, 43px);
