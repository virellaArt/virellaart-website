            </a>

            <a
              class="secondary-cta"
              href={localizedPath("/contact", language)}
            >
              Contact VIRELLAART
            </a>
          </div>
        </section>

        <section
          class="faq"
          aria-labelledby="faq-title"
        >
          <p class="article-category">
            Frequently asked questions
          </p>

          <h2 id="faq-title">
            Dining table size FAQ
          </h2>

          {
            faqItems.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </section>
      </div>
    </div>
  </article>
</ArticleLayout>

