---
import HomePage from "../index.astro";
import AboutPage from "../about.astro";
import ManufacturingPage from "../manufacturing.astro";
import ContactPage from "../contact.astro";
import LivingRoomsPage from "../living-rooms.astro";
import DiningRoomsPage from "../dining-rooms.astro";
import BedroomsPage from "../bedrooms.astro";
import TVUnitsPage from "../tv-units.astro";
import BlogPage from "../blog/index.astro";
import LuxuryClassicPage from "../collections/luxury-classic.astro";
import ModernPage from "../collections/modern.astro";
import ModernSofaSetsPage from "../collections/modern/sofa-sets.astro";
import ModernDiningRoomsPage from "../collections/modern/dining-rooms.astro";
import ModernBedroomsPage from "../collections/modern/bedrooms.astro";
import ModernTVUnitsPage from "../collections/modern/tv-units.astro";

/* VIRELLAART LOCALIZED POLICY IMPORTS */
import ShippingPolicyPage from "../policies/shipping-policy.astro";
import ReturnRefundPolicyPage from "../policies/return-refund-policy.astro";
import PrivacyPolicyPage from "../policies/privacy-policy.astro";
import TermsConditionsPage from "../policies/terms-conditions.astro";

import ProductTemplate from "../../components/ProductTemplate.astro";
import { products } from "../../data/products";

import {
  isLanguage,
  localizedLanguageCodes,
} from "../../i18n/config";

import {
  allRoutes,
  productRoutes,
} from "../../i18n/routes";

export function getStaticPaths() {
  return localizedLanguageCodes.flatMap((lang) =>
    allRoutes.map((route) => ({
      params: {
        lang,
        path: route || undefined,
      },
    })),
  );
}

const language = Astro.params.lang;
const path = Astro.params.path ?? "";

if (!isLanguage(language)) {
  throw new Error(`Unsupported language route: ${language}`);
}

const productKey =
  productRoutes[path as keyof typeof productRoutes];

const product = productKey
  ? products[productKey as keyof typeof products]
  : undefined;
---

{path === "" && <HomePage />}
{path === "about" && <AboutPage />}
{path === "manufacturing" && <ManufacturingPage />}
{path === "contact" && <ContactPage />}
{path === "living-rooms" && <LivingRoomsPage />}
{path === "dining-rooms" && <DiningRoomsPage />}
{path === "bedrooms" && <BedroomsPage />}
{path === "tv-units" && <TVUnitsPage />}
{path === "blog" && <BlogPage />}
{
  path === "collections/luxury-classic" && (
    <LuxuryClassicPage />
  )
}
{path === "collections/modern" && <ModernPage />}
{
  path === "collections/modern/sofa-sets" && (
    <ModernSofaSetsPage />
  )
}
{
  path === "collections/modern/dining-rooms" && (
    <ModernDiningRoomsPage />
  )
}
{
  path === "collections/modern/bedrooms" && (
    <ModernBedroomsPage />
  )
}
{
  path === "collections/modern/tv-units" && (
    <ModernTVUnitsPage />
  )
}

{/* VIRELLAART LOCALIZED POLICY PAGES */}
{
  path === "policies/shipping-policy" && (
    <ShippingPolicyPage />
  )
}
{
  path === "policies/return-refund-policy" && (
    <ReturnRefundPolicyPage />
  )
}
{
  path === "policies/privacy-policy" && (
    <PrivacyPolicyPage />
  )
}
{
  path === "policies/terms-conditions" && (
    <TermsConditionsPage />
  )
}
{product && <ProductTemplate {product} />}
