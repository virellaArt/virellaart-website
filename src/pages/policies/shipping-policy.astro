---
import PolicyLayout from "../../components/PolicyLayout.astro";
import { getLanguageFromPath } from "../../i18n/config";
import turkishPolicy from "../../i18n/policies/shipping-policy-tr.json";
import germanPolicy from "../../i18n/policies/shipping-policy-de.json";
import frenchPolicy from "../../i18n/policies/shipping-policy-fr.json";
import italianPolicy from "../../i18n/policies/shipping-policy-it.json";
import russianPolicy from "../../i18n/policies/shipping-policy-ru.json";
import arabicPolicy from "../../i18n/policies/shipping-policy-ar.json";
import bulgarianPolicy from "../../i18n/policies/shipping-policy-bg.json";
import romanianPolicy from "../../i18n/policies/shipping-policy-ro.json";
import greekPolicy from "../../i18n/policies/shipping-policy-el.json";
import spanishPolicy from "../../i18n/policies/shipping-policy-es.json";
import serbianPolicy from "../../i18n/policies/shipping-policy-sr.json";
import kazakhPolicy from "../../i18n/policies/shipping-policy-kk.json";
import uzbekPolicy from "../../i18n/policies/shipping-policy-uz.json";
import portuguesePolicy from "../../i18n/policies/shipping-policy-pt.json";
import polishPolicy from "../../i18n/policies/shipping-policy-pl.json";

const language = getLanguageFromPath(Astro.url.pathname);
const policy =
  language === "tr"
    ? turkishPolicy
    : language === "de"
      ? germanPolicy
      : language === "fr"
        ? frenchPolicy
        : language === "it"
          ? italianPolicy
          : language === "ru"
            ? russianPolicy
            : language === "ar"
              ? arabicPolicy
              : language === "bg"
                ? bulgarianPolicy
                : language === "ro"
                  ? romanianPolicy
                  : language === "el"
                    ? greekPolicy
                    : language === "es"
                      ? spanishPolicy
                      : language === "sr"
                        ? serbianPolicy
                        : language === "kk"
                          ? kazakhPolicy
                          : language === "uz"
                            ? uzbekPolicy
                            : language === "pt"
                              ? portuguesePolicy
                              : language === "pl"
                                ? polishPolicy
                                : null;
---

<PolicyLayout
  title={policy?.title ?? "International Furniture Shipping Policy | VIRELLAART"}
  description={policy?.description ?? "Learn how VIRELLAART prepares, protects and coordinates international luxury furniture shipments, including packaging, delivery planning and responsibilities."}
>
  {
    policy ? (
      <>
        <p>{policy.intro}</p>

        {policy.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>

            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}

            {section.items.length > 0 && (
              <ul>
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </>
        ))}
      </>
    ) : (
      <>
  <p>
    VIRELLAART is an Istanbul-based luxury furniture brand serving
    private residences, villas and interior projects worldwide. Shipping
    arrangements are prepared individually according to the order, destination
    and selected furniture collection.
  </p>

  <h2>International Delivery</h2>

  <p>
    International delivery is available to many destinations worldwide.
    Available transportation methods, estimated delivery periods and shipping
    costs are confirmed with the customer before the order is finalized.
  </p>

  <p>
    Delivery periods may vary depending on production requirements, destination
    country, customs procedures, transportation method and local delivery
    conditions.
  </p>

  <h2>Production and Dispatch</h2>

  <p>
    Most VIRELLAART furniture collections are prepared after order
    confirmation. The estimated production and dispatch schedule is shared
    during the quotation and order confirmation process.
  </p>

  <h2>Protective Packaging</h2>

  <p>
    Furniture is inspected before dispatch and prepared for transportation
    using protective packaging selected according to the product’s form,
    surface details and transportation requirements.
  </p>

  <ul>
    <li>Protective wrapping for finished surfaces</li>
    <li>Additional protection for decorative and sensitive details</li>
    <li>Packaging preparation suitable for international transportation</li>
    <li>Final visual review before dispatch</li>
  </ul>

  <h2>Customs, Duties and Local Charges</h2>

  <p>
    Import duties, customs charges, taxes, storage fees or destination-country
    expenses may apply depending on local regulations. Unless explicitly
    included in the written quotation, these charges are the responsibility of
    the customer.
  </p>

  <h2>Delivery Inspection</h2>

  <p>
    Customers should inspect the shipment and packaging upon delivery. Any
    visible transportation damage should be recorded with the delivery company
    and reported to VIRELLAART promptly with photographs and relevant delivery
    documents.
  </p>

  <h2>Shipping Information</h2>

  <p>
    Contact the VIRELLAART team for destination-specific shipping costs,
    estimated production periods, packaging information and international
    delivery assistance.
  </p>
      </>
    )
  }
</PolicyLayout>





