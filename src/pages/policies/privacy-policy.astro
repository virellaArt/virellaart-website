---
import PolicyLayout from "../../components/PolicyLayout.astro";
import { getLanguageFromPath } from "../../i18n/config";
import { privacyPolicies } from "../../i18n/policies/privacy-policy";

const language = getLanguageFromPath(Astro.url.pathname);
const policy = privacyPolicies[language];
---

<PolicyLayout
  title={policy.title}
  description={policy.description}
>
  <p>{policy.intro}</p>

  {
    policy.sections.map((section) => (
      <>
        <h2>{section.heading}</h2>

        {section.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        {section.items && section.items.length > 0 && (
          <ul>
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </>
    ))
  }
</PolicyLayout>
