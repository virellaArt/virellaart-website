---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLanguageFromPath,
  localizedPath,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);

const collectionsURL =
  `${localizedPath("/", language)}#collections`;

const contactURL = localizedPath(
  "/contact",
  language,
);

const aboutURL = new URL(
  Astro.url.pathname,
  "https://www.virellaart.com",
).href;

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About VIRELLAART",
  url: aboutURL,
  description:
    "Discover VIRELLAART, an Istanbul-based luxury furniture manufacturer creating refined living room, dining room, bedroom and TV unit collections for international interiors.",
  mainEntity: {
    "@type": "Organization",
    "@id": "https://www.virellaart.com/#organization",
    name: "VIRELLAART",
    url: "https://www.virellaart.com",
    description:
      "Istanbul-based luxury furniture manufacturer creating refined collections for private residences, villas and international interior projects.",
    areaServed: "Worldwide",
  },
};
---

<BaseLayout
  title="About VIRELLAART | Luxury Furniture Manufacturer"
  description="Discover VIRELLAART, an Istanbul-based luxury furniture manufacturer creating refined furniture collections for residences, villas and international interiors."
  image="/about.webp"
  imageAlt="VIRELLAART luxury furniture manufacturing vision"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(aboutPageSchema)}
  />

  <section class="about-hero">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="eyebrow">
        About VIRELLAART
      </span>

      <h1>
        Crafting Timeless
        <strong>Luxury Furniture</strong>
        <em>From Istanbul to the World</em>
      </h1>

      <p>
        VIRELLAART is an Istanbul-based luxury furniture
        manufacturer creating distinctive collections for
        refined residences, villas and international
        interiors.
      </p>
    </div>
  </section>

  <main class="about-page">
    <section class="story-section">
      <div class="story-content">
        <span class="section-label">
          Our Story
        </span>

        <h2>
          Designed With Purpose.
          Created to Leave an Impression.
        </h2>

        <p class="intro-text">
          VIRELLAART was founded with a clear vision:
          to create luxury furniture that gives exceptional
          interiors a distinctive and lasting identity.
        </p>

        <p>
          Based in Istanbul, Türkiye, we develop complete
          living room, dining room, bedroom and TV unit
          collections for customers seeking more than
          ordinary furniture.
        </p>

        <p>
          Every collection is shaped around balanced
          proportions, refined visual character, comfort
          and carefully considered details. Our aim is to
          create furniture that brings elegance, presence
          and lasting value to each interior.
        </p>

        <p>
          VIRELLAART serves private residences, prestigious
          villas and international interior projects,
          supporting customers from product selection to
          worldwide delivery.
        </p>
      </div>

      <div class="story-visual">
        <img
          src="/living-room.webp"
          alt="VIRELLAART luxury living room furniture"
          width="1200"
          height="1500"
          loading="lazy"
          decoding="async"
        />

        <div class="visual-caption">
          <span>Istanbul, Türkiye</span>

          <strong>
            Luxury Furniture Manufacturer
          </strong>
        </div>
      </div>
    </section>

    <section class="manufacturing-section">
      <div class="manufacturing-heading">
        <div>
          <span class="section-label">
            Manufacturing in Istanbul
          </span>

          <h2>
            A Manufacturer-Led Approach
            to Luxury Furniture
          </h2>
        </div>

        <div class="manufacturing-intro">
          <p>
            VIRELLAART brings design, furniture production
            expertise and international service together
            under one manufacturer identity.
          </p>

          <p>
            Our approach supports coordinated collections
            for living rooms, dining rooms, bedrooms and
            TV units while maintaining a consistent luxury
            design language across complete interiors.
          </p>
        </div>
      </div>

      <figure class="factory-visual">
        <img
          src="/about.webp"
          alt="VIRELLAART luxury furniture manufacturing vision"
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
        />

        <div class="factory-overlay"></div>

        <div class="factory-content">
          <span>
            VIRELLAART Manufacturing Vision
          </span>

          <h3>
            Production Expertise Created
            for International Markets
          </h3>

          <p>
            A professional manufacturer identity supported
            by complete collections, coordinated design and
            worldwide customer service.
          </p>
        </div>

        <figcaption>
          Concept visualization representing the
          VIRELLAART manufacturing vision.
        </figcaption>
      </figure>
    </section>

    <section class="expertise-section">
      <div class="section-heading">
        <span class="section-label">
          Our Expertise
        </span>

        <h2>
          Complete Collections for
          Distinguished Interiors
        </h2>

        <p>
          A consistent luxury design language across the
          most important spaces of an exceptional home.
        </p>
      </div>

      <div class="expertise-grid">
        <article class="expertise-card">
          <span class="card-number">01</span>

          <h3>Luxury Living Rooms</h3>

          <p>
            Statement seating collections created for
            refined residences, prestigious villas and
            sophisticated living spaces.
          </p>
        </article>

        <article class="expertise-card">
          <span class="card-number">02</span>

          <h3>Dining Room Collections</h3>

          <p>
            Coordinated dining furniture designed around
            visual harmony, elegant proportions and
            timeless luxury.
          </p>
        </article>

        <article class="expertise-card">
          <span class="card-number">03</span>

          <h3>Luxury Bedrooms</h3>

          <p>
            Distinctive bedroom collections combining
            refined character, comfort and an impressive
            interior presence.
          </p>
        </article>

        <article class="expertise-card">
          <span class="card-number">04</span>

          <h3>Custom Production</h3>

          <p>
            Personalized furniture solutions for customers
            and projects seeking a more exclusive and
            individual result.
          </p>
        </article>
      </div>
    </section>

    <section class="identity-section">
      <div class="identity-panel">
        <div class="identity-overlay"></div>

        <div class="identity-content">
          <span class="section-label">
            Our Manufacturer Identity
          </span>

          <h2>
            More Than a Furniture Seller.
            A Luxury Furniture Manufacturer.
          </h2>

          <p>
            VIRELLAART represents the direct connection
            between furniture design, production expertise
            and international service.
          </p>

          <p>
            This manufacturer-led approach allows us to
            present complete collections with a coordinated
            visual identity while supporting customers
            throughout selection, ordering and worldwide
            delivery.
          </p>
        </div>
      </div>
    </section>

    <section class="why-section">
      <div class="section-heading narrow">
        <span class="section-label">
          Why VIRELLAART
        </span>

        <h2>
          Created for Clients
          Who Expect More
        </h2>
      </div>

      <div class="why-grid">
        <article class="why-card">
          <div class="why-symbol" aria-hidden="true">
            V
          </div>

          <h3>Manufacturer Expertise</h3>

          <p>
            Direct communication with a luxury furniture
            manufacturer experienced in complete
            coordinated collections.
          </p>
        </article>

        <article class="why-card">
          <div class="why-symbol" aria-hidden="true">
            V
          </div>

          <h3>Distinctive Design</h3>

          <p>
            Furniture developed to create a recognizable,
            refined and premium atmosphere in exceptional
            interiors.
          </p>
        </article>

        <article class="why-card">
          <div class="why-symbol" aria-hidden="true">
            V
          </div>

          <h3>Complete Collections</h3>

          <p>
            Coordinated solutions for living rooms, dining
            rooms, bedrooms and TV units with consistent
            visual character.
          </p>
        </article>

        <article class="why-card">
          <div class="why-symbol" aria-hidden="true">
            V
          </div>

          <h3>Worldwide Service</h3>

          <p>
            Professional international communication and
            worldwide delivery support for customers
            across global markets.
          </p>
        </article>
      </div>
    </section>

    <section class="world-section">
      <div class="world-content">
        <span class="section-label">
          Istanbul to the World
        </span>

        <h2>
          Turkish Luxury Furniture
          for International Interiors
        </h2>

        <p>
          Discover complete VIRELLAART collections created
          for private residences, villas and distinguished
          projects around the world.
        </p>

        <div class="world-actions">
          <a
            class="primary-action"
            href={collectionsURL}
          >
            Explore Collections
          </a>

          <a
            class="secondary-action"
            href={contactURL}
          >
            Contact VIRELLAART
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 82vh;
    display: grid;
    place-items: center;
    padding: 150px 28px 90px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(
        180deg,
        rgba(12, 9, 7, 0.28),
        rgba(12, 9, 7, 0.82)
      ),
      url("/bedroom.webp") center 56% / cover no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        transparent 12%,
        rgba(0, 0, 0, 0.54) 100%
      ),
      linear-gradient(
        90deg,
        rgba(10, 8, 6, 0.42),
        transparent 34%,
        transparent 66%,
        rgba(10, 8, 6, 0.42)
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 1120px);
  }

  .eyebrow,
  .section-label {
    color: #d0a85d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .about-hero h1 {
    max-width: 1080px;
    margin: 22px auto 30px;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .about-hero h1 strong,
  .about-hero h1 em {
    display: block;
    font-weight: 400;
  }

  .about-hero h1 em {
    margin-top: 7px;
    color: #dfbf7c;
    font-style: normal;
  }

  .about-hero p {
    max-width: 780px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.85;
  }

  .about-page {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 7% 22%,
        rgba(184, 144, 76, 0.09),
        transparent 450px
      ),
      #171411;
  }

  .story-section,
  .manufacturing-section,
  .expertise-section,
  .why-section,
  .world-section {
    width: min(100% - 64px, 1380px);
    margin: 0 auto;
  }

  .story-section {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 90px;
    padding: 130px 0;
  }

  .story-content h2,
  .manufacturing-heading h2,
  .section-heading h2,
  .identity-content h2,
  .world-content h2 {
    margin: 20px 0 30px;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 70px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .story-content p,
  .manufacturing-intro p,
  .identity-content p,
  .world-content p {
    margin: 0 0 22px;
    color: #bdb2a5;
    font-size: 16px;
    line-height: 1.95;
  }

  .story-content .intro-text {
    color: #e0d6c8;
    font-size: 19px;
  }

  .story-visual {
    position: relative;
    min-height: 720px;
    overflow: hidden;
    border: 1px solid rgba(201, 165, 91, 0.26);
    background: #100e0c;
  }

  .story-visual img {
    width: 100%;
    height: 720px;
    display: block;
    object-fit: cover;
  }

  .visual-caption {
    position: absolute;
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 17px 20px;
    border: 1px solid rgba(201, 165, 91, 0.35);
    background: rgba(15, 12, 10, 0.84);
    backdrop-filter: blur(12px);
  }

  .visual-caption span {
    color: #b7aa9a;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .visual-caption strong {
    color: #ddbd78;
    font-size: 13px;
  }

  .manufacturing-section {
    padding: 20px 0 135px;
  }

  .manufacturing-heading {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    align-items: end;
    gap: 90px;
    margin-bottom: 55px;
  }

  .manufacturing-heading h2 {
    margin-bottom: 0;
  }

  .manufacturing-intro {
    padding-bottom: 4px;
  }

  .factory-visual {
    position: relative;
    min-height: 690px;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(201, 165, 91, 0.34);
    background: #100e0c;
    box-shadow: 0 36px 100px rgba(0, 0, 0, 0.34);
  }

  .factory-visual img {
    width: 100%;
    height: 690px;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .factory-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(11, 9, 7, 0.92) 0%,
        rgba(11, 9, 7, 0.62) 42%,
        rgba(11, 9, 7, 0.12) 74%
      ),
      linear-gradient(
        0deg,
        rgba(11, 9, 7, 0.75),
        transparent 58%
      );
  }

  .factory-content {
    position: absolute;
    z-index: 2;
    bottom: 70px;
    left: 65px;
    width: min(580px, calc(100% - 130px));
  }

  .factory-content span {
    color: #d3ad62;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .factory-content h3 {
    margin: 17px 0 20px;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 4vw, 58px);
    font-weight: 400;
    line-height: 1.06;
  }

  .factory-content p {
    max-width: 520px;
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 15px;
    line-height: 1.85;
  }

  .factory-visual figcaption {
    position: absolute;
    z-index: 2;
    right: 22px;
    bottom: 18px;
    color: rgba(255, 255, 255, 0.46);
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .expertise-section {
    padding: 0 0 130px;
  }

  .section-heading {
    max-width: 850px;
    margin-bottom: 55px;
  }

  .section-heading.narrow {
    max-width: 760px;
  }

  .section-heading p {
    max-width: 700px;
    margin: 0;
    color: #a99e91;
    font-size: 17px;
    line-height: 1.85;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(201, 165, 91, 0.28);
    border-left: 1px solid rgba(201, 165, 91, 0.28);
  }

  .expertise-card {
    min-height: 340px;
    padding: 38px 30px;
    border-right: 1px solid rgba(201, 165, 91, 0.28);
    border-bottom: 1px solid rgba(201, 165, 91, 0.28);
    background:
      linear-gradient(
        145deg,
        rgba(201, 165, 91, 0.08),
        transparent 58%
      ),
      #1d1915;
    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .expertise-card:hover {
    transform: translateY(-5px);
    background:
      linear-gradient(
        145deg,
        rgba(201, 165, 91, 0.15),
        transparent 65%
      ),
      #211c17;
  }

  .card-number {
    color: rgba(218, 183, 113, 0.58);
    font-family: Georgia, serif;
    font-size: 42px;
  }

  .expertise-card h3,
  .why-card h3 {
    margin: 58px 0 17px;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 27px;
    font-weight: 400;
    line-height: 1.2;
  }

  .expertise-card p,
  .why-card p {
    margin: 0;
    color: #a99d90;
    font-size: 14px;
    line-height: 1.85;
  }

  .identity-section {
    padding: 0 32px 130px;
  }

  .identity-panel {
    position: relative;
    width: min(100%, 1500px);
    min-height: 620px;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid rgba(201, 165, 91, 0.32);
    background:
      url("/dining-room.webp") center / cover no-repeat;
  }

  .identity-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(12, 10, 8, 0.96),
        rgba(12, 10, 8, 0.75) 52%,
        rgba(12, 10, 8, 0.24)
      ),
      linear-gradient(
        0deg,
        rgba(12, 10, 8, 0.85),
        transparent
      );
  }

  .identity-content {
    position: relative;
    z-index: 2;
    width: min(720px, 100%);
    padding: 85px;
  }

  .identity-content h2 {
    margin-bottom: 30px;
  }

  .why-section {
    padding: 0 0 130px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .why-card {
    min-height: 285px;
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: #1c1814;
  }

  .why-symbol {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(201, 165, 91, 0.56);
    border-radius: 50%;
    color: #d8b66d;
    font-family: Georgia, serif;
    font-size: 21px;
  }

  .why-card h3 {
    margin-top: 42px;
  }

  .world-section {
    padding: 0 0 140px;
  }

  .world-content {
    padding: 100px 70px;
    text-align: center;
    border-top: 1px solid rgba(201, 165, 91, 0.26);
    border-bottom: 1px solid rgba(201, 165, 91, 0.26);
    background:
      radial-gradient(
        circle at center,
        rgba(201, 165, 91, 0.12),
        transparent 60%
      );
  }

  .world-content h2 {
    max-width: 900px;
    margin-right: auto;
    margin-left: auto;
  }

  .world-content p {
    max-width: 730px;
    margin: 0 auto;
  }

  .world-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 38px;
  }

  .primary-action,
  .secondary-action {
    min-width: 210px;
    padding: 17px 24px;
    border: 1px solid #bc9856;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .primary-action {
    background: #bc9856;
    color: #111;
  }

  .secondary-action {
    background: transparent;
    color: #d6b46e;
  }

  .primary-action:hover {
    background: #d0ae68;
  }

  .secondary-action:hover {
    background: #bc9856;
    color: #111;
  }

  @media (max-width: 1100px) {
    .manufacturing-heading {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .manufacturing-intro {
      max-width: 760px;
    }

    .expertise-grid,
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .about-hero {
      min-height: 72vh;
      padding: 130px 22px 75px;
    }

    .story-section,
    .manufacturing-section,
    .expertise-section,
    .why-section,
    .world-section {
      width: min(100% - 36px, 1380px);
    }

    .story-section {
      grid-template-columns: 1fr;
      gap: 50px;
      padding: 95px 0;
    }

    .story-visual,
    .story-visual img {
      min-height: 0;
      height: 570px;
    }

    .manufacturing-section {
      padding-bottom: 100px;
    }

    .factory-visual,
    .factory-visual img {
      min-height: 0;
      height: 570px;
    }

    .factory-content {
      bottom: 55px;
      left: 42px;
      width: min(560px, calc(100% - 84px));
    }

    .identity-section {
      padding: 0 18px 95px;
    }

    .identity-content {
      padding: 60px 38px;
    }

    .expertise-section,
    .why-section {
      padding-bottom: 95px;
    }

    .world-section {
      padding-bottom: 100px;
    }

    .world-content {
      padding: 75px 35px;
    }
  }

  @media (max-width: 620px) {
    .about-hero {
      min-height: 68vh;
      padding: 120px 18px 65px;
      background-position: 56% center;
    }

    .about-hero h1 {
      font-size: clamp(42px, 13vw, 61px);
    }

    .story-section,
    .manufacturing-section,
    .expertise-section,
    .why-section,
    .world-section {
      width: min(100% - 28px, 1380px);
    }

    .story-section {
      padding: 75px 0;
    }

    .story-content h2,
    .manufacturing-heading h2,
    .section-heading h2,
    .identity-content h2,
    .world-content h2 {
      font-size: clamp(35px, 11vw, 49px);
    }

    .story-content p,
    .manufacturing-intro p,
    .identity-content p,
    .world-content p {
      font-size: 15px;
      line-height: 1.85;
    }

    .story-content .intro-text {
      font-size: 17px;
    }

    .story-visual,
    .story-visual img {
      height: 440px;
    }

    .visual-caption {
      right: 12px;
      bottom: 12px;
      left: 12px;
      display: grid;
      gap: 5px;
      padding: 14px;
    }

    .manufacturing-section {
      padding-top: 0;
      padding-bottom: 80px;
    }

    .factory-visual,
    .factory-visual img {
      height: 620px;
    }

    .factory-visual img {
      object-position: 58% center;
    }

    .factory-overlay {
      background:
