const aboutSeoEntry =
  aboutSeo[
    language as keyof typeof aboutSeo
  ] ?? aboutSeo.en;

const detailed = isDetailedLanguage
  ? detailedCopy[language as "en" | "tr"]
  : null;

const homeURL = localizedPath("/", language);
const contactURL = localizedPath("/contact", language);
const collectionsURL = `${homeURL}#collections`;

const whatsappNumber = "905539478608";
const siteOrigin = "https://www.virellaart.com";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const fallbackWhatsappMessage = translations.product.whatsappMessage.replace(
  "{product}",
  "VIRELLAART",
);
const whatsappMessage = [
  detailed?.whatsappMessage ?? fallbackWhatsappMessage,
  "",
  getProjectQuotePrompt(language),
  "",
  canonicalURL,
].join("\n");
const whatsappURL =
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
    whatsappMessage,
  )}`;

const pageTitle = aboutSeoEntry.title;
const pageDescription = aboutSeoEntry.description;
const imageAlt = detailed?.alts.factory ?? translations.about.imageAlt;

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: pageTitle,
  url: canonicalURL,
  description: pageDescription,
  inLanguage: language,
  mainEntity: {
    "@type": "Organization",
    "@id": "https://www.virellaart.com/#organization",
    name: "VIRELLAART",
    url: "https://www.virellaart.com",
    description: pageDescription,
    areaServed: "Worldwide",
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/living-room.webp"
  imageAlt={imageAlt}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(aboutPageSchema)}
  />

  {
    detailed ? (
      <div class="about-page">
        <section class="hero-section">
          <img
            class="hero-image"
            src="/living-room.webp"
            sizes="100vw"
            alt={detailed.alts.factory}
            width="1448"
            height="1086"
            fetchpriority="high"
            decoding="async"
          />

          <div class="hero-shade"></div>

          <div class="hero-content">
            <span class="eyebrow">{detailed.heroEyebrow}</span>

            <h1>
              {detailed.heroOne}
              <strong>{detailed.heroTwo}</strong>
              <em>{detailed.heroThree}</em>
            </h1>

            <div class="gold-line"></div>
            <p>{detailed.heroBody}</p>

            <div class="hero-actions">
              <a class="primary-button" href={collectionsURL}>
                {detailed.explore}
              </a>

              <a class="secondary-button" href={contactURL}>
                {detailed.contact}
              </a>
            </div>
          </div>

          <span class="hero-caption">{detailed.heroCaption}</span>
        </section>

        <section class="story-section section-shell">
          <div class="story-copy">
            <span class="section-label">{detailed.storyLabel}</span>
            <h2>{detailed.storyTitle}</h2>
            <div class="small-line"></div>
            <p class="lead-text">{detailed.storyLead}</p>
            <p>{detailed.storyBodyOne}</p>
            <p>{detailed.storyBodyTwo}</p>
          </div>

          <figure class="story-visual">
            <img
              src="/about-design.webp"
              alt={detailed.alts.design}
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              {detailed.designCaption}
              <span>{detailed.designCaptionDetail}</span>
            </figcaption>
          </figure>
        </section>

        <section class="craft-section">
          <div class="section-shell">
            <div class="section-heading">
              <span class="section-label">{detailed.craftLabel}</span>
              <h2>{detailed.craftTitle}</h2>
              <p>{detailed.craftIntro}</p>
            </div>

            <div class="craft-grid">
              <article class="craft-card">
                <div class="craft-image">
                  <img
                    src="/about-carving.webp"
                    alt={detailed.alts.carving}
                    width="1536"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="craft-copy">
                  <span>{detailed.carvingLabel}</span>
                  <h3>{detailed.carvingTitle}</h3>
                  <p>{detailed.carvingBody}</p>
                </div>
              </article>

              <article class="craft-card">
                <div class="craft-image">
                  <img
                    src="/about-upholstery.webp"
                    alt={detailed.alts.upholstery}
                    width="1536"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="craft-copy">
                  <span>{detailed.upholsteryLabel}</span>
                  <h3>{detailed.upholsteryTitle}</h3>
                  <p>{detailed.upholsteryBody}</p>
                </div>
              </article>
            </div>
          </div>
        </section>

        <section class="process-section section-shell">
          <div class="section-heading process-heading">
            <span class="section-label">{detailed.processLabel}</span>
            <h2>{detailed.processTitle}</h2>
          </div>

          <div class="process-grid">
            {detailed.processItems.map((item, index) => (
              <article class="process-card">
                <span class="process-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="quality-section">
          <div class="quality-layout section-shell">
            <figure class="quality-visual">
              <img
                src="/about-quality.webp"
                alt={detailed.alts.quality}
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{detailed.qualityCaption}</figcaption>
            </figure>

            <div class="quality-copy">
              <span class="section-label">{detailed.qualityLabel}</span>
              <h2>{detailed.qualityTitle}</h2>
              <div class="small-line"></div>
              <p>{detailed.qualityBodyOne}</p>
              <p>{detailed.qualityBodyTwo}</p>

              <div class="quality-points">
                {detailed.qualityPoints.map((point) => (
