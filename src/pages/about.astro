---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLanguageFromPath,
  getTranslations,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
---

<BaseLayout
  title={translations.about.title}
  description={translations.about.description}
>

  <section class="about-hero">
    <div class="about-overlay"></div>

    <div class="about-content">
      <span>{translations.about.eyebrow}</span>

      <h1>{translations.about.hero}</h1>

      <p>
        {translations.about.lead}
      </p>
    </div>
  </section>

  <section class="about-section">
    <div class="about-grid">

      <div class="about-text">
        <span>{translations.about.story}</span>

        <h2>{translations.about.heading}</h2>

        <p>
          {translations.about.paragraphOne}
        </p>

        <p>
          {translations.about.paragraphTwo}
        </p>
      </div>

      <div class="about-image">
        <img src="/living-room.webp" alt={translations.about.imageAlt} />
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .about-hero {
    position: relative;
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 140px 30px 80px;
    text-align: center;
    background:
      linear-gradient(rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.58)),
      url("/bedroom.webp") center / cover no-repeat;
  }

  .about-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0) 24%,
        rgba(0, 0, 0, 0.42) 100%
      );
  }

  .about-content {
    position: relative;
    z-index: 2;
    width: min(100%, 920px);
  }

  .about-content span,
  .about-text span {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .about-content h1 {
    margin: 20px 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(50px, 8vw, 108px);
    font-weight: 400;
    line-height: 1;
  }

  .about-content p {
    max-width: 760px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.8;
  }

  .about-section {
    width: min(100% - 64px, var(--container));
    margin: 0 auto;
    padding: 120px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 70px;
  }

  .about-text h2 {
    margin: 20px 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 70px);
    font-weight: 400;
    line-height: 1.08;
  }

  .about-text p {
    margin-bottom: 22px;
    color: var(--gray);
    font-size: 17px;
    line-height: 1.9;
  }

  .about-image {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .about-image img {
    width: 100%;
    height: 680px;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 900px) {
    .about-section {
      width: min(100% - 36px, var(--container));
      padding: 90px 0;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .about-image img {
      height: 520px;
    }
  }

  @media (max-width: 560px) {
    .about-hero {
      min-height: 70vh;
      padding: 120px 20px 60px;
    }

    .about-section {
      width: min(100% - 24px, var(--container));
      padding: 72px 0;
    }

    .about-image img {
      height: 420px;
    }
  }
</style>
