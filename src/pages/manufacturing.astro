---
import BaseLayout from "../layouts/BaseLayout.astro";

import {
  getLanguageFromPath,
  localizedPath,
} from "../i18n/config";

import {
  getManufacturingContent,
} from "../i18n/manufacturing";

const language =
  getLanguageFromPath(Astro.url.pathname);

const content =
  getManufacturingContent(language);

const processImages = [
  "/about-design.webp",
  "/about-carving.webp",
  "/about-upholstery.webp",
  "/about-quality.webp",
] as const;

const processCards =
  content.process.cards.map((card, index) => ({
    ...card,
    image:
      processImages[index] ??
      processImages[0],
  }));

const heroWhatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(
    content.hero.whatsappMessage,
  )}`;

const ctaWhatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(
    content.cta.whatsappMessage,
  )}`;
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  image="/about-factory.webp"
  imageAlt={content.hero.imageAlt}
>
  <div class="manufacturing-page">
    <section class="hero">
      <img
        class="hero-image"
        src="/about-factory.webp"
        srcset="/about-factory-640.webp 640w, /about-factory-1000.webp 1000w, /about-factory.webp 1448w"
        sizes="100vw"
        alt={content.hero.imageAlt}
        width="1448"
        height="1086"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <div class="hero-overlay"></div>

      <div class="hero-content">
        <span class="eyebrow">
          {content.hero.eyebrow}
        </span>

        <h1>
          {content.hero.title}

          <strong>
            {content.hero.highlight}
          </strong>
        </h1>

        <p>
          {content.hero.description}
        </p>

        <div class="hero-buttons">
          <a
            class="button button-primary"
            href="#production-process"
          >
            {content.hero.processButton}
          </a>

          <a
            class="button button-outline"
            href={heroWhatsappURL}
            target="_blank"
            rel="noopener noreferrer"
            data-whatsapp-context="manufacturing-hero"
            data-product="Manufacturing"
          >
            {content.hero.projectButton}
          </a>
        </div>
      </div>

      <div class="hero-footer">
        <span>
          {content.hero.location}
        </span>

        <span>
          {content.hero.manufacturer}
        </span>
      </div>
    </section>

    <section class="manufacturer-intro section-shell">
      <div class="section-heading">
        <span class="eyebrow">
          {content.intro.eyebrow}
        </span>

        <h2>
          {content.intro.title}

          <strong>
            {content.intro.highlight}
          </strong>
        </h2>
      </div>

      <div class="intro-layout">
        <div class="intro-copy">
          <p class="lead">
            {content.intro.lead}
          </p>

          {
            content.intro.paragraphs.map(
              (paragraph) => (
                <p>{paragraph}</p>
              ),
            )
          }

          <div class="intro-facts">
            {
              content.intro.facts.map(
                (fact) => (
                  <div>
                    <span>
                      {fact.label}
                    </span>

                    <strong>
                      {fact.value}
                    </strong>
                  </div>
                ),
              )
            }
          </div>
        </div>

        <figure class="intro-visual">
          <img
            src="/about-design.webp"
            alt={content.intro.imageAlt}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />

          <figcaption>
            <span>
              {content.intro.imageLabel}
            </span>

            <strong>
              {content.intro.imageCaption}
            </strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section
      class="process-section section-shell"
      id="production-process"
    >
      <div class="section-heading process-heading">
        <span class="eyebrow">
          {content.process.eyebrow}
        </span>

        <h2>
          {content.process.title}

          <strong>
            {content.process.highlight}
          </strong>
        </h2>

        <p>
          {content.process.description}
        </p>
      </div>

      <div class="process-grid">
        {
          processCards.map((process) => (
            <article class="process-card">
              <div class="process-image">
                <img
                  src={process.image}
                  alt={process.alt}
                  width="900"
                  height="1050"
                  loading="lazy"
                  decoding="async"
                />

                <span>
                  {process.number}
                </span>
              </div>

              <div class="process-copy">
                <small>
                  {process.label}
                </small>

                <h3>
                  {process.title}
                </h3>

                <p>
                  {process.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="production-flow section-shell">
      <div class="section-heading">
        <span class="eyebrow">
          {content.flow.eyebrow}
        </span>

        <h2>
          {content.flow.title}

          <strong>
            {content.flow.highlight}
          </strong>
        </h2>
      </div>

      <div class="flow-grid">
        {
          content.flow.steps.map((step) => (
            <article class="flow-card">
              <span>
                {step.number}
              </span>

              <h3>
                {step.title}
              </h3>

              <p>
                {step.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="quality-section section-shell">
      <figure class="feature-visual">
        <img
          src="/about-quality.webp"
          alt={content.quality.imageAlt}
          width="1200"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="feature-copy">
        <span class="eyebrow">
          {content.quality.eyebrow}
        </span>

        <h2>
          {content.quality.title}

          <strong>
            {content.quality.highlight}
          </strong>
        </h2>

        <p>
          {content.quality.description}
        </p>

        <ul>
          {
            content.quality.items.map(
              (item) => (
                <li>{item}</li>
              ),
            )
          }
        </ul>
      </div>
    </section>

    <section class="shipping-section section-shell">
      <div class="feature-copy shipping-copy">
        <span class="eyebrow">
          {content.shipping.eyebrow}
        </span>

        <h2>
          {content.shipping.title}

          <strong>
            {content.shipping.highlight}
          </strong>
        </h2>

        {
          content.shipping.paragraphs.map(
            (paragraph) => (
              <p>{paragraph}</p>
            ),
          )
        }

        <a
          class="text-link"
          href="/policies/shipping-policy/"
        >
          {content.shipping.policyButton}
        </a>
      </div>

      <figure class="feature-visual shipping-visual">
        <img
          src="/about-shipping.webp"
          alt={content.shipping.imageAlt}
          width="1000"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <section class="benefits-section section-shell">
      <div class="section-heading">
        <span class="eyebrow">
          {content.benefits.eyebrow}
        </span>

        <h2>
          {content.benefits.title}

          <strong>
            {content.benefits.highlight}
          </strong>
        </h2>
      </div>

      <div class="benefits-grid">
        {
          content.benefits.cards.map(
            (benefit) => (
              <article class="benefit-card">
                <span>V</span>

                <h3>
                  {benefit.title}
                </h3>

                <p>
                  {benefit.description}
                </p>
              </article>
            ),
          )
        }
      </div>
    </section>

    <section class="manufacturing-cta section-shell">
      <div>
        <span class="eyebrow">
          {content.cta.eyebrow}
        </span>

        <h2>
          {content.cta.title}

          <strong>
            {content.cta.highlight}
          </strong>
        </h2>

        <p>
          {content.cta.description}
        </p>
      </div>

      <div class="cta-actions">
        <a
          class="button button-primary"
          href={ctaWhatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="manufacturing-final"
          data-product="Manufacturing"
        >
          {content.cta.whatsappButton}
        </a>

        <a
          class="button button-outline"
          href={localizedPath(
            "/living-rooms",
            language,
          )}
        >
          {content.cta.collectionsButton}
        </a>
      </div>
    </section>

    <p class="visual-disclosure">
      {content.disclosure}
    </p>
  </div>
</BaseLayout>

<style>
  .manufacturing-page {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 10% 18%,
        rgba(190, 148, 75, 0.07),
        transparent 460px
      ),
      #15120f;
  }

  .section-shell {
    width: min(100% - 64px, 1240px);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    min-height: 780px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(190, 148, 75, 0.28);
    background: #0e0c0a;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8, 7, 6, 0.97) 0%,
        rgba(8, 7, 6, 0.86) 37%,
        rgba(8, 7, 6, 0.34) 72%,
        rgba(8, 7, 6, 0.16) 100%
      ),
      linear-gradient(
        0deg,
        rgba(8, 7, 6, 0.62),
        transparent 58%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100% - 64px, 1240px);
    margin: 0 auto;
    padding: 190px 0 125px;
  }

  .hero-content h1 {
    max-width: 820px;
    margin: 25px 0 30px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(52px, 7vw, 92px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-content h1 strong,
  .section-heading h2 strong,
  .feature-copy h2 strong,
  .manufacturing-cta h2 strong {
    display: block;
    color: var(--gold-light);
    font-weight: 400;
  }

  .hero-content > p {
    max-width: 700px;
    margin: 0;
    color: rgba(248, 241, 230, 0.77);
    font-size: 17px;
    line-height: 1.85;
  }

  .hero-buttons,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .button {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border: 1px solid var(--gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: center;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .button-primary {
    background: var(--gold);
    color: #11100e;
  }

  .button-primary:hover {
    background: transparent;
    color: var(--gold-light);
  }

  .button-outline {
    color: var(--gold-light);
  }

  .button-outline:hover {
    background: var(--gold);
    color: #11100e;
  }

  .hero-footer {
    position: absolute;
    z-index: 2;
    right: 32px;
    bottom: 24px;
    left: 32px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .manufacturer-intro,
  .process-section,
  .production-flow,
  .quality-section,
  .shipping-section,
  .benefits-section {
    padding: 115px 0;
  }

  .section-heading {
    max-width: 900px;
  }

  .section-heading h2,
  .feature-copy h2,
  .manufacturing-cta h2 {
    margin: 20px 0 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 5.8vw, 72px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(440px, 1.08fr);
    align-items: center;
    gap: 85px;
    margin-top: 65px;
  }

  .intro-copy p {
    color: rgba(245, 239, 230, 0.66);
    font-size: 15px;
    line-height: 1.9;
  }

  .intro-copy .lead {
    color: #eee4d7;
    font-size: 19px;
  }

  .intro-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 42px;
    border-top: 1px solid rgba(190, 148, 75, 0.25);
    border-left: 1px solid rgba(190, 148, 75, 0.25);
  }

  .intro-facts div {
    min-height: 132px;
    display: flex;
    flex-direction: column;
    gap: 17px;
    padding: 24px;
    border-right: 1px solid rgba(190, 148, 75, 0.25);
    border-bottom: 1px solid rgba(190, 148, 75, 0.25);
  }

  .intro-facts span {
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .intro-facts strong {
    color: #ffffff;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
  }

  .intro-visual,
  .feature-visual {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(190, 148, 75, 0.3);
  }

  .intro-visual img {
    width: 100%;
    min-height: 620px;
    display: block;
    object-fit: cover;
  }

  .intro-visual figcaption {
    position: absolute;
    right: 22px;
    bottom: 22px;
    left: 22px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 20px;
    background: rgba(13, 11, 9, 0.92);
    backdrop-filter: blur(8px);
  }

  .intro-visual figcaption span {
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .intro-visual figcaption strong {
    color: #ffffff;
    font-size: 11px;
    font-weight: 400;
    text-align: right;
  }

  .process-section,
  .quality-section,
  .shipping-section,
  .benefits-section {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .process-heading > p {
    max-width: 690px;
    margin: 26px 0 0;
    color: rgba(245, 239, 230, 0.64);
    font-size: 16px;
    line-height: 1.8;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 70px;
  }

  .process-card {
    overflow: hidden;
    border: 1px solid rgba(190, 148, 75, 0.25);
    background: #1a1612;
  }

  .process-image {
    position: relative;
    height: 500px;
    overflow: hidden;
  }

  .process-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .process-card:hover .process-image img {
    transform: scale(1.025);
  }

  .process-image > span {
    position: absolute;
    top: 22px;
    left: 22px;
    min-width: 52px;
    min-height: 52px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    background: rgba(12, 10, 8, 0.82);
    color: var(--gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
  }

  .process-copy {
    padding: 35px;
  }

  .process-copy small {
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .process-copy h3 {
    margin: 16px 0 18px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.12;
  }

  .process-copy p {
    margin: 0;
    color: rgba(245, 239, 230, 0.63);
    font-size: 14px;
    line-height: 1.85;
  }

  .production-flow {
    padding-top: 45px;
  }

  .flow-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 60px;
    border-top: 1px solid rgba(190, 148, 75, 0.28);
    border-left: 1px solid rgba(190, 148, 75, 0.28);
  }

  .flow-card {
    min-height: 285px;
    padding: 32px;
    border-right: 1px solid rgba(190, 148, 75, 0.28);
    border-bottom: 1px solid rgba(190, 148, 75, 0.28);
    background: rgba(255, 255, 255, 0.015);
  }

  .flow-card > span {
    color: var(--gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
  }

  .flow-card h3 {
    margin: 45px 0 17px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.15;
  }

  .flow-card p {
    margin: 0;
    color: rgba(245, 239, 230, 0.59);
    font-size: 13px;
    line-height: 1.8;
  }

  .quality-section,
  .shipping-section {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 90px;
  }

  .feature-visual img {
    width: 100%;
    height: 650px;
    display: block;
    object-fit: cover;
  }

  .feature-copy p,
  .manufacturing-cta p {
    color: rgba(245, 239, 230, 0.65);
    font-size: 15px;
    line-height: 1.9;
  }

  .feature-copy ul {
    display: grid;
    gap: 13px;
    margin: 35px 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-copy li {
    position: relative;
    padding: 15px 18px 15px 43px;
    border: 1px solid rgba(190, 148, 75, 0.18);
    color: rgba(245, 239, 230, 0.75);
    font-size: 13px;
  }

  .feature-copy li::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 19px;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
    transform: translateY(-50%) rotate(45deg);
  }

  .shipping-section {
    background:
      linear-gradient(
        90deg,
        rgba(190, 148, 75, 0.035),
        transparent 58%
      );
  }

  .text-link {
    display: inline-flex;
    margin-top: 24px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--gold);
    color: var(--gold-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 60px;
  }

  .benefit-card {
    min-height: 285px;
    padding: 30px;
    border: 1px solid rgba(190, 148, 75, 0.24);
    background: #1a1612;
  }

  .benefit-card > span {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
  }

  .benefit-card h3 {
    margin: 38px 0 17px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.15;
  }

  .benefit-card p {
    margin: 0;
    color: rgba(245, 239, 230, 0.6);
    font-size: 13px;
    line-height: 1.8;
  }

  .manufacturing-cta {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    align-items: end;
    gap: 70px;
    margin-top: 20px;
    margin-bottom: 100px;
    padding: 75px;
    border: 1px solid rgba(190, 148, 75, 0.35);
    background:
      linear-gradient(
        125deg,
        rgba(190, 148, 75, 0.1),
        transparent 58%
      ),
      #1a1612;
  }

  .manufacturing-cta h2 {
    font-size: clamp(42px, 5vw, 66px);
  }

  .manufacturing-cta p {
    max-width: 690px;
  }

  .cta-actions {
    min-width: 250px;
    flex-direction: column;
  }

  .visual-disclosure {
    width: min(100% - 64px, 1240px);
    margin: -55px auto 70px;
    color: rgba(255, 255, 255, 0.33);
    font-size: 10px;
    line-height: 1.7;
    text-align: center;
  }

  @media (max-width: 1050px) {
    .intro-layout,
    .quality-section,
    .shipping-section {
      grid-template-columns: 1fr;
    }

    .intro-visual img {
      min-height: 540px;
    }

    .flow-grid,
    .benefits-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shipping-copy {
      order: 2;
    }

    .shipping-visual {
      order: 1;
    }

    .manufacturing-cta {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .cta-actions {
      min-width: 0;
      flex-direction: row;
    }
  }

  @media (max-width: 760px) {
    .section-shell {
      width: min(100% - 36px, 1240px);
    }

    .hero {
      min-height: 720px;
    }

    .hero-content {
      width: min(100% - 36px, 1240px);
      padding: 155px 0 115px;
    }

    .hero-content h1 {
      font-size: clamp(48px, 14vw, 68px);
    }

    .hero-footer {
      right: 18px;
      left: 18px;
