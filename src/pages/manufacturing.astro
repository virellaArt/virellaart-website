---
import BaseLayout from "../layouts/BaseLayout.astro";

const processCards = [
  {
    number: "01",
    label: "Design Development",
    title: "Furniture Designed Around Complete Interiors",
    description:
      "Every VIRELLAART collection begins with proportion, function, visual harmony and coordinated product planning. Our design approach focuses on complete living rooms, dining rooms, bedrooms and TV unit collections for distinguished interiors.",
    image: "/about-design.webp",
    alt: "VIRELLAART luxury furniture design development in Istanbul",
  },
  {
    number: "02",
    label: "Decorative Craftsmanship",
    title: "Detailed Carving and Statement-Making Forms",
    description:
      "Decorative forms and carved details are developed with close attention to balance, depth and overall visual character. Every component is considered as part of the complete furniture collection.",
    image: "/about-carving.webp",
    alt: "Decorative carving during luxury furniture production",
  },
  {
    number: "03",
    label: "Upholstery and Finishing",
    title: "Comfort Refined Through Every Detail",
    description:
      "Upholstery preparation combines structural comfort, carefully selected fabrics, detailed stitching and decorative finishing appropriate to the character of each collection.",
    image: "/about-upholstery.webp",
    alt: "Luxury furniture upholstery and finishing process",
  },
  {
    number: "04",
    label: "Quality Control",
    title: "Every Collection Reviewed Before Packaging",
    description:
      "Completed furniture is visually reviewed before protective packaging. Decorative surfaces, upholstery, coordinated pieces and overall presentation are checked before transportation.",
    image: "/about-quality.webp",
    alt: "VIRELLAART luxury furniture quality inspection",
  },
];

const productionSteps = [
  {
    number: "01",
    title: "Design Review",
    description:
      "Collection details, dimensions, selected options and project requirements are reviewed before production preparation.",
  },
  {
    number: "02",
    title: "Production Preparation",
    description:
      "Structural, decorative and upholstery components are prepared according to the confirmed furniture collection.",
  },
  {
    number: "03",
    title: "Craftsmanship and Finishing",
    description:
      "Assembly, decorative detailing, upholstery and finishing processes are completed with attention to visual consistency.",
  },
  {
    number: "04",
    title: "Inspection and Packaging",
    description:
      "The completed collection is reviewed and prepared with protective packaging suitable for transportation.",
  },
];

const manufacturerBenefits = [
  {
    title: "Manufacturer-Direct Communication",
    description:
      "Communicate directly with an Istanbul-based luxury furniture manufacturer throughout collection selection and order preparation.",
  },
  {
    title: "Complete Coordinated Collections",
    description:
      "Living room, dining room, bedroom and TV unit collections developed with a consistent design identity.",
  },
  {
    title: "Customization Support",
    description:
      "Selected customization possibilities can be reviewed according to the collection and project requirements.",
  },
  {
    title: "Worldwide Delivery Assistance",
    description:
      "Professional assistance for protective packaging, transportation planning and international delivery.",
  },
];
---

<BaseLayout
  title="Luxury Furniture Manufacturing in Istanbul | VIRELLAART"
  description="Discover VIRELLAART luxury furniture manufacturing in Istanbul, including design development, decorative craftsmanship, upholstery, quality control, protective packaging and worldwide delivery."
>
  <main class="manufacturing-page">
    <section class="hero">
      <img
        class="hero-image"
        src="/about-factory.webp"
        alt="VIRELLAART luxury furniture manufacturing facility in Istanbul"
        width="1600"
        height="1000"
        loading="eager"
      />

      <div class="hero-overlay"></div>

      <div class="hero-content">
        <span class="eyebrow">VIRELLAART Manufacturing</span>

        <h1>
          Luxury Furniture Manufacturing
          <strong>From Istanbul to the World</strong>
        </h1>

        <p>
          VIRELLAART brings furniture design, production expertise, detailed
          craftsmanship and international service together for luxury
          residences, villas and distinguished interior projects worldwide.
        </p>

        <div class="hero-buttons">
          <a class="button button-primary" href="#production-process">
            Explore Our Process
          </a>

          <a
            class="button button-outline"
            href="https://wa.me/905539478608?text=Hello%20VIRELLAART%2C%20I%20would%20like%20to%20receive%20information%20about%20your%20luxury%20furniture%20manufacturing%20services."
            target="_blank"
            rel="noopener noreferrer"
          >
            Discuss Your Project
          </a>
        </div>
      </div>

      <div class="hero-footer">
        <span>Istanbul, Türkiye</span>
        <span>Luxury Furniture Manufacturer</span>
      </div>
    </section>

    <section class="manufacturer-intro section-shell">
      <div class="section-heading">
        <span class="eyebrow">Direct Manufacturer</span>

        <h2>
          More Than a Furniture Seller
          <strong>A Manufacturer-Led Experience</strong>
        </h2>
      </div>

      <div class="intro-layout">
        <div class="intro-copy">
          <p class="lead">
            VIRELLAART is an Istanbul-based luxury furniture manufacturer
            developing complete collections for refined residences, villas and
            private interiors.
          </p>

          <p>
            Our work extends beyond presenting individual products. We develop
            coordinated living room, dining room, bedroom and TV unit
            collections with a consistent visual identity.
          </p>

          <p>
            From the first product enquiry to production preparation, quality
            review, protective packaging and international delivery planning,
            our team supports customers throughout the process.
          </p>

          <div class="intro-facts">
            <div>
              <span>Based in</span>
              <strong>Istanbul, Türkiye</strong>
            </div>

            <div>
              <span>Specialization</span>
              <strong>Luxury Furniture Collections</strong>
            </div>

            <div>
              <span>Customer Profile</span>
              <strong>Private and International Clients</strong>
            </div>

            <div>
              <span>Service</span>
              <strong>Worldwide Delivery Assistance</strong>
            </div>
          </div>
        </div>

        <figure class="intro-visual">
          <img
            src="/about-design.webp"
            alt="VIRELLAART luxury furniture design and production planning"
            width="1200"
            height="900"
            loading="lazy"
          />

          <figcaption>
            <span>Design Development</span>
            <strong>Collections planned for complete luxury interiors</strong>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="process-section section-shell" id="production-process">
      <div class="section-heading process-heading">
        <span class="eyebrow">Our Manufacturing Approach</span>

        <h2>
          Precision Behind
          <strong>Every Collection</strong>
        </h2>

        <p>
          Each stage contributes to the appearance, comfort, consistency and
          final presentation of the completed furniture collection.
        </p>
      </div>

      <div class="process-grid">
        {
          processCards.map((process) => (
            <article class="process-card">
              <div class="process-image">
                <img
                  src={process.image}
                  alt={process.alt}
                  width="900"
                  height="1050"
                  loading="lazy"
                />

                <span>{process.number}</span>
              </div>

              <div class="process-copy">
                <small>{process.label}</small>
                <h3>{process.title}</h3>
                <p>{process.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="production-flow section-shell">
      <div class="section-heading">
        <span class="eyebrow">From Design to Delivery</span>

        <h2>
          A Structured Process
          <strong>Created for Confidence</strong>
        </h2>
      </div>

      <div class="flow-grid">
        {
          productionSteps.map((step) => (
            <article class="flow-card">
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="quality-section section-shell">
      <figure class="feature-visual">
        <img
          src="/about-quality.webp"
          alt="VIRELLAART furniture inspection before protective packaging"
          width="1200"
          height="1000"
          loading="lazy"
        />
      </figure>

      <div class="feature-copy">
        <span class="eyebrow">Quality Before Dispatch</span>

        <h2>
          Every Detail Reviewed
          <strong>Before Packaging</strong>
        </h2>

        <p>
          Completed furniture is reviewed before it is prepared for shipment.
          The objective is to identify visible issues and verify the coordinated
          presentation of the collection before protective packaging.
        </p>

        <ul>
          <li>Visual review of decorative surfaces</li>
          <li>Inspection of upholstery and finishing details</li>
          <li>Review of coordinated collection pieces</li>
          <li>Preparation for protective packaging</li>
        </ul>
      </div>
    </section>

    <section class="shipping-section section-shell">
      <div class="feature-copy shipping-copy">
        <span class="eyebrow">International Delivery</span>

        <h2>
          Protective Packaging and
          <strong>Worldwide Shipping Support</strong>
        </h2>

        <p>
          Furniture collections are prepared for transportation using
          protective packaging selected according to product form, finished
          surfaces and decorative details.
        </p>

        <p>
          Shipping arrangements, delivery periods and costs are reviewed
          according to the selected collection and destination.
        </p>

        <a class="text-link" href="/policies/shipping-policy/">
          Review Our Shipping Policy
        </a>
      </div>

      <figure class="feature-visual shipping-visual">
        <img
          src="/about-shipping.webp"
          alt="VIRELLAART protective furniture packaging and shipping preparation"
          width="1000"
          height="1200"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="benefits-section section-shell">
      <div class="section-heading">
        <span class="eyebrow">Why VIRELLAART</span>

        <h2>
          A Manufacturer-Led
          <strong>Customer Experience</strong>
        </h2>
      </div>

      <div class="benefits-grid">
        {
          manufacturerBenefits.map((benefit) => (
            <article class="benefit-card">
              <span>V</span>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="manufacturing-cta section-shell">
      <div>
        <span class="eyebrow">Private Residences and Interior Projects</span>

        <h2>
          Looking for a Manufacturer
          <strong>for Your Luxury Interior?</strong>
        </h2>

        <p>
          Contact VIRELLAART to discuss collection selection, customization,
          production preparation and international delivery.
        </p>
      </div>

      <div class="cta-actions">
        <a
          class="button button-primary"
          href="https://wa.me/905539478608?text=Hello%20VIRELLAART%2C%20I%20would%20like%20to%20discuss%20a%20luxury%20furniture%20project."
          target="_blank"
          rel="noopener noreferrer"
        >
          Contact on WhatsApp
        </a>

        <a class="button button-outline" href="/living-rooms/">
          Explore Collections
        </a>
      </div>
    </section>

    <p class="visual-disclosure">
      Production imagery on this page illustrates the VIRELLAART manufacturing
      process and may be expanded with additional original factory photography
      and video.
    </p>
  </main>
</BaseLayout>

<style>
  .manufacturing-page {
    overflow: hidden;
    background:
      radial-gradient(
        circle at 10% 18%,
        rgba(190, 148, 75, 0.07),
        transparent 460px
      ),
      #15120f;
  }

  .section-shell {
    width: min(100% - 64px, 1240px);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    min-height: 780px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(190, 148, 75, 0.28);
    background: #0e0c0a;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8, 7, 6, 0.97) 0%,
        rgba(8, 7, 6, 0.86) 37%,
        rgba(8, 7, 6, 0.34) 72%,
        rgba(8, 7, 6, 0.16) 100%
      ),
      linear-gradient(
        0deg,
        rgba(8, 7, 6, 0.62),
        transparent 58%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100% - 64px, 1240px);
    margin: 0 auto;
    padding: 190px 0 125px;
  }

  .hero-content h1 {
    max-width: 820px;
    margin: 25px 0 30px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(52px, 7vw, 92px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hero-content h1 strong,
  .section-heading h2 strong,
  .feature-copy h2 strong,
  .manufacturing-cta h2 strong {
    display: block;
    color: var(--gold-light);
    font-weight: 400;
  }

  .hero-content > p {
    max-width: 700px;
    margin: 0;
    color: rgba(248, 241, 230, 0.77);
    font-size: 17px;
    line-height: 1.85;
  }

  .hero-buttons,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .button {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 24px;
    border: 1px solid var(--gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: center;
    text-transform: uppercase;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .button-primary {
    background: var(--gold);
    color: #11100e;
  }

  .button-primary:hover {
    background: transparent;
    color: var(--gold-light);
  }

  .button-outline {
    color: var(--gold-light);
  }

  .button-outline:hover {
    background: var(--gold);
    color: #11100e;
  }

  .hero-footer {
    position: absolute;
    z-index: 2;
    right: 32px;
    bottom: 24px;
    left: 32px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .manufacturer-intro,
  .process-section,
  .production-flow,
  .quality-section,
  .shipping-section,
  .benefits-section {
    padding: 115px 0;
  }

  .section-heading {
    max-width: 900px;
  }

  .section-heading h2,
  .feature-copy h2,
  .manufacturing-cta h2 {
    margin: 20px 0 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 5.8vw, 72px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(440px, 1.08fr);
    align-items: center;
    gap: 85px;
    margin-top: 65px;
  }

  .intro-copy p {
    color: rgba(245, 239, 230, 0.66);
    font-size: 15px;
    line-height: 1.9;
  }

  .intro-copy .lead {
    color: #eee4d7;
    font-size: 19px;
  }

  .intro-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 42px;
    border-top: 1px solid rgba(190, 148, 75, 0.25);
    border-left: 1px solid rgba(190, 148, 75, 0.25);
  }

  .intro-facts div {
    min-height: 132px;
    display: flex;
    flex-direction: column;
    gap: 17px;
    padding: 24px;
    border-right: 1px solid rgba(190, 148, 75, 0.25);
    border-bottom: 1px solid rgba(190, 148, 75, 0.25);
  }

  .intro-facts span {
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .intro-facts strong {
    color: #ffffff;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
  }

  .intro-visual,
  .feature-visual {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(190, 148, 75, 0.3);
  }

  .intro-visual img {
    width: 100%;
    min-height: 620px;
    display: block;
    object-fit: cover;
  }

  .intro-visual figcaption {
    position: absolute;
    right: 22px;
    bottom: 22px;
    left: 22px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 20px;
    background: rgba(13, 11, 9, 0.92);
    backdrop-filter: blur(8px);
  }

  .intro-visual figcaption span {
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .intro-visual figcaption strong {
    color: #ffffff;
    font-size: 11px;
    font-weight: 400;
    text-align: right;
  }

  .process-section,
  .quality-section,
  .shipping-section,
  .benefits-section {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .process-heading > p {
    max-width: 690px;
    margin: 26px 0 0;
    color: rgba(245, 239, 230, 0.64);
    font-size: 16px;
    line-height: 1.8;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 70px;
  }

  .process-card {
    overflow: hidden;
    border: 1px solid rgba(190, 148, 75, 0.25);
    background: #1a1612;
  }

  .process-image {
    position: relative;
    height: 500px;
    overflow: hidden;
  }

  .process-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .process-card:hover .process-image img {
    transform: scale(1.025);
  }

  .process-image > span {
    position: absolute;
    top: 22px;
    left: 22px;
    min-width: 52px;
    min-height: 52px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    background: rgba(12, 10, 8, 0.82);
    color: var(--gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
  }

  .process-copy {
    padding: 35px;
  }

  .process-copy small {
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .process-copy h3 {
    margin: 16px 0 18px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.12;
  }

  .process-copy p {
    margin: 0;
    color: rgba(245, 239, 230, 0.63);
    font-size: 14px;
    line-height: 1.85;
  }

  .production-flow {
    padding-top: 45px;
  }

  .flow-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 60px;
    border-top: 1px solid rgba(190, 148, 75, 0.28);
    border-left: 1px solid rgba(190, 148, 75, 0.28);
  }

  .flow-card {
    min-height: 285px;
    padding: 32px;
    border-right: 1px solid rgba(190, 148, 75, 0.28);
    border-bottom: 1px solid rgba(190, 148, 75, 0.28);
    background: rgba(255, 255, 255, 0.015);
  }

  .flow-card > span {
    color: var(--gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
  }

  .flow-card h3 {
    margin: 45px 0 17px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.15;
  }

  .flow-card p {
    margin: 0;
    color: rgba(245, 239, 230, 0.59);
    font-size: 13px;
    line-height: 1.8;
  }

  .quality-section,
  .shipping-section {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 90px;
  }

  .feature-visual img {
    width: 100%;
    height: 650px;
    display: block;
    object-fit: cover;
  }

  .feature-copy p,
  .manufacturing-cta p {
    color: rgba(245, 239, 230, 0.65);
    font-size: 15px;
    line-height: 1.9;
  }

  .feature-copy ul {
    display: grid;
    gap: 13px;
    margin: 35px 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-copy li {
    position: relative;
    padding: 15px 18px 15px 43px;
    border: 1px solid rgba(190, 148, 75, 0.18);
    color: rgba(245, 239, 230, 0.75);
    font-size: 13px;
  }

  .feature-copy li::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 19px;
    width: 7px;
    height: 7px;
    border: 1px solid var(--gold);
    transform: translateY(-50%) rotate(45deg);
  }

  .shipping-section {
    background:
      linear-gradient(
        90deg,
        rgba(190, 148, 75, 0.035),
        transparent 58%
      );
  }

  .text-link {
    display: inline-flex;
    margin-top: 24px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--gold);
    color: var(--gold-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 60px;
  }

  .benefit-card {
    min-height: 285px;
    padding: 30px;
    border: 1px solid rgba(190, 148, 75, 0.24);
    background: #1a1612;
  }

  .benefit-card > span {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold-light);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
  }

  .benefit-card h3 {
    margin: 38px 0 17px;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.15;
  }

  .benefit-card p {
    margin: 0;
    color: rgba(245, 239, 230, 0.6);
    font-size: 13px;
    line-height: 1.8;
  }

  .manufacturing-cta {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    align-items: end;
    gap: 70px;
    margin-top: 20px;
    margin-bottom: 100px;
    padding: 75px;
    border: 1px solid rgba(190, 148, 75, 0.35);
    background:
      linear-gradient(
        125deg,
        rgba(190, 148, 75, 0.1),
        transparent 58%
      ),
      #1a1612;
  }

  .manufacturing-cta h2 {
    font-size: clamp(42px, 5vw, 66px);
  }

  .manufacturing-cta p {
    max-width: 690px;
  }

  .cta-actions {
