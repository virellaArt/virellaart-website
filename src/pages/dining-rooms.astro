---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionCatalog from "../components/CollectionCatalog.astro";
import CollectionSchema from "../components/CollectionSchema.astro";
import { diningRoomModels } from "../data/dining-room-catalog";
import {
  getCategorySeoTitle,
  getLanguageFromPath,
  getSeoDescription,
  getTranslations,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const categoryTranslations =
  translations.category.diningRooms;
const pageTitle = getCategorySeoTitle(
  categoryTranslations.title,
  language,
);
const pageDescription = getSeoDescription(
  categoryTranslations.description,
  language,
);
const models = diningRoomModels;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <CollectionSchema
    categoryName={categoryTranslations.title}
    description={pageDescription}
    {models}
  />

  <CollectionCatalog
    {models}
    {language}
    categoryName={categoryTranslations.title}
    categoryDescription={categoryTranslations.description}
    eyebrow={translations.category.eyebrow}
  />
</BaseLayout>
