---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionSchema from "../components/CollectionSchema.astro";
import {
  getLanguageFromPath,
  getTranslations,
  localizedPath,
  translateProductName,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const categoryTranslations = translations.category.diningRooms;

const models = [
  {
    number: "01",
    name: "Valencia Dining",
    href: "/dining-rooms/valencia",
    image: "/valenciadining-01.webp",
    alt: "Valencia Luxury Dining Room Collection by VIRELLAART",
  },
  {
  number: "02",
  name: "Delux Dining",
  href: "/dining-rooms/delux",
  image: "/deluxdiningroom-01.webp",
  alt: "Delux Luxury Dining Room Collection by VIRELLAART",
},
{
  number: "03",
  name: "Aspendos Dining",
  href: "/dining-rooms/aspendos",
  image: "/aspendosdining-01.webp",
  alt: "Aspendos Luxury Dining Room Collection by VIRELLAART",
},
{
    number: "04",
    name: "Queen Dining",
    href: "/dining-rooms/queen",
    image: "/queendining-01.webp",
    alt: "Queen Luxury Dining Room Collection by VIRELLAART",
  },
  {
  number: "05",
  name: "Moon Dining",
  href: "/dining-rooms/moon",
  image: "/moondining-01.webp",
  alt: "Moon Luxury Dining Room Collection by VIRELLAART",
},
{
  number: "06",
  name: "Vanessa",
  href: "/dining-rooms/vanessa",
  image: "/vanessadining-01.webp",
  alt: "Vanessa Luxury Dining Room Collection",
},
{
  number: "07",
  name: "Shawl",
  href: "/dining-rooms/shawl",
  image: "/diningshawl-01.webp",
  alt: "Shawl Luxury Dining Room Collection",
},
{
  number: "08",
  name: "Valdera",
  href: "/dining-rooms/valdera",
  image: "/valderadining-01.webp",
  alt: "Valdera Luxury Dining Room Collection",
},
{
  number: "09",
  name: "Zümrüt",
  href: "/dining-rooms/zumrut",
  image: "/diningzumrut-01.webp",
  alt: "Zumrut Luxury Dining Room Collection",
},
{
  number: "10",
  name: "Milano",
  href: "/dining-rooms/milano",
  image: "/diningmilano-01.webp",
  alt: "Milano Luxury Dining Room Collection",
},
{
  number: "11",
  name: "Milano Blue",
  href: "/dining-rooms/milano-blue",
  image: "/diningmilanoblue-01.webp",
  alt: "Milano Blue Luxury Dining Room Collection",
},
{
  number: "12",
  name: "Lina",
  href: "/dining-rooms/lina",
  image: "/linadining-01.webp",
  alt: "Lina Luxury Dining Room Collection",
},
{
  number: "13",
  name: "Zerafet",
  href: "/dining-rooms/zerafet",
  image: "/zerafet-01.webp",
  alt: "Zerafet Luxury Dining Room Collection",
},
{
  number: "14",
  name: "Saltanat",
  href: "/dining-rooms/saltanat",
  image: "/saltanatdining-01.webp",
  alt: "Saltanat Luxury Dining Room Collection",
},
{
  number: "15",
  name: "Saltanat Green",
  href: "/dining-rooms/saltanat-green",
  image: "/saltanatdininggreen-01.webp",
  alt: "Saltanat Green Luxury Dining Room Collection",
},
{
  number: "16",
  name: "Sultan Green Dining Room Set",
  href: "/dining-rooms/sultan-green",
  image: "/sultandininggreen-01.webp",
  alt: "Sultan Green Dining Room Set by VIRELLAART",
},
];
---

<BaseLayout
  title={categoryTranslations.title}
  description={categoryTranslations.description}
>
  <CollectionSchema
    categoryName={categoryTranslations.title}
    description={categoryTranslations.description}
    {models}
  />
  <main class="page">
    <header class="page-header">
      <span>{translations.category.eyebrow}</span>

      <h1>{categoryTranslations.title}</h1>

      <p>{translations.category.selectModel}</p>
    </header>

    <section class="model-grid" aria-label={categoryTranslations.title}>
      {
        models.map((model, index) => (
          <a
            href={localizedPath(model.href, language)}
            class="model-card"
            aria-label={`${translations.category.viewCollection}: ${translateProductName(model.name, language)}`}
          >
            <div class="model-image">
              <img
                src={model.image}
                alt={`VIRELLAART ${translateProductName(model.name, language)}`}
                width="800"
                height="600"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
                decoding="async"
              />
            </div>

            <div class="model-info">
              <span>{model.number}</span>
              <h2>{translateProductName(model.name, language)}</h2>
              <p>{translations.category.viewCollection}</p>
            </div>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .page {
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
    padding: 125px 0 90px;
  }

  .page-header {
    max-width: 680px;
    margin-bottom: 40px;
  }

  .page-header span {
    display: block;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .page-header h1 {
    margin: 12px 0 16px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 6vw, 70px);
    font-weight: 400;
    line-height: 1;
  }

  .page-header p {
    margin: 0;
    color: var(--gray);
    font-size: 16px;
    line-height: 1.7;
  }

  .model-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }

  .model-card {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #0c0c0c;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .model-image {
    height: 340px;
    overflow: hidden;
    background: #111;
  }

  .model-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .model-info {
    padding: 22px 24px 26px;
  }

  .model-info span {
    display: block;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 3px;
  }

  .model-info h2 {
    margin: 9px 0 7px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 34px;
    font-weight: 400;
    line-height: 1;
  }

  .model-info p {
    margin: 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .model-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
  }

  .model-card:hover img {
    transform: scale(1.03);
  }

  .model-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 5px;
  }

  @media (max-width: 800px) {
    .page {
      width: min(100% - 28px, 1180px);
      padding: 110px 0 70px;
    }

    .model-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .model-image {
      height: 300px;
    }
  }

  @media (max-width: 620px) {
    .model-grid {
      grid-template-columns: 1fr;
    }

    .model-image {
      height: 330px;
    }
  }

  @media (max-width: 520px) {
    .page {
      width: min(100% - 20px, 1180px);
      padding: 100px 0 60px;
    }

    .page-header {
      margin-bottom: 30px;
    }

    .model-grid {
      gap: 16px;
    }

    .model-image {
      height: 300px;
    }

    .model-info {
      padding: 20px;
    }

    .model-info h2 {
      font-size: 30px;
    }
  }
</style>
