---
import BaseLayout from "../../layouts/BaseLayout.astro";

const gallery = [
  "/queendining-01.webp",
  "/queendining-02.webp",
  "/queendining-03.webp",
];

const productName = "Queen Dining";

const pageTitle =
  "Queen Luxury Dining Room Collection | VIRELLAART";

const description =
  "Discover the Queen Luxury Dining Room Collection by VIRELLAART, featuring elegant contemporary design, premium craftsmanship and luxurious finishes. Designed for sophisticated interiors, this exclusive dining collection offers timeless elegance and worldwide delivery.";

const whatsappNumber = "905539478608";

const whatsappMessage =
  "Hello VIRELLAART, I would like to receive more information about the Queen Dining Room Collection.";

const whatsappUrl =
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const prices = [
  {
    label:"Console + Mirror",
    price:"$2,000",
    featured:true
  },
  {
    label:"Dining Table",
    price:"$1,200"
  },
  {
    label:"6 Dining Chairs",
    price:"$1,600"
  }
];
---

<BaseLayout title={pageTitle}>

<main class="product-page">

<section class="product-container">

<div class="product-layout">


<section class="gallery">


<button class="main-image-button" id="openGallery">

<img
id="mainImage"
src={gallery[0]}
alt={productName}
loading="eager"
/>

<span class="zoom">+</span>

</button>


<div class="thumbnails">

{
gallery.map((img,index)=>(
<button
class:list={[
"thumb",
index===0 && "active"
]}
data-index={index}
>

<img src={img} />

</button>
))
}

</div>


</section>



<section class="info">


<p class="label">
VIRELLAART LUXURY COLLECTION
</p>


<h1>
{productName}
</h1>


<h2>
Luxury Dining Room Collection
</h2>


<div class="line"></div>


<p class="description">
{description}
</p>



<div class="price-card">


<div class="price-head">

<span>
COLLECTION PRICES
</span>

<small>
USD
</small>

</div>


{
prices.map(item=>(
<div
class:list={[
"price",
item.featured && "featured"
]}
>

<span>
{item.label}
</span>

<strong>
{item.price}
</strong>

</div>
))
}


</div>



<div class="services">


<div>
<b>
Worldwide Delivery
</b>

<p>
International shipping support is available.
</p>

</div>


<div>

<b>
Premium Craftsmanship
</b>

<p>
Made with carefully selected luxury materials.
</p>

</div>


</div>



<a
class="whatsapp"
href={whatsappUrl}
target="_blank"
>

Contact Us on WhatsApp

</a>


<p class="note">
Contact our team for dimensions, fabric options, production and delivery information.
</p>



</section>


</div>


</section>


</main>




<div class="lightbox" id="lightbox">


<button id="close">
×
</button>


<button id="prev">
‹
</button>


<img id="lightboxImage" src={gallery[0]}/>


<button id="next">
›
</button>


</div>





<script define:vars={{gallery}}>


let current=0;


const main=document.querySelector("#mainImage");
const box=document.querySelector("#lightbox");
const boxImg=document.querySelector("#lightboxImage");


const thumbs=document.querySelectorAll(".thumb");


function change(i){

current=i;

main.src=gallery[i];

boxImg.src=gallery[i];


thumbs.forEach((t,index)=>{

t.classList.toggle(
"active",
index===i
);

});

}



thumbs.forEach((t,index)=>{

t.onclick=()=>change(index);

});


document
.querySelector("#openGallery")
.onclick=()=>{

box.classList.add("open");

boxImg.src=gallery[current];

};



document
.querySelector("#close")
.onclick=()=>{

box.classList.remove("open");

};



document
.querySelector("#next")
.onclick=()=>{

change(
(current+1)%gallery.length
);

};



document
.querySelector("#prev")
.onclick=()=>{

change(
(current-1+gallery.length)%gallery.length
);

};



document.addEventListener(
"keydown",
e=>{

if(e.key==="Escape")
box.classList.remove("open");


if(e.key==="ArrowRight")
change((current+1)%gallery.length);


if(e.key==="ArrowLeft")
change((current-1+gallery.length)%gallery.length);

}

);


</script>





<style>


.product-page{

min-height:100vh;

background:
radial-gradient(
circle at top,
#3a3028,
#171411 60%
);

color:white;

padding:50px 30px;

}



.product-container{

max-width:1500px;

margin:auto;

}



.product-layout{

display:grid;

grid-template-columns:
1.45fr .8fr;

gap:70px;

}



.main-image-button{

position:relative;

width:100%;

aspect-ratio:4/3;

overflow:hidden;

cursor:pointer;

background:#201b17;

}



.main-image-button img{

width:100%;

height:100%;

object-fit:cover;

transition:.5s;

}


.main-image-button:hover img{

transform:scale(1.03);

}



.zoom{

position:absolute;

right:20px;

bottom:20px;

width:45px;

height:45px;

border-radius:50%;

display:grid;

place-items:center;

background:#171411cc;

font-size:30px;

color:#d1ae67;

}




.thumbnails{

display:flex;

gap:12px;

margin-top:15px;

}


.thumb{

width:120px;

height:85px;

overflow:hidden;

border:1px solid transparent;

}


.thumb img{

width:100%;

height:100%;

object-fit:cover;

}



.thumb.active{

border-color:#c9a55b;

}





.label{

color:#c9a55b;

letter-spacing:4px;

font-size:11px;

}



h1{

font-family:Georgia,serif;

font-size:70px;

font-weight:400;

margin:20px 0;

}



h2{

font-family:Georgia,serif;

font-style:italic;

font-weight:400;

color:#cbbda8;

}



.line{

height:1px;

background:#70552b;

margin:35px 0;

}



.description{

color:#c7beb0;

line-height:1.9;

}



.price-card{

margin-top:35px;

background:#211c18;

border:1px solid #51402b;

}



.price-head{

background:#120f0d;

padding:18px;

display:flex;

justify-content:space-between;

color:#d0ad66;

letter-spacing:2px;

}



.price{

padding:18px;

display:flex;

justify-content:space-between;

border-bottom:1px solid #403327;

color:#ddd;

}


.price strong{

color:white;

}



.featured strong{

color:#d2a855;

font-size:22px;

}



.services{

margin-top:30px;

display:grid;

gap:20px;

}


.services b{

color:#d2ad63;

}


.services p{

color:#aaa;

}



.whatsapp{

display:block;

margin-top:35px;

padding:18px;

text-align:center;

background:#b89555;

color:#111;

font-weight:bold;

}



.note{

text-align:center;

color:#999;

font-size:12px;

margin-top:15px;

}





.lightbox{

position:fixed;

inset:0;

background:#000e;

display:none;

align-items:center;

justify-content:center;

z-index:9999;

}


.lightbox.open{

display:flex;

}



.lightbox img{

max-width:90%;

max-height:90%;

object-fit:contain;

}



.lightbox button{

position:absolute;

background:#111;

color:white;

border:1px solid #c9a55b;

width:50px;

height:50px;

font-size:35px;

}


#close{

top:30px;

right:30px;

}


#prev{

left:30px;

}


#next{

right:30px;

}



@media(max-width:900px){

.product-layout{

grid-template-columns:1fr;

}


h1{

font-size:45px;

}

}



</style>

</BaseLayout>