const copy = hubCopy[language];
const productValues = Object.values(products);
const cards = collectionCategories.map((category) => {
  const translationKey = {
    "living-rooms": "livingRooms",
    "dining-rooms": "diningRooms",
    bedrooms: "bedrooms",
    "tv-units": "tvUnits",
  }[category] as
    | "livingRooms"
    | "diningRooms"
    | "bedrooms"
    | "tvUnits";
  const image = {
    "living-rooms": "/living-room.webp",
    "dining-rooms": "/dining-room.webp",
    bedrooms: "/bedroom.webp",
    "tv-units": "/tv-unit.webp",
  }[category];

  return {
    category,
    title: translations.category[translationKey].title,
    description:
      translations.category[translationKey].description,
    image,
    count: getCollectionProductCount(
      productValues,
      "luxury-classic",
      category,
    ),
  };
});

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: copy.title,
  description: copy.description,
  url: new URL(
    localizedPath("/collections/luxury-classic", language),
    "https://www.virellaart.com",
  ).href,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: cards.reduce(
      (total, card) => total + card.count,
      0,
    ),
    itemListElement: cards.map((card, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: card.title,
      url: new URL(
        localizedPath(`/${card.category}`, language),
        "https://www.virellaart.com",
      ).href,
    })),
  },
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  image="/living-room.webp"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(collectionSchema)}
  />

  <section class="collection-hub">
    <header>
      <span>{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <div class="collection-hub-grid">
      {
        cards.map((card) => (
          <a href={localizedPath(`/${card.category}`, language)}>
            <img
              src={card.image}
              alt={card.title}
              width="900"
              height="675"
              loading="lazy"
              decoding="async"
            />

            <div>
              <span>
                {card.count} {copy.models}
              </span>
              <h2>{card.title}</h2>
              <p>{card.description}</p>
              <strong>{copy.view} →</strong>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .collection-hub {
    width: min(100% - 56px, 1380px);
    margin: 0 auto;
    padding: 155px 0 110px;
  }

  .collection-hub > header {
    max-width: 920px;
    margin-bottom: 65px;
  }

  .collection-hub > header span,
  .collection-hub-grid > a > div > span {
    color: var(--gold-light);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .collection-hub h1 {
    margin: 22px 0 26px;
    color: #ffffff;
    font-size: clamp(50px, 7vw, 92px);
    line-height: 0.98;
  }

  .collection-hub > header p {
    max-width: 760px;
    color: #ddd3c5;
    font-size: 18px;
    line-height: 1.75;
  }

  .collection-hub-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .collection-hub-grid > a {
    overflow: hidden;
    border: 1px solid rgba(201, 164, 93, 0.27);
    background: #18130f;
    transition: transform 0.3s ease;
  }

  .collection-hub-grid > a:hover {
    transform: translateY(-5px);
  }

  .collection-hub-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .collection-hub-grid > a > div {
    padding: clamp(26px, 4vw, 42px);
  }

  .collection-hub-grid h2 {
    margin: 17px 0;
    color: #ffffff;
    font-size: clamp(34px, 4vw, 52px);
  }

  .collection-hub-grid p {
    min-height: 58px;
    color: #d4cabe;
    font-size: 15px;
    line-height: 1.7;
  }

  .collection-hub-grid strong {
    display: inline-block;
    margin-top: 25px;
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .collection-hub {
      width: min(100% - 30px, 1380px);
      padding: 125px 0 80px;
    }

    .collection-hub-grid {
      grid-template-columns: 1fr;
    }

    .collection-hub-grid p {
      min-height: 0;
    }
  }
</style>
