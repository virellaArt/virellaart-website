---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLanguageFromPath,
  getTranslations,
  localizedPath,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);

const whatsappMessage =
  translations.product.whatsappMessage.replace(
    "{product}",
    "VIRELLAART",
  );

const whatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(whatsappMessage)}`;

type WhyChooseContent = {
  eyebrow: string;
  title: string;
  intro: string;
  manufacturerTitle: string;
  manufacturerText: string;
  customizationTitle: string;
  customizationText: string;
  manufacturingButton: string;
  contactButton: string;
  location: string;
};

