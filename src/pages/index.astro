---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedCollections from "../components/FeaturedCollections.astro";
import { products } from "../data/products";
import { collectionMenuCopy } from "../i18n/collection-menu";
import {
  getSeoDescription,
  getLanguageFromPath,
  getTranslations,
  localizedPath,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const collectionCopy = collectionMenuCopy[language];
const luxuryClassicProductCount =
  Object.values(products).filter(
    (product) =>
      product.style === "luxury-classic",
  ).length;
const modernProductCount =
  Object.values(products).filter(
    (product) => product.style === "modern",
  ).length;

const pageDescription =
  getSeoDescription(
    translations.home.description,
    language,
  );

const whatsappMessage =
  translations.product.whatsappMessage.replace(
    "{product}",
    "VIRELLAART",
  );

const whatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(whatsappMessage)}`;

