      "VIRELLAART o‘ziga xos dizayn, ishlab chiqaruvchi bilan bevosita aloqa va xalqaro loyiha yordamini birlashtiradi.",
    manufacturerTitle: "Bevosita ishlab chiqaruvchi",
    manufacturerText:
      "Mahsulot, narx va buyurtma ma’lumotlari uchun Istanbuldagi VIRELLAART jamoasi bilan bog‘laning.",
    customizationTitle: "Moslashtirish yordami",
    customizationText:
      "Tanlangan modellar va loyiha talablari interyer konsepsiyasiga muvofiq ko‘rib chiqiladi.",
    manufacturingButton: "Ishlab chiqarishni ko‘ring",
    contactButton: "Jamoamiz bilan bog‘laning",
    location: "Istanbul, Türkiye",
  },

  pt: {
