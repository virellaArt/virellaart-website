  sr: {
    eyebrow: "Zašto VIRELLAART",
    title: "Dizajnirano sa namerom. Proizvedeno za izuzetne enterijere.",
    intro:
      "VIRELLAART kombinuje prepoznatljiv dizajn, direktan kontakt sa proizvođačem i podršku međunarodnim projektima.",
    manufacturerTitle: "Direktan proizvođač",
    manufacturerText:
      "Kontaktirajte VIRELLAART tim u Istanbulu za informacije o proizvodima, cenama i zahtevima.",
    customizationTitle: "Podrška za prilagođavanje",
    customizationText:
      "Odabrani modeli i zahtevi projekta mogu se razmotriti prema vašem konceptu enterijera.",
    manufacturingButton: "Pogledajte proizvodnju",
    contactButton: "Kontaktirajte naš tim",
