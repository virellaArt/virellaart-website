const factoryImageDisclosure =
  manufacturingImageDisclosure[language] ??
  manufacturingImageDisclosure.en;

const why =
  whyChooseContent[language] ??
  whyChooseContent.en;

/* VIRELLAART CONVERSION HERO FINAL */

const conversionHero =
  language === "en"
    ? {
        eyebrow:
          "Manufacturer Direct · Istanbul, Türkiye",
        title:
          "Luxury Furniture Made in Istanbul, Delivered Worldwide",
        brandLine:
          "VIRELLAART · ISTANBUL",
        lead:
          "Manufacturer-direct living room, dining room, bedroom and TV unit collections, crafted in Türkiye with custom finishes and delivered worldwide.",
        primaryButton:
          "Get Price & Delivery Quote",
        secondaryButton:
          "Explore Collections",
        proofOne:
          "Manufacturer Direct",
        proofTwo:
          "Custom Finishes",
        proofThree:
          "Worldwide Delivery",
      }
    : {
        eyebrow:
          translations.home.eyebrow,
        title:
          translations.home.title,
        brandLine:
          "VIRELLAART · ISTANBUL",
        lead:
          translations.home.lead,
        primaryButton:
          translations.product.whatsapp,
        secondaryButton:
          translations.home.button,
        proofOne:
          why.manufacturerTitle,
        proofTwo:
          translations.product.craftsmanship,
        proofThree:
          translations.product.worldwideDelivery,
      };

const homePageTitle =
  language === "en"
    ? "Luxury Furniture Manufacturer in Istanbul | VIRELLAART"
    : translations.home.title;

const homePageDescription =
  language === "en"
    ? "Discover manufacturer-direct luxury furniture made in Istanbul, with custom finishes and worldwide delivery for living rooms, dining rooms, bedrooms and interior projects."
    : pageDescription;

---

<BaseLayout
  title={homePageTitle}
  description={homePageDescription}
>
  <section id="home" class="hero">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="eyebrow">
        {conversionHero.eyebrow}
      </span>

      <h1>{conversionHero.title}</h1>

      <p class="hero-title-keyword">
        {conversionHero.brandLine}
      </p>

      <p class="hero-lead">
        {conversionHero.lead}
      </p>

      <div class="hero-proof">
        <span>{conversionHero.proofOne}</span>

        <i aria-hidden="true"></i>

        <span>{conversionHero.proofTwo}</span>

        <i aria-hidden="true"></i>

        <span>{conversionHero.proofThree}</span>
      </div>

      <div class="hero-actions">
        <a
          href={whatsappURL}
          class="hero-button hero-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="home-hero"
          data-cta-position="home-hero"
          data-product-name="VIRELLAART"
          data-page-language={language}
        >
          {conversionHero.primaryButton}
        </a>

        <a
          href="#collections"
          class="hero-button"
        >
          {conversionHero.secondaryButton}
        </a>
      </div>
    </div>
  </section>

<section
    class="sales-signals"
    aria-label={translations.contact.service}
  >
    <article>
      <span>01</span>
      <strong>
        {translations.product.craftsmanship}
      </strong>
      <p>
        {translations.product.craftsmanshipText}
      </p>
    </article>

    <article>
      <span>02</span>
      <strong>
        {translations.product.worldwideDelivery}
      </strong>
      <p>
        {translations.product.worldwideDeliveryText}
      </p>
    </article>

    <article>
      <span>03</span>
      <strong>
        {translations.contact.languageValue}
      </strong>
      <p>
        {translations.contact.paragraph}
      </p>
    </article>
  </section>

  <section id="collections" class="collections">
    <div class="section-heading">
      <span>{translations.home.discover}</span>

      <h2>{translations.home.heading}</h2>

      <p>{translations.home.intro}</p>
    </div>

    <nav
      class="collection-style-selector"
      aria-label={translations.nav.collections}
    >
      <a
        class="collection-style-option is-featured"
        href={localizedPath(
          "/collections/luxury-classic",
          language,
        )}
        data-collection-style="luxury-classic"
      >
        <span class="collection-style-index">01</span>

        <span class="collection-style-copy">
          <strong>{collectionCopy.luxuryClassic}</strong>
          <small>
            {luxuryClassicProductCount}
            {" "}
            {collectionCopy.modelLabel}
          </small>
        </span>

        <span
          class="collection-style-arrow"
          aria-hidden="true"
        >
          →
        </span>
      </a>

      <a
        class="collection-style-option"
        href={localizedPath(
          "/collections/modern",
          language,
        )}
        data-collection-style="modern"
      >
        <span class="collection-style-index">02</span>

        <span class="collection-style-copy">
          <strong>{collectionCopy.modern}</strong>
          <small>
            {modernProductCount > 0
              ? `${modernProductCount} ${
                  modernProductCount === 1
                    ? collectionCopy.modelSingular
                    : collectionCopy.modelLabel
                }`
              : collectionCopy.modelsSoon}
          </small>
        </span>

        <span
          class="collection-style-arrow"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    </nav>

    <div class="collection-grid-context">
      <span>{collectionCopy.luxuryClassic}</span>

      <a
        href={localizedPath(
          "/collections/luxury-classic",
          language,
        )}
      >
        {translations.home.discoverCollection}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="collection-grid">
      <a
        href={localizedPath("/living-rooms", language)}
        class="collection-card living-room"
      >
