  el: {
    eyebrow: "Γιατί VIRELLAART",
    title: "Σχεδιασμένο με σκοπό. Κατασκευασμένο για εξαιρετικούς χώρους.",
    intro:
      "Η VIRELLAART συνδυάζει ιδιαίτερο σχεδιασμό, άμεση επικοινωνία με τον κατασκευαστή και διεθνή υποστήριξη έργων.",
    manufacturerTitle: "Άμεσος κατασκευαστής",
    manufacturerText:
      "Επικοινωνήστε απευθείας με την ομάδα VIRELLAART στην Κωνσταντινούπολη για πληροφορίες και τιμές.",
    customizationTitle: "Υποστήριξη εξατομίκευσης",
    customizationText:
      "Επιλεγμένα μοντέλα και απαιτήσεις έργου μπορούν να αξιολογηθούν σύμφωνα με τον χώρο σας.",
    manufacturingButton: "Δείτε την παραγωγή",
    contactButton: "Επικοινωνήστε μαζί μας",
    location: "Κωνσταντινούπολη, Türkiye",
  },

  es: {
    eyebrow: "Por qué elegir VIRELLAART",
    title: "Diseñado con intención. Fabricado para interiores excepcionales.",
    intro:
      "VIRELLAART combina diseño distintivo, contacto directo con el fabricante y asistencia para proyectos internacionales.",
    manufacturerTitle: "Fabricante directo",
    manufacturerText:
      "Comuníquese directamente con el equipo VIRELLAART en Estambul para información, precios y requisitos.",
    customizationTitle: "Personalización",
