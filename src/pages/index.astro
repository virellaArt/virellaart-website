---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLanguageFromPath,
  getTranslations,
  localizedPath,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
---

<BaseLayout
  title={translations.home.title}
  description={translations.home.description}
>

  <section id="home" class="hero">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="eyebrow">{translations.home.eyebrow}</span>

      <h1>VIRELLAART</h1>

      <p>
        {translations.home.lead}
      </p>

      <a href="#collections" class="hero-button">
        {translations.home.button}
      </a>
    </div>
  </section>

  <section id="collections" class="collections">

    <div class="section-heading">
      <span>{translations.home.discover}</span>

      <h2>{translations.home.heading}</h2>

      <p>
        {translations.home.intro}
      </p>
    </div>

    <div class="collection-grid">

      <a href={localizedPath("/living-rooms", language)} class="collection-card living-room">
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">01</span>
          <h3>{translations.home.livingRooms}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

      <a href={localizedPath("/dining-rooms", language)} class="collection-card dining-room">
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">02</span>
          <h3>{translations.home.diningRooms}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

      <a href={localizedPath("/bedrooms", language)} class="collection-card bedroom">
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">03</span>
          <h3>{translations.home.bedrooms}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

      <a href={localizedPath("/tv-units", language)} class="collection-card tv-unit">
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">04</span>
          <h3>{translations.home.tvUnits}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 140px 30px 70px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(
        rgba(0, 0, 0, 0.14),
        rgba(0, 0, 0, 0.38)
      ),
      url("/living-room.webp") center center / cover no-repeat,
      #090909;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0) 30%,
        rgba(0, 0, 0, 0.24) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 1100px);
  }

  .eyebrow {
    display: block;
    margin-bottom: 26px;
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 6px;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(58px, 10vw, 140px);
    font-weight: 400;
    letter-spacing: 12px;
    line-height: 0.92;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }

  .hero-content > p {
    max-width: 720px;
    margin: 0 auto 42px;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(16px, 2vw, 21px);
    line-height: 1.8;
    text-shadow: 0 3px 16px rgba(0, 0, 0, 0.65);
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 245px;
    padding: 18px 30px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    color: #ffffff;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(5px);
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease,
      transform 0.35s ease;
  }

  .hero-button:hover {
    border-color: var(--gold);
    background: var(--gold);
    color: #090909;
    transform: translateY(-3px);
  }

  .collections {
    width: min(100% - 64px, var(--container));
    margin: 0 auto;
    padding: 130px 0;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .section-heading > span {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 16px 0 20px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 400;
    line-height: 1.05;
  }

  .section-heading p {
    color: var(--gray);
    font-size: 16px;
    line-height: 1.8;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .collection-card {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    padding: 42px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background-color: #111111;
    background-position: center;
    background-size: cover;
    isolation: isolate;
    transition:
      transform 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  .living-room {
    background-image:
      linear-gradient(
        rgba(0, 0, 0, 0.04),
        rgba(0, 0, 0, 0.18)
      ),
      url("/living-room.webp");
  }

  .dining-room {
    background-image:
      linear-gradient(
        rgba(0, 0, 0, 0.04),
        rgba(0, 0, 0, 0.18)
      ),
      url("/dining-room.webp");
  }

  .bedroom {
    background-image:
      linear-gradient(
        rgba(0, 0, 0, 0.04),
        rgba(0, 0, 0, 0.18)
      ),
      url("/bedroom.webp");
  }

  .tv-unit {
    background-image:
      linear-gradient(
        rgba(0, 0, 0, 0.04),
        rgba(0, 0, 0, 0.18)
      ),
      url("/tv-unit.webp");
  }

  .collection-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.02),
        rgba(0, 0, 0, 0.08)
      );
    transition: transform 0.8s ease;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.68) 0%,
        rgba(0, 0, 0, 0.14) 48%,
        rgba(0, 0, 0, 0.02) 100%
      );
  }

  .collection-card:hover {
    transform: translateY(-7px);
    border-color: rgba(200, 169, 106, 0.85);
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.32);
  }

  .collection-card:hover::before {
    transform: scale(1.06);
  }

  .card-content {
    position: relative;
    z-index: 2;
    transform: translateY(22px);
    transition: transform 0.45s ease;
  }

  .collection-card:hover .card-content {
    transform: translateY(0);
  }

  .card-number {
    display: block;
    margin-bottom: 16px;
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 4px;
  }

  .card-content h3 {
    margin: 0;
    color: #ffffff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(38px, 4vw, 62px);
    font-weight: 400;
    line-height: 1.05;
    text-shadow: 0 3px 18px rgba(0, 0, 0, 0.75);
  }

  .card-content p {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 10px;
    letter-spacing: 3px;
    opacity: 0;
    text-transform: uppercase;
    transform: translateY(10px);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .collection-card:hover .card-content p {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .collections {
      width: min(100% - 36px, var(--container));
      padding: 100px 0;
    }

    .collection-grid {
      grid-template-columns: 1fr;
    }

    .collection-card {
      min-height: 420px;
    }

    .hero h1 {
      letter-spacing: 7px;
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: 92vh;
      padding: 120px 20px 60px;
    }

    .hero h1 {
      font-size: clamp(44px, 16vw, 68px);
      letter-spacing: 4px;
    }

    .eyebrow {
      letter-spacing: 4px;
    }

    .hero-button {
      min-width: 215px;
    }

    .collections {
      width: min(100% - 24px, var(--container));
      padding: 82px 0;
    }

    .section-heading {
      margin-bottom: 42px;
    }

    .collection-grid {
      gap: 16px;
    }

    .collection-card {
      min-height: 360px;
      padding: 28px;
    }

    .card-content {
      transform: translateY(0);
    }

    .card-content p {
      opacity: 1;
      transform: none;
    }
  }
</style>
