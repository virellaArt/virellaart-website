const why = whyChooseContent[language] ?? whyChooseContent.en;
---

<BaseLayout
  title={translations.home.title}
  description={translations.home.description}
>
  <section id="home" class="hero">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="eyebrow">
        {translations.home.eyebrow}
      </span>

      <h1>VIRELLAART</h1>

      <p class="hero-title-keyword">
        {translations.home.title}
      </p>

      <p class="hero-lead">
        {translations.home.lead}
      </p>

      <div class="hero-actions">
        <a href="#collections" class="hero-button">
          {translations.home.button}
        </a>

        <a
          href={whatsappURL}
          class="hero-button hero-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="home-hero"
          data-cta-position="home-hero"
          data-product-name="VIRELLAART"
          data-page-language={language}
        >
          {translations.product.whatsapp}
        </a>
      </div>
    </div>
  </section>

  <section
    class="sales-signals"
    aria-label={translations.contact.service}
  >
    <article>
      <span>01</span>
      <strong>
        {translations.product.craftsmanship}
      </strong>
      <p>
        {translations.product.craftsmanshipText}
      </p>
    </article>

    <article>
      <span>02</span>
      <strong>
        {translations.product.worldwideDelivery}
      </strong>
      <p>
        {translations.product.worldwideDeliveryText}
      </p>
    </article>

    <article>
      <span>03</span>
      <strong>
        {translations.contact.languageValue}
      </strong>
      <p>
        {translations.contact.paragraph}
      </p>
    </article>
  </section>

  <section id="collections" class="collections">
    <div class="section-heading">
      <span>{translations.home.discover}</span>

      <h2>{translations.home.heading}</h2>

      <p>{translations.home.intro}</p>
    </div>

    <div class="collection-grid">
      <a
        href={localizedPath("/living-rooms", language)}
        class="collection-card living-room"
      >
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">01</span>
          <h3>{translations.home.livingRooms}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

      <a
        href={localizedPath("/dining-rooms", language)}
        class="collection-card dining-room"
      >
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">02</span>
          <h3>{translations.home.diningRooms}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

      <a
        href={localizedPath("/bedrooms", language)}
        class="collection-card bedroom"
      >
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">03</span>
          <h3>{translations.home.bedrooms}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>

      <a
        href={localizedPath("/tv-units", language)}
        class="collection-card tv-unit"
      >
        <div class="card-overlay"></div>

        <div class="card-content">
          <span class="card-number">04</span>
          <h3>{translations.home.tvUnits}</h3>
          <p>{translations.home.discoverCollection}</p>
        </div>
      </a>
    </div>
  </section>

  <section class="brand-story">
    <div class="brand-story-image">
      <img
        src="/queen-02.webp"
        alt={translations.about.imageAlt}
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="brand-story-copy">
      <span>{translations.about.story}</span>

      <h2>{translations.about.heading}</h2>

      <p>{translations.about.paragraphOne}</p>

      <p>{translations.about.paragraphTwo}</p>

      <a href={localizedPath("/about", language)}>
        {translations.nav.about}
      </a>
    </div>
  </section>

  <section class="why-choose">
    <div class="why-grid">
      <div class="why-image">
        <img
          src="/about-factory.webp"
          alt={translations.about.imageAlt}
          width="1200"
          height="1500"
          loading="lazy"
          decoding="async"
        />

        <div class="why-image-overlay"></div>

        <div class="why-location">
          <span>VIRELLAART</span>
          <strong>{why.location}</strong>
        </div>
      </div>

      <div class="why-content">
        <span class="why-eyebrow">
          {why.eyebrow}
        </span>

        <h2>{why.title}</h2>

        <p class="why-intro">
          {why.intro}
        </p>

        <div class="why-list">
          <article class="why-item">
            <span>01</span>

            <div>
              <h3>{why.manufacturerTitle}</h3>
              <p>{why.manufacturerText}</p>
            </div>
          </article>

          <article class="why-item">
            <span>02</span>

            <div>
              <h3>{why.customizationTitle}</h3>
              <p>{why.customizationText}</p>
            </div>
          </article>

          <article class="why-item">
            <span>03</span>

            <div>
              <h3>
                {translations.product.craftsmanship}
              </h3>

              <p>
                {translations.product.craftsmanshipText}
              </p>
            </div>
          </article>

          <article class="why-item">
            <span>04</span>

            <div>
              <h3>
                {translations.product.worldwideDelivery}
              </h3>

              <p>
                {translations.product.worldwideDeliveryText}
              </p>
            </div>
          </article>
        </div>

        <div class="why-actions">
          <a
            class="why-primary"
            href={localizedPath(
              "/manufacturing",
              language,
            )}
          >
            {why.manufacturingButton}
          </a>

          <a
            class="why-secondary"
            href={localizedPath(
              "/contact",
              language,
            )}
          >
            {why.contactButton}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="consultation">
    <div>
      <span>{translations.contact.eyebrow}</span>

      <h2>{translations.contact.hero}</h2>

      <p>{translations.contact.lead}</p>
    </div>

    <a
      href={whatsappURL}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-context="home-consultation"
      data-cta-position="home-consultation"
      data-product-name="VIRELLAART"
      data-page-language={language}
    >
      {translations.contact.button}
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 140px 30px 70px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(
        rgba(0, 0, 0, 0.14),
        rgba(0, 0, 0, 0.38)
      ),
      url("/living-room.webp") center center / cover no-repeat,
      #090909;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0) 30%,
        rgba(0, 0, 0, 0.24) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 1100px);
  }

  .eyebrow {
    display: block;
    margin-bottom: 26px;
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 6px;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(58px, 10vw, 140px);
    font-weight: 400;
    letter-spacing: 12px;
    line-height: 0.92;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }

  .hero-title-keyword {
    margin: -7px auto 20px;
    color: var(--gold-light);
    font-size: clamp(11px, 1.25vw, 15px);
    font-weight: 500;
    letter-spacing: 4px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero-lead {
    max-width: 720px;
    margin: 0 auto 42px;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(16px, 2vw, 21px);
    line-height: 1.8;
    text-shadow: 0 3px 16px rgba(0, 0, 0, 0.65);
  }

