    manufacturerText:
      "Communicate directly with the VIRELLAART team in Istanbul for product information, collection pricing and order requirements.",
    customizationTitle: "Customization Support",
    customizationText:
      "Selected models and project requirements can be reviewed according to your interior concept and order needs.",
    manufacturingButton: "Explore Manufacturing",
    contactButton: "Contact Our Team",
    location: "Istanbul, Türkiye",
