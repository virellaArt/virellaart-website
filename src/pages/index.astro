    customizationText:
      "Modelele selectate și cerințele proiectului pot fi evaluate în funcție de conceptul interior.",
    manufacturingButton: "Descoperiți producția",
    contactButton: "Contactați echipa",
    location: "Istanbul, Türkiye",
