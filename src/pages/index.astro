const manufacturingImageDisclosure: Record<string, string> = {
  en: "Luxury furniture production, quality control and international delivery managed by VIRELLAART in Türkiye.",
  tr: "VIRELLAART tarafından Türkiye'de yönetilen lüks mobilya üretimi, kalite kontrolü ve uluslararası teslimat süreci.",
  de: "Luxusmöbelproduktion, Qualitätskontrolle und internationale Lieferung werden von VIRELLAART in Türkiye koordiniert.",
  fr: "La production de mobilier de luxe, le contrôle qualité et la livraison internationale sont gérés par VIRELLAART en Türkiye.",
  it: "La produzione di mobili di lusso, il controllo qualità e la consegna internazionale sono gestiti da VIRELLAART in Türkiye.",
