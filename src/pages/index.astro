---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getSeoDescription,
  getLanguageFromPath,
  getTranslations,
  localizedPath,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);

const pageDescription =
  getSeoDescription(
    translations.home.description,
    language,
  );

const whatsappMessage =
  translations.product.whatsappMessage.replace(
    "{product}",
    "VIRELLAART",
  );

const whatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(whatsappMessage)}`;

