    contactButton: "Ekibimizle İletişime Geçin",
    location: "İstanbul, Türkiye",
  },

  de: {
    eyebrow: "Warum VIRELLAART?",
    title: "Mit Anspruch gestaltet. Für außergewöhnliche Räume gefertigt.",
    intro:
      "VIRELLAART verbindet unverwechselbares Möbeldesign, direkten Herstellerkontakt und internationale Projektunterstützung.",
    manufacturerTitle: "Direkter Hersteller",
    manufacturerText:
      "Kontaktieren Sie das VIRELLAART-Team in Istanbul direkt für Produktinformationen, Preise und Bestellanforderungen.",
    customizationTitle: "Individuelle Anpassung",
    customizationText:
      "Ausgewählte Modelle und Projektanforderungen können entsprechend Ihrem Einrichtungskonzept geprüft werden.",
    manufacturingButton: "Produktion entdecken",
