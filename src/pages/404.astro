---

<BaseLayout
  title="Page Not Found | VIRELLAART"
  description="Return to VIRELLAART luxury furniture collections and international customer support."
  robots="noindex, follow"
  alternateURLs={[]}
  xDefaultURL="https://www.virellaart.com/"
  includeCanonical={false}
>
  <section
    class="error-page"
    data-error-page
    data-copy={JSON.stringify(errorCopy)}
  >
    <div>
      <span data-error-eyebrow>{errorCopy.en.eyebrow}</span>
      <strong aria-hidden="true">404</strong>
      <h1 data-error-title>{errorCopy.en.title}</h1>
      <p data-error-text>{errorCopy.en.text}</p>

      <nav aria-label="Page recovery">
        <a href="/" data-error-home>{errorCopy.en.home}</a>
        <a href="/#collections" data-error-collections>
          {errorCopy.en.collections}
        </a>
        <a
          href="https://wa.me/905539478608"
          target="_blank"
          rel="noopener noreferrer"
          data-error-contact
          data-whatsapp-context="404"
        >
          {errorCopy.en.contact}
        </a>
      </nav>
    </div>
  </section>

  <script is:inline>
    (() => {
      const page = document.querySelector("[data-error-page]");

      if (!(page instanceof HTMLElement)) {
        return;
      }

      const copy = JSON.parse(page.dataset.copy || "{}");
      const language =
        window.location.pathname
          .split("/")
          .filter(Boolean)[0]
          ?.toLowerCase() || "en";
      const resolved =
        copy[language] || copy.en;
      const prefix =
        language !== "en" && copy[language]
          ? "/" + language
          : "";

      document.documentElement.lang =
        copy[language] ? language : "en";

      const values = {
        "[data-error-eyebrow]": resolved.eyebrow,
        "[data-error-title]": resolved.title,
        "[data-error-text]": resolved.text,
        "[data-error-home]": resolved.home,
        "[data-error-collections]": resolved.collections,
        "[data-error-contact]": resolved.contact,
      };

      Object.entries(values).forEach(([selector, value]) => {
        const element = page.querySelector(selector);

        if (element) {
          element.textContent = value;
        }
      });

      const home = page.querySelector("[data-error-home]");
      const collections =
        page.querySelector("[data-error-collections]");

      if (home instanceof HTMLAnchorElement) {
        home.href = prefix + "/";
      }

      if (collections instanceof HTMLAnchorElement) {
        collections.href = prefix + "/#collections";
      }
    })();
  </script>
</BaseLayout>

<style>
  .error-page {
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 150px 28px 90px;
    background:
      radial-gradient(
        circle at 50% 20%,
        rgba(201, 164, 93, 0.18),
        transparent 38%
      ),
      #120f0d;
    text-align: center;
  }

  .error-page > div {
    width: min(100%, 880px);
  }

  .error-page span {
    color: var(--gold-light);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .error-page strong {
    display: block;
    margin: 20px 0 -22px;
    color: rgba(225, 199, 138, 0.16);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(110px, 24vw, 250px);
    font-weight: 400;
    line-height: 0.9;
  }

  .error-page h1 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(42px, 7vw, 82px);
    line-height: 1;
  }

  .error-page p {
    max-width: 650px;
    margin: 28px auto 38px;
    color: #ddd3c5;
    font-size: 17px;
    line-height: 1.75;
  }

  .error-page nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .error-page a {
    min-width: 190px;
    padding: 15px 20px;
    border: 1px solid rgba(225, 199, 138, 0.65);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .error-page a:last-child {
    background: #0d6b3b;
    border-color: #0d6b3b;
  }
</style>
