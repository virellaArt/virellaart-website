---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionCatalog from "../components/CollectionCatalog.astro";
import CollectionSchema from "../components/CollectionSchema.astro";
import { bedroomModels } from "../data/bedroom-catalog";
import {
  getCategorySeoTitle,
  getLanguageFromPath,
  getSeoDescription,
  getTranslations,
} from "../i18n/config";

const language = getLanguageFromPath(Astro.url.pathname);
const translations = getTranslations(language);
const categoryTranslations =
  translations.category.bedrooms;
const pageTitle =
  language === "en"
    ? "Luxury Bedroom Furniture & Bedroom Sets"
    : getCategorySeoTitle(
        categoryTranslations.title,
        language,
      );
const pageDescription =
  language === "en"
    ? "Explore VIRELLAART luxury bedroom furniture and complete bedroom sets. Made to order in Istanbul with coordinated pieces and international delivery support."
    : getSeoDescription(
        categoryTranslations.description,
        language,
      );
const models = bedroomModels;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <CollectionSchema
    categoryName={categoryTranslations.title}
    description={pageDescription}
    {models}
  />

  <CollectionCatalog
    {models}
    {language}
    categoryName={categoryTranslations.title}
    categoryDescription={categoryTranslations.description}
    eyebrow={translations.category.eyebrow}
  />
</BaseLayout>
