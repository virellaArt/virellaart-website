---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact VIRELLAART | Luxury Furniture">

  <section class="contact-hero">
    <div class="contact-overlay"></div>

    <div class="contact-content">
      <span>Contact VIRELLAART</span>

      <h1>Let’s Create an Exceptional Interior</h1>

      <p>
        Contact our team for product information, worldwide delivery details
        and private luxury furniture consultation.
      </p>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-grid">

      <div class="contact-info">
        <span>Get in Touch</span>

        <h2>Worldwide Luxury Furniture Service</h2>

        <p>
          Our team assists international clients with collections, measurements,
          customization, production, payment and worldwide delivery.
        </p>

        <div class="contact-details">

          <div class="detail">
            <small>Showroom</small>
            <strong>Istanbul, Türkiye</strong>
          </div>

          <div class="detail">
            <small>WhatsApp</small>
            <strong>Contact VIRELLAART</strong>
          </div>

          <div class="detail">
            <small>Service</small>
            <strong>Worldwide Delivery</strong>
          </div>

          <div class="detail">
            <small>Language</small>
            <strong>International Customer Support</strong>
          </div>

        </div>

        <a
          class="whatsapp-button"
          href="https://wa.me/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Contact on WhatsApp
        </a>
      </div>

      <div class="contact-image">
        <img src="/dining-room.png" alt="VIRELLAART luxury furniture showroom" />
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: 140px 30px 80px;
    text-align: center;
    background:
      linear-gradient(rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.58)),
      url("/tv-unit.png") center / cover no-repeat;
  }

  .contact-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0) 24%,
        rgba(0, 0, 0, 0.42) 100%
      );
  }

  .contact-content {
    position: relative;
    z-index: 2;
    width: min(100%, 960px);
  }

  .contact-content span,
  .contact-info > span {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .contact-content h1 {
    margin: 20px 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(50px, 8vw, 108px);
    font-weight: 400;
    line-height: 1;
  }

  .contact-content p {
    max-width: 760px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.8;
  }

  .contact-section {
    width: min(100% - 64px, var(--container));
    margin: 0 auto;
    padding: 120px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 70px;
  }

  .contact-info h2 {
    margin: 20px 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 70px);
    font-weight: 400;
    line-height: 1.08;
  }

  .contact-info > p {
    color: var(--gray);
    font-size: 17px;
    line-height: 1.9;
  }

  .contact-details {
    margin: 42px 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .detail {
    min-height: 130px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .detail small {
    margin-bottom: 10px;
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .detail strong {
    color: #ffffff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }

  .whatsapp-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 240px;
    padding: 18px 28px;
    border: 1px solid var(--gold);
    background: var(--gold);
    color: #090909;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      transform 0.3s ease,
      background 0.3s ease,
      color 0.3s ease;
  }

  .whatsapp-button:hover {
    transform: translateY(-3px);
    background: transparent;
    color: var(--gold);
  }

  .contact-image {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .contact-image img {
    width: 100%;
    height: 760px;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 900px) {
    .contact-section {
      width: min(100% - 36px, var(--container));
      padding: 90px 0;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .contact-image img {
      height: 540px;
    }
  }

  @media (max-width: 560px) {
    .contact-hero {
      min-height: 68vh;
      padding: 120px 20px 60px;
    }

    .contact-section {
      width: min(100% - 24px, var(--container));
      padding: 72px 0;
    }

    .contact-details {
      grid-template-columns: 1fr;
    }

    .contact-image img {
      height: 430px;
    }

    .whatsapp-button {
      width: 100%;
    }
  }
</style>
