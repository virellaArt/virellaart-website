  Astro.url.pathname,
  "https://www.virellaart.com",
).href;

const whatsappMessage = [
  translations.product.whatsappMessage.replace(
    "{product}",
    "VIRELLAART",
  ),
  "",
  extra.briefTitle,
  ...extra.briefItems.map((item) => `• ${item}`),
  "",
  contactPageURL,
].join("\n");

const whatsappURL =
  `https://wa.me/905539478608?text=${encodeURIComponent(whatsappMessage)}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: pageTitle,
  description: pageDescription,
  url: new URL(
    Astro.url.pathname,
    "https://www.virellaart.com",
  ).href,
  about: {
    "@type": "Organization",
    "@id": "https://www.virellaart.com/#organization",
    name: "VIRELLAART",
    url: "https://www.virellaart.com",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Istanbul",
      addressCountry: "TR",
    },
    contactPoint: {
      "@type": "ContactPoint",
      telephone: "+90 553 947 86 08",
      contactType: "sales",
      areaServed: "Worldwide",
    },
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  ></script>

  <section class="contact-hero">
    <div class="contact-overlay"></div>

    <div class="contact-content">
      <span>{translations.contact.eyebrow}</span>

      <h1>{translations.contact.hero}</h1>

      <p>{translations.contact.lead}</p>

      <div class="hero-actions">
        <a
          class="primary-button"
          href={whatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="contact-hero"
          data-cta-position="contact-hero"
          data-product-name="VIRELLAART"
          data-page-language={language}
        >
          {translations.contact.button}
        </a>

        <a
          class="secondary-button"
          href="#project-brief"
        >
          {extra.projectButton}
        </a>
      </div>
    </div>
  </section>

  <section class="contact-overview">
    <div class="overview-grid">
      <div class="overview-copy">
        <span class="eyebrow">
          {extra.overviewEyebrow}
        </span>

        <h2>{extra.overviewTitle}</h2>

        <p>{extra.overviewText}</p>

        <a
          class="text-link"
          href={whatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="contact-overview"
          data-cta-position="contact-overview"
          data-product-name="VIRELLAART"
          data-page-language={language}
        >
          {translations.contact.button}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="contact-details">
        <article class="detail-card">
          <small>{extra.manufacturerLabel}</small>
          <strong>{extra.manufacturerValue}</strong>
        </article>

        <article class="detail-card">
          <small>{translations.contact.whatsapp}</small>

          <a
            href={whatsappURL}
            target="_blank"
            rel="noopener noreferrer"
          >
            {translations.contact.whatsappValue}
          </a>
        </article>

        <article class="detail-card">
          <small>{extra.locationLabel}</small>
          <strong>{extra.locationValue}</strong>
        </article>

        <article class="detail-card">
          <small>{extra.deliveryLabel}</small>
          <strong>{extra.deliveryValue}</strong>
        </article>

        <article class="detail-card">
          <small>{extra.supportLabel}</small>
          <strong>{extra.supportValue}</strong>
        </article>

        <article class="detail-card">
          <small>{translations.contact.language}</small>
          <strong>{translations.contact.languageValue}</strong>
        </article>
      </div>
    </div>
  </section>

  <section
    class="project-brief"
    id="project-brief"
  >
    <div class="brief-grid">
      <div class="brief-image">
        <img
          src="/about-shipping.webp"
          alt={extra.shippingAlt}
          width="1200"
          height="1500"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="brief-copy">
        <span class="eyebrow">
          {extra.briefEyebrow}
        </span>

        <h2>{extra.briefTitle}</h2>

        <p>{extra.briefText}</p>

        <div class="brief-list">
          {
            extra.briefItems.map((item, index) => (
              <div class="brief-item">
                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <p>{item}</p>
              </div>
            ))
          }
        </div>

        <a
          class="primary-button"
          href={whatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          data-whatsapp-context="contact-project-brief"
          data-cta-position="contact-project-brief"
          data-product-name="VIRELLAART"
          data-page-language={language}
        >
          {translations.contact.button}
        </a>
      </div>
    </div>
  </section>

  <section class="contact-process">
    <div class="section-heading">
      <span class="eyebrow">
        {extra.processEyebrow}
      </span>

      <h2>{extra.processTitle}</h2>
    </div>

    <div class="process-grid">
      {
        extra.steps.map((step) => (
          <article class="process-card">
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="contact-visual">
    <img
      src="/dining-room.webp"
      alt={extra.imageAlt}
      width="1800"
      height="1000"
      loading="lazy"
      decoding="async"
    />

    <div class="visual-overlay"></div>

    <div class="visual-content">
      <span>{extra.finalEyebrow}</span>
      <h2>{extra.finalTitle}</h2>
      <p>{extra.finalText}</p>

      <a
        class="primary-button"
        href={whatsappURL}
        target="_blank"
        rel="noopener noreferrer"
        data-whatsapp-context="contact-final-cta"
        data-cta-position="contact-final-cta"
        data-product-name="VIRELLAART"
        data-page-language={language}
      >
        {translations.contact.button}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    position: relative;
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 150px 30px 90px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(
        180deg,
        rgba(17, 11, 8, 0.28),
        rgba(12, 8, 6, 0.78)
      ),
      url("/tv-unit.webp") center / cover no-repeat;
  }

  .contact-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        transparent 18%,
        rgba(8, 5, 4, 0.5) 100%
      );
  }

  .contact-content {
    position: relative;
    z-index: 2;
    width: min(100%, 1000px);
  }

  .contact-content > span,
  .eyebrow,
  .visual-content > span {
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 5px;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .contact-content h1 {
    margin: 22px 0 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(52px, 8vw, 112px);
    font-weight: 400;
    line-height: 0.98;
  }

  .contact-content > p {
    max-width: 760px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .primary-button,
  .secondary-button {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 28px;
    font-size: 10px;
    letter-spacing: 2.6px;
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
    transition:
      transform 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .primary-button {
    border: 1px solid var(--gold);
    background: var(--gold);
    color: #110c08;
  }

  .primary-button:hover {
    transform: translateY(-3px);
    background: transparent;
    color: var(--gold);
  }

  .secondary-button {
    border: 1px solid rgba(255, 255, 255, 0.38);
    color: #ffffff;
  }

  .secondary-button:hover {
    transform: translateY(-3px);
    border-color: var(--gold);
    color: var(--gold);
  }

  .contact-overview,
  .project-brief,
  .contact-process {
    width: min(100% - 64px, var(--container));
    margin: 0 auto;
  }

  .contact-overview {
    padding: 125px 0;
  }

  .overview-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 0.88fr)
      minmax(0, 1.12fr);
    align-items: start;
    gap: 80px;
  }

  .overview-copy {
    position: sticky;
    top: 130px;
  }

  .overview-copy h2,
  .brief-copy h2,
  .section-heading h2,
  .visual-content h2 {
    margin: 20px 0 26px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 400;
    line-height: 1.06;
  }

  .overview-copy > p,
  .brief-copy > p,
  .section-heading > p {
    color: var(--gray);
    font-size: 16px;
    line-height: 1.9;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--gold);
    color: var(--gold);
    font-size: 10px;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  .text-link span {
    font-size: 18px;
    transition: transform 0.3s ease;
  }

  .text-link:hover span {
    transform: translateX(5px);
  }

  .contact-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(200, 169, 106, 0.24);
    border-left: 1px solid rgba(200, 169, 106, 0.24);
  }

  .detail-card {
    min-height: 170px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px;
    border-right: 1px solid rgba(200, 169, 106, 0.24);
    border-bottom: 1px solid rgba(200, 169, 106, 0.24);
    background:
      linear-gradient(
        145deg,
        rgba(200, 169, 106, 0.045),
        rgba(255, 255, 255, 0.01)
      );
  }

  .detail-card small {
    margin-bottom: 13px;
    color: var(--gold);
    font-size: 9px;
    letter-spacing: 2.6px;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .detail-card strong,
  .detail-card a {
    color: #ffffff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
  }

  .detail-card a:hover {
    color: var(--gold);
  }

  .project-brief {
    padding: 30px 0 130px;
  }

  .brief-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 0.92fr)
      minmax(0, 1.08fr);
    align-items: center;
    gap: 80px;
  }

  .brief-image {
    position: relative;
    min-height: 760px;
    overflow: hidden;
    border: 1px solid rgba(200, 169, 106, 0.22);
  }

  .brief-image::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 14px solid rgba(15, 10, 7, 0.16);
    pointer-events: none;
  }

  .brief-image img {
    width: 100%;
    height: 760px;
    object-fit: cover;
  }

  .brief-list {
    margin: 38px 0 42px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .brief-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    align-items: center;
    padding: 21px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .brief-item span {
    color: var(--gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
  }

  .brief-item p {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-process {
    padding: 105px 0 135px;
    border-top: 1px solid rgba(200, 169, 106, 0.18);
  }

  .section-heading {
    max-width: 850px;
    margin: 0 auto 65px;
    text-align: center;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(200, 169, 106, 0.24);
    border-left: 1px solid rgba(200, 169, 106, 0.24);
  }

  .process-card {
    min-height: 330px;
    padding: 42px;
    border-right: 1px solid rgba(200, 169, 106, 0.24);
    border-bottom: 1px solid rgba(200, 169, 106, 0.24);
    background:
      linear-gradient(
        180deg,
        rgba(200, 169, 106, 0.055),
        rgba(16, 11, 8, 0)
      );
  }

  .process-card > span {
    display: block;
    margin-bottom: 60px;
    color: var(--gold);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
  }

  .process-card h3 {
    margin: 0 0 18px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 27px;
    font-weight: 400;
    line-height: 1.25;
  }

  .process-card p {
    margin: 0;
    color: var(--gray);
    font-size: 14px;
    line-height: 1.85;
  }

  .contact-visual {
    position: relative;
    min-height: 680px;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 90px 30px;
  }

  .contact-visual > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .visual-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(10, 7, 5, 0.52),
        rgba(10, 7, 5, 0.82)
      );
  }

  .visual-content {
    position: relative;
    z-index: 2;
    width: min(100%, 880px);
    text-align: center;
  }

  .visual-content p {
    max-width: 720px;
    margin: 0 auto 38px;
    color: rgba(255, 255, 255, 0.84);
    font-size: 17px;
    line-height: 1.85;
  }

  @media (max-width: 1000px) {
    .overview-grid,
    .brief-grid {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .overview-copy {
      position: static;
    }

    .brief-image {
      min-height: 620px;
    }

    .brief-image img {
      height: 620px;
    }

    .process-card {
      padding: 34px;
    }
  }

  @media (max-width: 760px) {
    .contact-hero {
      min-height: 72vh;
      padding: 130px 22px 72px;
    }

    .contact-overview,
    .project-brief,
    .contact-process {
      width: min(100% - 32px, var(--container));
    }

    .contact-overview {
      padding: 90px 0;
    }

    .project-brief {
      padding: 10px 0 95px;
    }

    .contact-process {
      padding: 80px 0 95px;
    }

    .contact-details,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .detail-card {
      min-height: 135px;
      padding: 25px;
    }

    .brief-image,
    .brief-image img {
      min-height: 500px;
      height: 500px;
    }

    .process-card {
      min-height: auto;
      padding: 30px;
    }

    .process-card > span {
      margin-bottom: 35px;
    }

    .contact-visual {
      min-height: 600px;
      padding: 80px 22px;
    }
  }

  @media (max-width: 520px) {
    .contact-content h1 {
      font-size: clamp(45px, 15vw, 68px);
    }

    .hero-actions {
      flex-direction: column;
    }

    .primary-button,
    .secondary-button {
      width: 100%;
    }

    .overview-copy h2,
    .brief-copy h2,
    .section-heading h2,
    .visual-content h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .brief-image,
    .brief-image img {
      min-height: 430px;
      height: 430px;
    }

    .brief-item {
      grid-template-columns: 38px 1fr;
      gap: 12px;
    }

    .contact-visual {
      min-height: 560px;
    }
  }
</style>
